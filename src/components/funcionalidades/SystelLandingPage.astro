---
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { buildWhatsAppUrl } from '../../lib/whatsapp';
import {
  systelLanding,
  systelProblems,
  systelSteps,
  systelAudiences,
  systelChecklist,
  systelRelatedDocs,
  systelInternalLinks,
} from '../../data/systelLanding';
import SystelCtas from './SystelCtas.astro';
import SystelHeroVisual from './SystelHeroVisual.astro';
import SystelTracking from './SystelTracking.astro';

const whatsappUrl = buildWhatsAppUrl(systelLanding.whatsappMessage);
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Funcionalidades', item: pageUrl },
    { '@type': 'ListItem', position: 3, name: 'Balanza Systel', item: pageUrl },
  ],
};
---

<Layout title={systelLanding.title} description={systelLanding.metaDescription}>
  <Header />
  <main class="pb-24 md:pb-0">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)}></script>

    <section class="pt-32 pb-20 bg-dark-900 border-b border-dark-700">
      <div class="container mx-auto px-4">
        <div class="grid gap-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] items-start">
          <div class="max-w-3xl">
            <p class="inline-flex items-center gap-2 px-4 py-2 mb-6 rounded-full border border-primary/30 bg-primary/10 text-primary-light text-sm font-medium animate-on-scroll">
              {systelLanding.eyebrow}
            </p>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6 animate-on-scroll" style="animation-delay: 0.05s;">
              {systelLanding.heroTitle}
            </h1>
            <p class="text-xl text-gray-300 mb-4 animate-on-scroll" style="animation-delay: 0.1s;">
              {systelLanding.heroSubtitle}
            </p>
            <p class="text-base text-gray-400 mb-8 animate-on-scroll" style="animation-delay: 0.12s;">
              {systelLanding.valueProposition}
            </p>
            <div class="animate-on-scroll" style="animation-delay: 0.15s;">
              <SystelCtas
                primaryHref={whatsappUrl}
                primaryLabel="Consultar por WhatsApp"
                primaryTrack="whatsapp"
                primaryExternal
                placement="hero"
              />
            </div>
          </div>
          <div class="animate-on-scroll" style="animation-delay: 0.2s;">
            <SystelHeroVisual />
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-dark-800" aria-labelledby="systel-problema-title">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mb-12 animate-on-scroll">
          <h2 id="systel-problema-title" class="text-3xl md:text-4xl font-bold mb-4">El problema que resuelve</h2>
          <p class="text-lg text-gray-300">
            En dietéticas, almacenes y comercios de alimentos, parte de la mercadería se pesa en una Systel. Hoy ese ticket se tira: el cajero lo vuelve a cargar a mano.
          </p>
        </div>
        <div class="grid gap-6 lg:grid-cols-2">
          <article class="bg-dark-900/70 border border-white/5 rounded-2xl p-6 md:p-8 animate-on-scroll transition-all duration-300 hover:-translate-y-1">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-rose-300/80 mb-4">Antes</p>
            <ul class="space-y-3">
              {systelProblems.before.map((item) => (
                <li class="flex gap-3 text-gray-300">
                  <span class="mt-2 h-2 w-2 rounded-full bg-rose-400 shrink-0" aria-hidden="true"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
          <article class="bg-dark-900 border border-emerald-400/25 rounded-2xl p-6 md:p-8 animate-on-scroll transition-all duration-300 hover:-translate-y-1 hover:border-emerald-400/40 hover:ring-1 hover:ring-emerald-400/20">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-emerald-300 mb-4">Con ZinkERP</p>
            <ul class="space-y-3">
              {systelProblems.after.map((item) => (
                <li class="flex gap-3 text-gray-300">
                  <span class="mt-2 h-2 w-2 rounded-full bg-emerald-400 shrink-0" aria-hidden="true"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section id="como-funciona" class="py-20 scroll-mt-28" aria-labelledby="systel-flujo-title">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mb-12 animate-on-scroll">
          <h2 id="systel-flujo-title" class="text-3xl md:text-4xl font-bold mb-4">Cómo funciona</h2>
          <p class="text-lg text-gray-300">Tres pasos. El resto es el turno en caja.</p>
        </div>
        <ol class="grid gap-6 md:grid-cols-3">
          {systelSteps.map((step, index) => (
            <li
              class="group bg-dark-800 border border-dark-700 rounded-2xl p-6 animate-on-scroll transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:ring-1 hover:ring-primary/20"
              style={`animation-delay: ${index * 0.08}s`}
            >
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10 text-primary font-bold mb-5 transition-transform duration-300 group-hover:scale-110">
                {index + 1}
              </span>
              <h3 class="text-xl font-bold mb-3">{step.title}</h3>
              <p class="text-gray-300">{step.text}</p>
            </li>
          ))}
        </ol>
        <p class="mt-10 max-w-2xl text-sm text-gray-400 animate-on-scroll">
          {systelLanding.disclaimer}
        </p>
      </div>
    </section>

    <section class="py-16 bg-dark-800 border-y border-dark-700">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center animate-on-scroll">
          <h2 class="text-2xl md:text-3xl font-bold mb-4">¿En tu local se pesa y se vuelve a cargar en caja?</h2>
          <p class="text-lg text-gray-300 mb-8">
            Si la Systel ya imprime ticket, escribinos y vemos si te sirve.
          </p>
          <SystelCtas
            primaryHref={whatsappUrl}
            primaryLabel="Consultar por WhatsApp"
            primaryTrack="whatsapp"
            primaryExternal
            placement="mid"
            align="center"
          />
        </div>
      </div>
    </section>

    <section class="py-20" aria-labelledby="systel-para-quien-title">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mb-12 animate-on-scroll">
          <h2 id="systel-para-quien-title" class="text-3xl md:text-4xl font-bold mb-4">Para quién es</h2>
          <p class="text-lg text-gray-300">
            Comercios que ya pesan en Systel con ticket y quieren que esa pesada sirva en caja.
          </p>
        </div>
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {systelAudiences.map((audience, index) => (
            <article
              class="bg-dark-800 border border-dark-700 rounded-2xl p-6 animate-on-scroll transition-all duration-300 hover:-translate-y-1 hover:border-primary/35 hover:ring-1 hover:ring-primary/15"
              style={`animation-delay: ${index * 0.05}s`}
            >
              <h3 class="text-xl font-bold mb-2">{audience.title}</h3>
              <p class="text-gray-300">{audience.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="aprovechar" class="py-20 bg-dark-800 scroll-mt-28" aria-labelledby="systel-checklist-title">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mb-12 animate-on-scroll">
          <h2 id="systel-checklist-title" class="text-3xl md:text-4xl font-bold mb-4">{systelLanding.checklistTitle}</h2>
          <p class="text-lg text-gray-300">
            {systelLanding.checklistLead}
          </p>
        </div>
        <div class="grid gap-6 lg:grid-cols-[minmax(0,0.88fr)_minmax(0,1.12fr)] lg:items-stretch">
          {systelChecklist.map((group) => {
            const isGain = group.group === 'gain';
            return (
              <article
                class:list={[
                  'rounded-2xl animate-on-scroll h-full transition-all duration-300',
                  isGain
                    ? 'border border-emerald-400/30 bg-dark-900 p-7 md:p-8 hover:-translate-y-1 hover:border-emerald-400/50 hover:ring-1 hover:ring-emerald-400/20'
                    : 'border border-white/6 bg-dark-900/55 p-6 hover:border-white/12',
                ]}
              >
                <p
                  class:list={[
                    'text-[11px] font-semibold uppercase tracking-[0.16em] mb-3',
                    isGain ? 'text-emerald-300' : 'text-gray-500',
                  ]}
                >
                  {isGain ? 'Con ZinkERP' : 'Hoy'}
                </p>
                <h3 class:list={['mb-2', isGain ? 'text-2xl md:text-3xl font-bold text-white' : 'text-lg font-semibold text-gray-300']}>
                  {group.title}
                </h3>
                <p class:list={['mb-6', isGain ? 'text-base text-gray-300' : 'text-sm text-gray-500']}>
                  {group.text}
                </p>
                <ul class="space-y-3">
                  {group.items.map((item) => (
                    <li
                      class:list={[
                        'flex items-start gap-3 rounded-xl px-4 py-3 transition-colors duration-200',
                        isGain
                          ? 'border border-emerald-400/20 bg-dark-800 hover:border-emerald-400/40'
                          : 'border border-white/6 bg-dark-800/70 hover:border-white/12',
                      ]}
                    >
                      <span
                        class:list={[
                          'mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-md text-sm',
                          isGain
                            ? 'border border-emerald-400/50 text-emerald-300'
                            : 'border border-white/15 text-gray-500',
                        ]}
                        aria-hidden="true"
                      >
                        {isGain ? '✓' : '–'}
                      </span>
                      <span class:list={[isGain ? 'text-gray-100' : 'text-gray-400']}>{item}</span>
                    </li>
                  ))}
                </ul>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="py-20 bg-dark-800" aria-labelledby="systel-docs-title">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mb-8 animate-on-scroll">
          <h2 id="systel-docs-title" class="text-2xl md:text-3xl font-bold mb-3">Si querés el detalle técnico</h2>
          <p class="text-gray-300">
            La implementación y los problemas de lectura están en la documentación. No hace falta para decidir si te sirve.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 mb-8">
          {systelRelatedDocs.map((doc) => (
            <a
              href={doc.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center rounded-full border border-white/10 px-4 py-2 text-sm text-gray-200 transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/40 hover:text-white"
              data-track-docs={doc.name}
            >
              {doc.name}
            </a>
          ))}
        </div>
        <div class="flex flex-wrap gap-3">
          {systelInternalLinks.map((link) => (
            <a
              href={link.href}
              class="inline-flex min-h-11 items-center rounded-full border border-primary/20 px-4 py-2 text-sm text-primary-light transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/50"
            >
              {link.name}
            </a>
          ))}
        </div>
      </div>
    </section>

    <section
      id="contacto"
      class="py-20 bg-dark-800 border-t border-dark-700 scroll-mt-28"
      data-track-scroll="cta_final"
      aria-labelledby="systel-cta-title"
    >
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center animate-on-scroll">
          <h2 id="systel-cta-title" class="text-3xl md:text-5xl font-bold mb-6">¿Usás una balanza Systel con impresión de ticket?</h2>
          <p class="text-xl text-gray-300 mb-4">
            Contanos cómo pesás hoy y vemos si el ticket de tu Systel entra a ZinkERP.
          </p>
          <p class="text-sm text-gray-400 mb-8">{systelLanding.disclaimer}</p>
          <SystelCtas
            primaryHref={whatsappUrl}
            secondaryHref={systelLanding.demoHref}
            primaryLabel="Consultar por WhatsApp"
            secondaryLabel="Solicitar una demo"
            primaryTrack="whatsapp"
            secondaryTrack="demo"
            primaryExternal
            placement="final"
            align="center"
          />
        </div>
      </div>
    </section>
  </main>

  <div id="page-sticky-cta" class="fixed inset-x-4 bottom-4 z-[55] md:hidden">
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="block rounded-xl bg-blue-primary px-4 py-4 text-center text-sm font-semibold text-white shadow-2xl transition-colors hover:bg-blue-primary/90"
      data-track-cta="whatsapp"
      data-track-vertical={systelLanding.slug}
      data-track-placement="sticky"
    >
      Consultar por WhatsApp
    </a>
  </div>

  <Footer />
  <SystelTracking />
</Layout>
