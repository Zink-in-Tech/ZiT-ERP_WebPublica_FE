---
type CtaName = 'demo' | 'whatsapp' | 'contacto';

interface Props {
  primaryHref: string;
  secondaryHref?: string;
  placement: 'hero' | 'mid' | 'final' | 'sticky';
  primaryLabel?: string;
  secondaryLabel?: string;
  primaryTrack?: CtaName;
  secondaryTrack?: CtaName;
  primaryExternal?: boolean;
  secondaryExternal?: boolean;
  align?: 'start' | 'center';
}

const {
  primaryHref,
  secondaryHref,
  placement,
  primaryLabel = 'Consultar por WhatsApp',
  secondaryLabel = 'Solicitar una demo',
  primaryTrack = 'whatsapp',
  secondaryTrack = 'demo',
  primaryExternal = false,
  secondaryExternal = false,
  align = 'start',
} = Astro.props;
---

<div class:list={['flex flex-col sm:flex-row gap-4 flex-wrap', align === 'center' && 'justify-center']}>
  <a
    href={primaryHref}
    class="inline-flex min-h-12 justify-center items-center px-8 py-4 bg-blue-primary hover:bg-blue-primary/90 rounded-lg text-lg font-medium transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-primary"
    data-track-cta={primaryTrack}
    data-track-vertical="balanza-systel"
    data-track-placement={placement}
    target={primaryExternal ? '_blank' : undefined}
    rel={primaryExternal ? 'noopener noreferrer' : undefined}
  >
    {primaryLabel}
  </a>
  {secondaryHref && (
    <a
      href={secondaryHref}
      class="inline-flex min-h-12 justify-center items-center px-8 py-4 border border-gray-600 hover:border-gray-400 rounded-lg text-lg font-medium transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      data-track-cta={secondaryTrack}
      data-track-vertical="balanza-systel"
      data-track-placement={placement}
      target={secondaryExternal ? '_blank' : undefined}
      rel={secondaryExternal ? 'noopener noreferrer' : undefined}
    >
      {secondaryLabel}
    </a>
  )}
</div>
