<div class="rounded-2xl border border-white/8 bg-dark-800 p-5 md:p-6">
  <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary-light mb-5">Hoy vs con ZinkERP</p>
  <div class="grid gap-4 sm:grid-cols-2">
    <figure class="rounded-xl border border-rose-400/20 bg-dark-900/80 p-5">
      <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-rose-300 mb-3">Hoy</p>
