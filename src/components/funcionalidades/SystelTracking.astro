<script>
  type CtaName = 'demo' | 'whatsapp' | 'contacto';

  declare global {
    interface Window {
      dataLayer?: unknown[];
      gtag?: (...args: unknown[]) => void;
    }
  }

  const track = (eventName: string, params: Record<string, string>) => {
    if (typeof window.gtag === 'function') {
      window.gtag('event', eventName, params);
      return;
    }
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: eventName, ...params });
  };

  const trackCta = (cta: CtaName, placement: string) => {
    const eventName =
      cta === 'demo' ? 'cta_demo' : cta === 'whatsapp' ? 'cta_whatsapp' : 'cta_contacto';
    track(eventName, {
      vertical: 'balanza-systel',
      placement,
      cta_type: cta,
    });
  };

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const ctaLink = target.closest<HTMLAnchorElement>('[data-track-cta]');
    if (ctaLink) {
      const cta = ctaLink.dataset.trackCta as CtaName | undefined;
      const placement = ctaLink.dataset.trackPlacement ?? 'unknown';
      if (cta) trackCta(cta, placement);
    }

    const docsLink = target.closest<HTMLAnchorElement>('[data-track-docs]');
    if (docsLink) {
      track('docs_click', {
        vertical: 'balanza-systel',
        docs_label: docsLink.dataset.trackDocs ?? docsLink.textContent?.trim() ?? 'docs',
        docs_href: docsLink.href,
      });
    }
  });

  const seenSections = new Set<string>();
  const scrollTargets = document.querySelectorAll<HTMLElement>('[data-track-scroll]');
  if (scrollTargets.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const section = entry.target.getAttribute('data-track-scroll');
          if (!section || seenSections.has(section)) return;
          seenSections.add(section);
          track('scroll_section', {
            vertical: 'balanza-systel',
            section,
          });
        });
      },
      { threshold: 0.4 }
    );
    scrollTargets.forEach((target) => observer.observe(target));
  }
</script>
