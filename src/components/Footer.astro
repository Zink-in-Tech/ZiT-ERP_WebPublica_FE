---
import { modules } from '../data/modules';

const keyLinks = [
  {
    name: "Agendar demo",
    url: "https://cal.com/zinkintech",
    highlight: true
  },
  {
    name: "Acceder al ERP",
    url: "https://ziterp.zinkintech.com"
  },
  {
    name: "Integraciones",
    url: "/integraciones"
  },
  {
    name: "Casos de uso",
    url: "/casos-de-uso"
  },
  {
    name: "Precios",
    url: "/precios"
  },
  {
    name: "Blog",
    url: "/blog"
  }
];
---

<footer class="bg-dark-900 py-12 border-t border-dark-700">
  <div class="container mx-auto px-4">
    <div class="flex flex-col lg:flex-row gap-12">
      {/* Key Links - 30% */}
      <div class="lg:w-[30%]">
        <a href="/" class="flex items-center gap-2 mb-6">
          <img src="/zinkerp-logo.png" alt="ZinkERP Logo" class="h-12 w-auto" />
        </a>
        <p class="text-gray-400 mb-8 text-lg">Sistema integral para la gestión empresarial multi-sucursal.</p>
        
        <div class="space-y-4">
          {keyLinks.map(link => (
            <a 
              href={link.url}
              class={`block transition-colors ${
                link.highlight 
                  ? 'text-blue-primary hover:text-blue-primary/90 font-medium'
                  : 'text-gray-400 hover:text-white'
              }`}
            >
              {link.name}
            </a>
          ))}
        </div>
      </div>

      {/* Modules Grid - 70% */}
      <div class="lg:w-[70%]">
        <h3 class="text-lg font-semibold mb-6">Módulos de tu ERP para PyMES</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {modules.map(module => (
            <a 
              href={`/modulos/${module.id}`}
              class="bg-dark-800/50 rounded-lg p-4 hover:bg-dark-800 transition-all duration-300 group border border-dark-700/50 hover:border-primary/20"
            >
              <div class="flex items-center gap-2 mb-2">
                <span class="text-lg group-hover:scale-110 transition-transform duration-300">{module.icon}</span>
                <span class="text-gray-300 group-hover:text-white transition-colors">{module.title}</span>
              </div>
              <p class="text-xs text-gray-500 line-clamp-2 group-hover:text-gray-400 transition-colors">{module.subtitle}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
    
    <div class="border-t border-dark-700 mt-12 pt-8 text-center text-gray-500 text-sm">
      <p>© {new Date().getFullYear()} Zink ERP. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
