---
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import ProductVisualRenderer from './ProductVisualRenderer.astro';
import type { ProductPage } from '../../data/productPages';

interface Props {
  page: ProductPage;
}

const { page } = Astro.props;

const themes = {
  sales: {
    badge: 'border-cyan-400/30 bg-cyan-400/10 text-cyan-200',
    glowA: 'bg-cyan-500/25',
    glowB: 'bg-blue-500/20',
    panel: 'border-cyan-400/15',
    surface: 'from-cyan-400/12 via-dark-800 to-dark-900',
    accentText: 'text-cyan-200',
    accentBorder: 'border-cyan-400/20',
  },
  procurement: {
    badge: 'border-amber-400/30 bg-amber-400/10 text-amber-100',
    glowA: 'bg-amber-500/20',
    glowB: 'bg-orange-500/15',
    panel: 'border-amber-400/15',
    surface: 'from-amber-400/12 via-dark-800 to-dark-900',
    accentText: 'text-amber-100',
    accentBorder: 'border-amber-400/20',
  },
  inventory: {
    badge: 'border-emerald-400/30 bg-emerald-400/10 text-emerald-100',
    glowA: 'bg-emerald-500/20',
    glowB: 'bg-teal-500/15',
    panel: 'border-emerald-400/15',
    surface: 'from-emerald-400/12 via-dark-800 to-dark-900',
    accentText: 'text-emerald-100',
    accentBorder: 'border-emerald-400/20',
  },
  fiscal: {
    badge: 'border-fuchsia-400/30 bg-fuchsia-400/10 text-fuchsia-100',
    glowA: 'bg-fuchsia-500/20',
    glowB: 'bg-violet-500/15',
    panel: 'border-fuchsia-400/15',
    surface: 'from-fuchsia-400/12 via-dark-800 to-dark-900',
    accentText: 'text-fuchsia-100',
    accentBorder: 'border-fuchsia-400/20',
  },
  finance: {
    badge: 'border-lime-400/30 bg-lime-400/10 text-lime-100',
    glowA: 'bg-lime-500/20',
    glowB: 'bg-green-500/15',
    panel: 'border-lime-400/15',
    surface: 'from-lime-400/12 via-dark-800 to-dark-900',
    accentText: 'text-lime-100',
    accentBorder: 'border-lime-400/20',
  },
  analytics: {
    badge: 'border-sky-400/30 bg-sky-400/10 text-sky-100',
    glowA: 'bg-sky-500/20',
    glowB: 'bg-indigo-500/15',
    panel: 'border-sky-400/15',
    surface: 'from-sky-400/12 via-dark-800 to-dark-900',
    accentText: 'text-sky-100',
    accentBorder: 'border-sky-400/20',
  },
  network: {
    badge: 'border-rose-400/30 bg-rose-400/10 text-rose-100',
    glowA: 'bg-rose-500/20',
    glowB: 'bg-pink-500/15',
    panel: 'border-rose-400/15',
    surface: 'from-rose-400/12 via-dark-800 to-dark-900',
    accentText: 'text-rose-100',
    accentBorder: 'border-rose-400/20',
  },
  access: {
    badge: 'border-violet-400/30 bg-violet-400/10 text-violet-100',
    glowA: 'bg-violet-500/20',
    glowB: 'bg-purple-500/15',
    panel: 'border-violet-400/15',
    surface: 'from-violet-400/12 via-dark-800 to-dark-900',
    accentText: 'text-violet-100',
    accentBorder: 'border-violet-400/20',
  },
} as const;

const theme = themes[page.theme ?? 'sales'];
const heroImageSrc = page.heroImageSrc;
const hasHeroImage = Boolean(heroImageSrc);
const socialImageSrc = page.ogImageSrc ?? page.heroImageSrc;
const socialImageAlt = page.ogImageAlt ?? `Vista del módulo ${page.eyebrow ?? page.heroTitle} en ZinkERP`;
const immersiveVisualKinds = new Set(['image', 'imageGrid']);

const getSectionGridClass = (section: ProductPage['sections'][number]) => {
  if (!immersiveVisualKinds.has(section.visual.kind)) return 'lg:grid-cols-2';
  const base = 'grid-cols-1 min-w-0 gap-8 lg:gap-10';
  // Con reverse, el visual va a la columna 1 vía order; invertimos fr para que ocupe el mismo ancho (0.6fr).
  if (section.reverse) {
    return `${base} lg:grid-cols-[minmax(0,0.6fr)_minmax(0,0.4fr)] xl:grid-cols-[minmax(0,0.62fr)_minmax(0,0.38fr)] xl:gap-16`;
  }
  return `${base} lg:grid-cols-[minmax(0,0.4fr)_minmax(0,0.6fr)] xl:grid-cols-[minmax(0,0.38fr)_minmax(0,0.62fr)] xl:gap-16`;
};

const getSectionOrderClass = (section: ProductPage['sections'][number]) => {
  if (!section.reverse) return '';
  return '[&>*:first-child]:order-2 [&>*:last-child]:order-1';
};

const getSectionTextClass = (section: ProductPage['sections'][number]) => {
  if (!immersiveVisualKinds.has(section.visual.kind)) return 'max-w-2xl';
  return 'min-w-0 max-w-none lg:max-w-lg xl:max-w-[33rem]';
};

const getSectionVisualClass = (section: ProductPage['sections'][number], index: number) => {
  if (immersiveVisualKinds.has(section.visual.kind)) {
    return '';
  }
  return index % 2 === 0 ? theme.panel : 'border-white/10';
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: new URL('/', Astro.url).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Producto',
      item: new URL('/producto', Astro.url).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: page.heroTitle,
      item: Astro.url.toString(),
    },
  ],
};
---

<Layout
  title={page.title}
  description={page.metaDescription}
  image={socialImageSrc}
  imageAlt={socialImageAlt}
  noindex={page.noindex}
>
  <Header />
  <main class="pb-24 md:pb-0">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)}></script>

    <section class:list={['relative overflow-hidden border-b border-dark-700 bg-dark-900 pt-28 pb-14 md:pt-32 md:pb-20', theme.accentBorder]}>
      <div class="absolute inset-0 opacity-25">
        <div class:list={['absolute left-[-8rem] top-16 h-72 w-72 rounded-full blur-3xl', theme.glowA]}></div>
        <div class:list={['absolute bottom-0 right-[-5rem] h-80 w-80 rounded-full blur-3xl', theme.glowB]}></div>
      </div>

      <div class="container relative z-10 mx-auto min-w-0 px-4">
        <div class="grid min-w-0 items-center gap-10 lg:grid-cols-[minmax(0,0.97fr)_minmax(0,1.03fr)] xl:grid-cols-[minmax(0,0.94fr)_minmax(0,1.06fr)] xl:gap-14">
          <div class="min-w-0 max-w-2xl xl:max-w-[44rem]">
            <p class:list={['mb-5 inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium', theme.badge]}>
              {page.eyebrow ?? 'Producto'}
            </p>
            <h1 class="text-3xl font-bold leading-[1.08] tracking-[-0.03em] sm:text-4xl md:max-w-[12ch] md:text-[4.5rem] md:leading-[0.98] xl:text-[4.85rem]">{page.heroTitle}</h1>
            <p class="mt-6 max-w-2xl text-lg text-gray-300 md:text-xl">{page.heroSubtitle}</p>
            <div class="mt-8 flex flex-col gap-4 sm:flex-row">
              <a
                href={page.heroCtaHref}
                target={page.heroCtaHref.startsWith('https://') ? '_blank' : undefined}
                rel={page.heroCtaHref.startsWith('https://') ? 'noopener noreferrer' : undefined}
                class="inline-flex justify-center rounded-xl bg-blue-primary px-8 py-4 text-base font-medium text-white transition-colors hover:bg-blue-primary/90"
              >
                {page.heroCtaLabel}
              </a>
              <a
                href="/precios"
                class="inline-flex justify-center rounded-xl border border-white/12 bg-white/[0.02] px-8 py-4 text-base font-medium text-white transition-colors hover:border-white/20"
              >
                Ver precios
              </a>
            </div>
          </div>

          <div
            class:list={[
              'overflow-hidden rounded-[30px] border shadow-2xl',
              hasHeroImage ? 'bg-white/[0.03] p-2 lg:p-3' : 'bg-dark-800/95 p-6',
              theme.panel,
              hasHeroImage ? 'lg:-mr-8 xl:-mr-12' : '',
            ]}
          >
            <p class:list={['mb-5 text-xs font-semibold uppercase tracking-[0.18em]', theme.accentText, hasHeroImage ? 'px-3 pt-3' : '']}>
              {page.heroVisualLabel}
            </p>
            {hasHeroImage ? (
              <img
                src={heroImageSrc}
                alt={`Vista del módulo ${page.eyebrow ?? page.heroTitle} en ZinkERP`}
                class="w-full rounded-[24px] border border-white/10 object-cover shadow-[0_24px_70px_rgba(8,12,24,0.45)]"
                loading="eager"
                width="1792"
                height="1024"
              />
            ) : (
              <ProductVisualRenderer visual={page.heroVisual} />
            )}
          </div>
        </div>
      </div>
    </section>

    {page.sections.map((section, index) => (
      <section class:list={['py-14 md:py-20', index % 2 === 1 ? 'bg-dark-800/65' : 'bg-dark-900']}>
        <div class="container mx-auto min-w-0 px-4">
          <div
            class:list={[
              'grid items-center',
              immersiveVisualKinds.has(section.visual.kind) ? '' : 'gap-10',
              getSectionGridClass(section),
              getSectionOrderClass(section),
            ]}
          >
            <div class:list={[getSectionTextClass(section)]}>
              <h2 class="text-2xl font-bold leading-tight sm:text-3xl md:text-4xl">{section.title}</h2>
              <p class="mt-4 text-base text-gray-300 sm:mt-5 sm:text-lg">{section.description}</p>
              {section.links && (
                <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
                  {section.links.map((link) => (
                    <a
                      href={link.href}
                      class="inline-flex items-center gap-2 text-sm font-medium text-primary transition-colors hover:text-primary-light"
                    >
                      {link.label}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
                        <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
                      </svg>
                    </a>
                  ))}
                </div>
              )}
            </div>

            <div
              class:list={[
                'w-full min-w-0',
                immersiveVisualKinds.has(section.visual.kind)
                  ? 'bg-transparent p-0 shadow-none'
                  : 'rounded-[28px] border bg-dark-800/95 p-6 shadow-xl',
                getSectionVisualClass(section, index),
              ]}
            >
              <ProductVisualRenderer visual={section.visual} />
            </div>
          </div>
        </div>
      </section>
    ))}

    <section class="bg-dark-900 py-14 md:py-20">
      <div class="container mx-auto min-w-0 px-4">
        <div class:list={['rounded-[32px] border p-6 text-center shadow-2xl bg-gradient-to-br sm:p-8 md:p-10', theme.accentBorder, theme.surface]}>
          <h2 class="mx-auto max-w-3xl text-2xl font-bold leading-tight sm:text-3xl md:text-4xl">{page.finalBannerText}</h2>
          <a
            href={page.finalBannerCtaHref}
            target={page.finalBannerCtaHref.startsWith('https://') ? '_blank' : undefined}
            rel={page.finalBannerCtaHref.startsWith('https://') ? 'noopener noreferrer' : undefined}
            class="mt-8 inline-flex justify-center rounded-xl bg-blue-primary px-8 py-4 text-base font-medium text-white transition-colors hover:bg-blue-primary/90"
          >
            {page.finalBannerCtaLabel}
          </a>
        </div>
      </div>
    </section>

    {page.faqs && page.faqs.length > 0 && (
      <section class="bg-dark-900 py-14 md:py-20">
        <div class="container mx-auto min-w-0 px-4">
          <div class="mx-auto max-w-4xl">
            <div class="mb-12 text-center">
              <h2 class="text-3xl font-bold md:text-4xl">{page.faqTitle ?? 'Preguntas frecuentes'}</h2>
            </div>

            <div class="space-y-5">
              {page.faqs.map((faq, index) => (
                <div
                  class="group overflow-hidden rounded-[1.25rem] border border-white/8 bg-dark-800/95 transition-all duration-200 hover:-translate-y-1 hover:border-primary/20 hover:bg-white/[0.015]"
                  style={`animation-delay: ${index * 0.08}s`}
                  data-product-faq
                >
                  <button class="flex w-full items-center justify-between gap-4 px-7 py-5 text-left focus:outline-none" data-product-faq-button>
                    <span class="text-base font-medium md:text-lg">{faq.question}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transform transition-all duration-300 group-hover:text-primary" data-product-faq-icon fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                  <div class="hidden px-7 pb-6 text-gray-300" data-product-faq-content>
                    <p class="leading-7">{faq.answer}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <section class="bg-dark-800 py-10 md:py-12">
      <div class="container mx-auto min-w-0 px-4">
        <div class="flex flex-col items-start justify-between gap-6 rounded-[28px] border border-white/8 bg-dark-900/70 p-6 sm:p-8 lg:flex-row lg:items-center">
          <div>
            <p class:list={['text-sm font-semibold uppercase tracking-[0.18em]', theme.accentText]}>Multi-sucursal</p>
            <h2 class="mt-3 text-2xl font-bold">¿Tenés más de una sucursal?</h2>
            <p class="mt-2 max-w-2xl text-gray-300">
              Conocé cómo ZinkERP centraliza tus operaciones sin perder control local.
            </p>
          </div>
          <a
            href="/agendar-demo"
            class="inline-flex items-center gap-2 rounded-xl border border-white/12 px-6 py-3 text-sm font-medium text-white transition-colors hover:border-white/20"
          >
            Agendá una demo
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <div id="page-sticky-cta" class="fixed inset-x-4 bottom-4 z-[55] md:hidden">
    <a
      href={page.heroCtaHref}
      target={page.heroCtaHref.startsWith('https://') ? '_blank' : undefined}
      rel={page.heroCtaHref.startsWith('https://') ? 'noopener noreferrer' : undefined}
      class="block rounded-xl bg-blue-primary px-4 py-4 text-center text-sm font-semibold text-white shadow-2xl transition-colors hover:bg-blue-primary/90"
    >
      {page.heroCtaLabel}
    </a>
  </div>

  <Footer />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const faqItems = document.querySelectorAll('[data-product-faq]');

    faqItems.forEach((item) => {
      const button = item.querySelector('[data-product-faq-button]');
      const content = item.querySelector('[data-product-faq-content]');
      const icon = item.querySelector('[data-product-faq-icon]');

      if (button && content && icon) {
        button.addEventListener('click', () => {
          faqItems.forEach((otherItem) => {
            if (otherItem !== item) {
              const otherContent = otherItem.querySelector('[data-product-faq-content]');
              const otherIcon = otherItem.querySelector('[data-product-faq-icon]');
              if (otherContent && otherIcon) {
                otherContent.classList.add('hidden');
                otherIcon.classList.remove('rotate-180');
              }
            }
          });

          content.classList.toggle('hidden');
          icon.classList.toggle('rotate-180');
        });
      }
    });
  });
</script>
