---
import { PortableText } from '@portabletext/react';
import { portableTextComponents } from './PortableTextComponents';
import { withHeadingAnchors } from '../lib/headingAnchors';

interface Props {
  content: any[];
  /** Article URL, so absolute links to its own sections become in-page anchors. */
  pageUrl?: string;
}

const { content, pageUrl } = Astro.props;
const blocks = withHeadingAnchors(Array.isArray(content) ? content : [], { pageUrl });
---

{blocks.length > 0 ? (
  <div class="blog-content">
    <PortableText value={blocks} components={portableTextComponents} onMissingComponent={false} />
  </div>
) : (
  <p class="blog-content__empty">No hay contenido disponible.</p>
)}
