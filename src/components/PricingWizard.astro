---
const WHATSAPP_CTA_NUMBER = '5491135598389';
const buildWhatsAppUrl = (message: string) => `https://wa.me/${WHATSAPP_CTA_NUMBER}?text=${encodeURIComponent(message)}`;
const demoUrl = '/agendar-demo';

const questions = [
  {
    id: 'locations',
    text: '¿Cuántas sucursales tenés actualmente?',
    options: [
      { value: 'single', label: '1 sucursal', icon: '🟢' },
      { value: 'small', label: 'Entre 2 y 4 sucursales', icon: '🔵' },
      { value: 'large', label: '5 o más sucursales / franquicias', icon: '🟠' }
    ]
  },
  {
    id: 'salesVolume',
    text: '¿Qué volumen mensual de ventas tiene hoy tu operación?',
    options: [
      { value: 'starter', label: 'Hasta USD 5.000/mes', icon: '🟢' },
      { value: 'pro', label: 'Más de USD 5.000 y hasta USD 15.000/mes', icon: '🔵' },
      { value: 'full', label: 'Más de USD 15.000 y hasta USD 40.000/mes', icon: '🟣' },
      { value: 'sales', label: 'Más de USD 40.000/mes', icon: '🟠' }
    ]
  },
  {
    id: 'complexity',
    text: '¿Qué tan compleja es tu operación diaria?',
    options: [
      { value: 'basic', label: 'Básica (ventas + stock)', icon: '🟢' },
      { value: 'medium', label: 'Intermedia (ventas, stock, compras, usuarios)', icon: '🔵' },
      { value: 'complex', label: 'Compleja (sucursales conectadas, logística o requerimientos especiales)', icon: '🟣' }
    ]
  }
];
---

<div class="bg-dark-700 rounded-xl p-8 border border-primary/20">
  <div class="text-center mb-12">
    <h2 class="text-3xl font-bold mb-4">¿Qué plan ZinkERP es ideal para tu negocio?</h2>
    <p class="text-gray-300">Respondé 3 preguntas simples y te lo mostramos.</p>
  </div>

  <div id="wizard" class="max-w-2xl mx-auto" data-whatsapp-base={buildWhatsAppUrl('')} data-demo-url={demoUrl}>
    <div id="questions" class="space-y-8">
      {questions.map((question, index) => (
        <div class="question-step hidden" data-step={index}>
          <h3 class="text-xl font-medium mb-6">{question.text}</h3>
          <div class="space-y-4">
            {question.options.map((option) => (
              <button
                class="w-full text-left p-4 rounded-lg bg-dark-600 hover:bg-dark-500 transition-colors border border-dark-500 hover:border-primary/50 group"
                data-value={option.value}
              >
                <div class="flex items-center gap-3">
                  <span class="text-2xl group-hover:scale-110 transition-transform">{option.icon}</span>
                  <span>{option.label}</span>
                </div>
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div id="result" class="hidden">
      <div class="text-center mb-8">
        <h3 id="result-title" class="text-2xl font-bold mb-4">Plan recomendado</h3>
        <p id="result-subtitle" class="text-gray-300">Basado en tus respuestas, este es el plan ideal para tu negocio:</p>
      </div>

      <div id="plan-card" class="bg-dark-600 rounded-xl p-6 border border-primary mb-8">
        <div class="flex items-center gap-3 mb-4">
          <span id="plan-icon" class="text-2xl"></span>
          <h4 id="plan-name" class="text-xl font-bold"></h4>
        </div>
        <p id="plan-description" class="text-gray-300 mb-6"></p>
        <div id="plan-price-row" class="flex flex-wrap items-end gap-2 mb-4">
          <span class="text-3xl font-bold">USD <span id="plan-price"></span></span>
          <span class="text-gray-400">/mes</span>
          <span id="plan-promo" class="text-blue-primary text-sm font-medium"></span>
        </div>
        <ul id="plan-notes" class="hidden space-y-2 mb-6 text-sm text-gray-300 list-disc pl-5"></ul>
        <div class="flex flex-wrap gap-4">
          <a
            id="plan-cta"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 text-center py-3 px-6 bg-blue-primary hover:bg-blue-primary/90 rounded-lg transition-colors"
          >
            Elegir este plan
          </a>
          <a
            id="plan-sales"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden flex-1 text-center py-3 px-6 border border-gray-600 hover:border-gray-400 rounded-lg transition-colors"
          >
            Hablar con ventas
          </a>
          <button
            id="restart-wizard"
            class="py-3 px-6 border border-gray-600 hover:border-gray-400 rounded-lg transition-colors"
          >
            Volver a empezar
          </button>
        </div>
      </div>

      <div class="text-center">
        <p class="text-gray-300 mb-4">¿No estás seguro?</p>
        <a
          href={buildWhatsAppUrl('Quiero ayuda para elegir el mejor plan de ZinkERP para mi negocio')}
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary hover:text-primary-light transition-colors"
        >
          Hablá con nuestro equipo y te ayudamos a elegir el mejor plan para tu negocio
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  type PlanKey = 'starter' | 'pro' | 'full';
  type VolumeKey = PlanKey | 'sales';

  type Plan = {
    name: string;
    price: number;
    icon: string;
    description: string;
    promo: string;
    message: string;
  };

  document.addEventListener('DOMContentLoaded', () => {
    const wizard = document.getElementById('wizard');
    const questionsEl = document.getElementById('questions');
    const resultEl = document.getElementById('result');
    const restartButton = document.getElementById('restart-wizard');
    const planCta = document.getElementById('plan-cta') as HTMLAnchorElement | null;
    const planSales = document.getElementById('plan-sales') as HTMLAnchorElement | null;
    const planPriceRow = document.getElementById('plan-price-row');
    const planNotes = document.getElementById('plan-notes');

    if (!wizard || !questionsEl || !resultEl || !restartButton) return;

    let currentStep = 0;
    const answers: Partial<Record<number, string>> = {};
    const steps = Array.from(document.querySelectorAll<HTMLElement>('.question-step'));

    const plans: Record<PlanKey, Plan> = {
      starter: {
        name: 'Emprendedor',
        price: 15,
        icon: '🟢',
        description: 'Para operaciones de hasta USD 5.000/mes en ventas que quieren empezar con orden, usuarios ilimitados y toda la funcionalidad base incluida.',
        promo: '50% OFF por 3 meses. Luego USD 29/mes. Solo en modalidad mensual.',
        message: 'Quiero comenzar hoy mismo con Plan Emprendedor.'
      },
      pro: {
        name: 'Pyme',
        price: 70,
        icon: '🔵',
        description: 'Para operaciones de hasta USD 15.000/mes en ventas que ya necesitan más volumen, más previsibilidad y más acompañamiento.',
        promo: 'En plan anual, 2 meses gratis.',
        message: 'Quiero comenzar hoy mismo con Plan Pyme.'
      },
      full: {
        name: 'Escala',
        price: 99,
        icon: '🟣',
        description: 'Para operaciones de hasta USD 40.000/mes en ventas, con más exigencia de coordinación diaria.',
        promo: 'En plan anual, 2 meses gratis.',
        message: 'Quiero comenzar hoy mismo con Plan Escala.'
      }
    };

    const locationMessages: Record<string, string> = {
      small: ' Tengo entre 2 y 4 sucursales.',
      large: ' Tengo 5 o más sucursales.'
    };

    const buildWhatsAppUrl = (text: string) => {
      const base = wizard.dataset.whatsappBase ?? 'https://wa.me/?text=';
      return `${base}${encodeURIComponent(text)}`;
    };

    const setText = (id: string, text: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    };

    const setNotes = (notes: string[]) => {
      if (!planNotes) return;
      planNotes.replaceChildren(
        ...notes.map((note) => {
          const item = document.createElement('li');
          item.textContent = note;
          return item;
        })
      );
      planNotes.classList.toggle('hidden', notes.length === 0);
    };

    steps[0]?.classList.remove('hidden');

    questionsEl.addEventListener('click', (e) => {
      const target = e.target as Element | null;
      const button = target?.closest('button');
      if (!button) return;

      const value = button.dataset.value;
      if (!value) return;

      answers[currentStep] = value;

      if (currentStep < steps.length - 1) {
        steps[currentStep]?.classList.add('hidden');
        currentStep++;
        steps[currentStep]?.classList.remove('hidden');
      } else {
        showResult();
      }
    });

    restartButton.addEventListener('click', () => {
      currentStep = 0;
      resultEl.classList.add('hidden');
      questionsEl.classList.remove('hidden');
      Object.keys(answers).forEach((key) => delete answers[Number(key)]);
      steps.forEach((step, index) => {
        step.classList.toggle('hidden', index !== 0);
      });
    });

    function showSalesResult(locationMessage: string) {
      setText('result-title', 'Hablemos de tu operación');
      setText('result-subtitle', 'Tu volumen supera los planes estándar. Armamos una propuesta a medida:');
      setText('plan-icon', '🟠');
      setText('plan-name', 'Propuesta a medida');
      setText(
        'plan-description',
        'Con más de USD 40.000/mes en ventas, conviene revisar tu operación con nuestro equipo comercial. Agendá una demo o hablá con ventas y te armamos una propuesta acorde a tu escala.'
      );
      planPriceRow?.classList.add('hidden');
      setNotes([]);

      if (planCta) {
        planCta.textContent = 'Agendar una demo';
        planCta.href = wizard!.dataset.demoUrl ?? '/agendar-demo';
      }
      if (planSales) {
        planSales.href = buildWhatsAppUrl(
          `Hola, mi operación vende más de USD 40.000/mes y quiero hablar con ventas sobre ZinkERP.${locationMessage}`
        );
        planSales.classList.remove('hidden');
      }
    }

    function showPlanResult(planKey: PlanKey, locationMessage: string) {
      const plan = plans[planKey];
      const notes: string[] = [];

      if (answers[0] && answers[0] !== 'single') {
        notes.push('La casa central paga el precio pleno de su plan y cada sucursal adicional tiene 30% de descuento sobre el plan que le corresponda.');
      }
      if (answers[2] === 'complex') {
        notes.push('Por la complejidad de tu operación, te recomendamos agendar una demo para revisar el circuito antes de empezar.');
      }

      setText('result-title', 'Plan recomendado');
      setText('result-subtitle', 'Basado en tus respuestas, este es el plan ideal para tu negocio:');
      setText('plan-icon', plan.icon);
      setText('plan-name', plan.name);
      setText('plan-description', plan.description);
      setText('plan-price', String(plan.price));
      setText('plan-promo', plan.promo);
      planPriceRow?.classList.remove('hidden');
      setNotes(notes);

      if (planCta) {
        planCta.textContent = 'Elegir este plan';
        planCta.href = buildWhatsAppUrl(`${plan.message}${locationMessage}`);
      }
      planSales?.classList.add('hidden');
    }

    function showResult() {
      const volume = (answers[1] ?? 'starter') as VolumeKey;
      const locationMessage = locationMessages[answers[0] ?? ''] ?? '';

      if (volume === 'sales') {
        showSalesResult(locationMessage);
      } else {
        showPlanResult(volume, locationMessage);
      }

      questionsEl!.classList.add('hidden');
      resultEl!.classList.remove('hidden');
    }
  });
</script>
