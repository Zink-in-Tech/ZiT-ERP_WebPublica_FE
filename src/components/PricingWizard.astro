---
const questions = [
  {
    id: 'locations',
    text: '¿Cuántas sucursales tenés actualmente?',
    options: [
      { value: 'single', label: '1 sucursal', icon: '🟢' },
      { value: 'small', label: 'Entre 2 y 4 sucursales', icon: '🔵' },
      { value: 'large', label: '5 o más sucursales / franquicias', icon: '🟠' }
    ]
  },
  {
    id: 'fiscalVolume',
    text: '¿Cuántos comprobantes fiscales emitís por mes?',
    options: [
      { value: 'starter', label: 'Hasta 500', icon: '🟢' },
      { value: 'pro', label: 'Hasta 1.500', icon: '🔵' },
      { value: 'full', label: 'Hasta 4.500', icon: '🟣' },
      { value: 'enterprise', label: 'Más de 4.500', icon: '🟠' }
    ]
  },
  {
    id: 'complexity',
    text: '¿Qué tan compleja es tu operación diaria?',
    options: [
      { value: 'basic', label: 'Básica (ventas + stock)', icon: '🟢' },
      { value: 'medium', label: 'Intermedia (ventas, stock, compras, usuarios)', icon: '🔵' },
      { value: 'complex', label: 'Compleja (sucursales conectadas, producción, logística, beneficios)', icon: '🟣' }
    ]
  }
];

const plans = {
  starter: {
    name: 'Plan Emprendedor',
    price: 15,
    description: 'Tu negocio está dando sus primeros pasos, y ZinkERP puede ayudarte a ordenarlo desde el primer día sin gastar de más.',
    promo: '50% OFF por 3 meses. Luego USD 29/mes'
  },
  pro: {
    name: 'Plan Pyme',
    price: 70,
    description: 'Tu empresa está en pleno crecimiento. Este plan acompaña una operación con más movimiento sin cobrar por usuario.'
  },
  full: {
    name: 'Plan Escala',
    price: 99,
    description: 'Este plan está diseñado para negocios con varias sedes o una operación fiscal más intensa.'
  },
  enterprise: {
    name: 'Plan Enterprise Fiscal',
    price: 149,
    description: 'Para operaciones que superan los 4.500 comprobantes fiscales mensuales y necesitan una arquitectura comercial superior.'
  }
};
---

<div class="bg-dark-700 rounded-xl p-8 border border-primary/20">
  <div class="text-center mb-12">
    <h2 class="text-3xl font-bold mb-4">¿Qué plan ZinkERP es ideal para tu negocio?</h2>
    <p class="text-gray-300">Respondé 3 preguntas simples y te lo mostramos.</p>
  </div>

  <div id="wizard" class="max-w-2xl mx-auto">
    {/* Questions */}
    <div id="questions" class="space-y-8">
      {questions.map((question, index) => (
        <div class="question-step hidden" data-step={index}>
          <h3 class="text-xl font-medium mb-6">{question.text}</h3>
          <div class="space-y-4">
            {question.options.map((option) => (
              <button
                class="w-full text-left p-4 rounded-lg bg-dark-600 hover:bg-dark-500 transition-colors border border-dark-500 hover:border-primary/50 group"
                data-value={option.value}
              >
                <div class="flex items-center gap-3">
                  <span class="text-2xl group-hover:scale-110 transition-transform">{option.icon}</span>
                  <span>{option.label}</span>
                </div>
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>

    {/* Result */}
    <div id="result" class="hidden">
      <div class="text-center mb-8">
        <h3 class="text-2xl font-bold mb-4">Plan recomendado</h3>
        <p class="text-gray-300">Basado en tus respuestas, este es el plan ideal para tu negocio:</p>
      </div>

      <div id="plan-card" class="bg-dark-600 rounded-xl p-6 border border-primary mb-8">
        <div class="flex items-center gap-3 mb-4">
          <span id="plan-icon" class="text-2xl"></span>
          <h4 id="plan-name" class="text-xl font-bold"></h4>
        </div>
        <p id="plan-description" class="text-gray-300 mb-6"></p>
        <div class="flex flex-wrap items-end gap-2 mb-4">
          <span class="text-3xl font-bold">USD <span id="plan-price"></span></span>
          <span class="text-gray-400">/mes</span>
          <span id="plan-promo" class="text-blue-primary text-sm font-medium"></span>
        </div>
        <div class="flex gap-4">
          <a 
            href="https://cal.com/zinkintech" 
            class="flex-1 text-center py-3 px-6 bg-blue-primary hover:bg-blue-primary/90 rounded-lg transition-colors"
          >
            Elegir este plan
          </a>
          <button 
            id="restart-wizard"
            class="py-3 px-6 border border-gray-600 hover:border-gray-400 rounded-lg transition-colors"
          >
            Volver a empezar
          </button>
        </div>
      </div>

      <div class="text-center">
        <p class="text-gray-300 mb-4">¿No estás seguro?</p>
        <a 
          href="https://cal.com/zinkintech" 
          class="text-primary hover:text-primary-light transition-colors"
        >
          Hablá con nuestro equipo y te ayudamos a elegir el mejor plan para tu negocio
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wizard = document.getElementById('wizard');
    const questions = document.getElementById('questions');
    const result = document.getElementById('result');
    const restartButton = document.getElementById('restart-wizard');

    let currentStep = 0;
    const answers = {};
    const steps = document.querySelectorAll('.question-step');

    // Show first question
    steps[0].classList.remove('hidden');

    // Handle option selection
    questions.addEventListener('click', (e) => {
      const button = e.target.closest('button');
      if (!button) return;

      const step = button.closest('.question-step');
      const value = button.dataset.value;
      
      // Store answer
      answers[currentStep] = value;

      // Move to next question or show result
      if (currentStep < steps.length - 1) {
        steps[currentStep].classList.add('hidden');
        currentStep++;
        steps[currentStep].classList.remove('hidden');
      } else {
        showResult();
      }
    });

    // Restart wizard
    restartButton.addEventListener('click', () => {
      currentStep = 0;
      result.classList.add('hidden');
      questions.classList.remove('hidden');
      steps.forEach((step, index) => {
        if (index === 0) {
          step.classList.remove('hidden');
        } else {
          step.classList.add('hidden');
        }
      });
    });

    function showResult() {
      // Simple logic to determine plan
      let recommendedPlan;
      
      if (answers[1] === 'enterprise' || answers[0] === 'large') {
        recommendedPlan = 'enterprise';
      } else if (answers[1] === 'full' || answers[2] === 'complex') {
        recommendedPlan = 'full';
      } else if (answers[1] === 'pro' || answers[0] === 'small' || answers[2] === 'medium') {
        recommendedPlan = 'pro';
      } else {
        recommendedPlan = 'starter';
      }

      // Update UI with plan details
      const plans = {
        starter: {
          name: 'Plan Emprendedor',
          price: 15,
          icon: '🟢',
          description: 'Tu negocio está dando sus primeros pasos, y ZinkERP puede ayudarte a ordenarlo desde el primer día sin gastar de más.',
          promo: '50% OFF por 3 meses. Luego USD 29/mes'
        },
        pro: {
          name: 'Plan Pyme',
          price: 70,
          icon: '🔵',
          description: 'Tu empresa está en pleno crecimiento. Este plan acompaña una operación con más movimiento sin cobrar por usuario.'
        },
        full: {
          name: 'Plan Escala',
          price: 99,
          icon: '🟣',
          description: 'Este plan está diseñado para negocios con varias sedes o una operación fiscal más intensa.'
        },
        enterprise: {
          name: 'Plan Enterprise Fiscal',
          price: 149,
          icon: '🟠',
          description: 'Para operaciones que superan los 4.500 comprobantes fiscales mensuales y necesitan una arquitectura comercial superior.'
        }
      };

      const plan = plans[recommendedPlan];
      
      document.getElementById('plan-icon').textContent = plan.icon;
      document.getElementById('plan-name').textContent = plan.name;
      document.getElementById('plan-description').textContent = plan.description;
      document.getElementById('plan-price').textContent = plan.price;
      document.getElementById('plan-promo').textContent = plan.promo || '';

      questions.classList.add('hidden');
      result.classList.remove('hidden');
    }
  });
</script>
