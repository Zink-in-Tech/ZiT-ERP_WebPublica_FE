---
const testimonials = [
  {
    name: "Martina",
    position: "Cajera y Atención al Cliente",
    company: "Papelera Pilar Manualidades",
    content: "Desde que empezamos a usar ZinkERP, las ventas y los pagos se registran automáticamente. Antes lo hacíamos todo manual y perdíamos mucho tiempo. Ahora es super práctico y ágil, tanto para nosotros como para los clientes.",
    before: "Registros manuales y pérdida de tiempo",
    after: "Ventas y pagos automatizados",
    impact: "Mayor rapidez en atención"
  },
  {
    name: "Antonella",
    position: "Gerente",
    company: "Limpieza Blue Gualeguaychu",
    content: "ZinkERP nos permitió tener todo en un solo lugar: stock, finanzas, ventas, proveedores y clientes. Lo mejor es que cada movimiento queda registrado automáticamente. Es ideal tanto para emprendedores nuevos como para negocios con experiencia.",
    before: "Información dispersa en varios lugares",
    after: "Todo centralizado y controlado",
    impact: "Control total del negocio"
  }
];
---

<section id="testimonials" class="py-20 relative bg-dark-800">
  <div class="absolute inset-0 z-0 opacity-20">
    <div class="absolute top-0 right-0 w-80 h-80 rounded-full bg-primary-600/20 blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-80 h-80 rounded-full bg-secondary-600/20 blur-3xl"></div>
  </div>

  <div class="container mx-auto px-4 z-10 relative">
    <div class="text-center mb-16 animate-on-scroll">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Lo que dicen nuestros clientes...</h2>
      <p class="text-gray-300 max-w-3xl mx-auto">Historias reales de empresas que transformaron su gestión con ZinkERP</p>
    </div>
    
    <div class="grid md:grid-cols-2 gap-8 max-w-6xl mx-auto">
      {testimonials.map((testimonial, index) => (
        <div class="bg-dark-700 rounded-lg p-8 border border-dark-600 hover:border-primary-500 transition-all duration-300 animate-on-scroll" style={`animation-delay: ${index * 0.15}s`}>
          <div class="flex items-center mb-6">
            <div class="bg-primary-900 rounded-full h-14 w-14 flex items-center justify-center mr-4">
              <span class="text-primary-400 font-bold text-xl">{testimonial.name[0]}</span>
            </div>
            <div>
              <h4 class="font-semibold text-lg">{testimonial.name}</h4>
              <p class="text-gray-400">{testimonial.position}</p>
              <p class="text-gray-400 text-sm">{testimonial.company}</p>
            </div>
          </div>

          <div class="mb-6">
            <p class="text-gray-300 text-lg italic">"{testimonial.content}"</p>
          </div>

          <div class="grid grid-cols-2 gap-4 mt-6 pt-6 border-t border-dark-500">
            <div>
              <div class="flex items-center gap-2 mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" />
                </svg>
                <span class="text-sm text-gray-400">Antes</span>
              </div>
              <p class="text-sm text-gray-300">{testimonial.before}</p>
            </div>
            <div>
              <div class="flex items-center gap-2 mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-500" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" />
                </svg>
                <span class="text-sm text-gray-400">Ahora</span>
              </div>
              <p class="text-sm text-gray-300">{testimonial.after}</p>
            </div>
          </div>

          <div class="mt-4 pt-4 border-t border-dark-500">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 7.414V15a1 1 0 11-2 0V7.414L6.707 9.707a1 1 0 01-1.414 0z" />
              </svg>
              <span class="text-sm text-primary">{testimonial.impact}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>