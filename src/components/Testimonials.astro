---
import { testimonials } from '../data/testimonials';
import TestimonialCard from './TestimonialCard.astro';
---

<section id="testimonials" class="py-24 relative bg-dark-900">
  <div class="absolute inset-0 z-0 opacity-20">
    <div class="absolute top-0 right-0 w-80 h-80 rounded-full bg-primary-600/20 blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-80 h-80 rounded-full bg-secondary-600/20 blur-3xl"></div>
  </div>

  <div class="container mx-auto px-4 z-10 relative">
    <div class="text-center mb-16 animate-on-scroll">
      <p class="text-primary/90 font-medium mb-3 tracking-[0.24em] uppercase text-xs">Prueba social</p>
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Historias reales de empresas que ya ordenaron su operación</h2>
      <p class="text-gray-300 max-w-3xl mx-auto text-lg">Casos concretos de equipos que pasaron de trabajar con dispersión y tareas manuales a operar con más control.</p>
    </div>
    <div class="testimonial-carousel animate-on-scroll" data-testimonial-carousel>
      <div class="testimonial-toolbar">
        <div class="testimonial-toolbar-rail">
          <div class="testimonial-progress-track" aria-hidden="true">
            <div class="testimonial-progress-bar" data-carousel-progress></div>
          </div>
        </div>

        <div class="testimonial-toolbar-actions">
          <button
            type="button"
            class="testimonial-nav"
            data-carousel-prev
            aria-label="Ver testimonios anteriores"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
              <path fill-rule="evenodd" d="M11.78 4.97a.75.75 0 010 1.06L7.81 10l3.97 3.97a.75.75 0 11-1.06 1.06l-4.5-4.5a.75.75 0 010-1.06l4.5-4.5a.75.75 0 011.06 0z" clip-rule="evenodd" />
            </svg>
          </button>
          <button
            type="button"
            class="testimonial-nav"
            data-carousel-next
            aria-label="Ver siguientes testimonios"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
              <path fill-rule="evenodd" d="M8.22 4.97a.75.75 0 011.06 0l4.5 4.5a.75.75 0 010 1.06l-4.5 4.5a.75.75 0 11-1.06-1.06L12.19 10 8.22 6.03a.75.75 0 010-1.06z" clip-rule="evenodd" />
            </svg>
          </button>
        </div>
      </div>

      <div class="testimonial-viewport" data-carousel-viewport tabindex="0" aria-label="Carrusel de testimonios">
        <div class="testimonial-track" data-carousel-track>
          {testimonials.map((testimonial, index) => (
            <div class="testimonial-slide" data-carousel-slide>
              <TestimonialCard testimonial={testimonial} className="h-full animate-on-scroll" style={`animation-delay: ${index * 0.08}s`} />
            </div>
          ))}
        </div>
      </div>

      <div class="testimonial-footer">
        <div class="testimonial-dots" data-carousel-dots aria-label="Paginación de testimonios"></div>
        <p class="testimonial-footer-copy">Deslizá o usá las flechas para recorrer más casos reales.</p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-testimonial-carousel]');
    if (!root) return;

    const viewport = root.querySelector('[data-carousel-viewport]');
    const slides = Array.from(root.querySelectorAll('[data-carousel-slide]'));
    const prevButton = root.querySelector('[data-carousel-prev]');
    const nextButton = root.querySelector('[data-carousel-next]');
    const dotsRoot = root.querySelector('[data-carousel-dots]');
    const progressBar = root.querySelector('[data-carousel-progress]');

    if (!viewport || !slides.length || !prevButton || !nextButton || !dotsRoot || !progressBar) return;

    let currentPage = 0;
    let totalPages = 1;
    let autoTimer;
    let resumeTimer;

    const visibleSlides = () => 1;

    const pageWidth = () => viewport.clientWidth;

    const buildDots = () => {
      dotsRoot.innerHTML = '';
      for (let i = 0; i < totalPages; i += 1) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'testimonial-dot';
        dot.setAttribute('aria-label', 'Ir al grupo ' + (i + 1) + ' de testimonios');
        dot.addEventListener('click', () => goToPage(i));
        dotsRoot.appendChild(dot);
      }
    };

    const updateUi = () => {
      Array.from(dotsRoot.children).forEach((dot, index) => {
        dot.classList.toggle('is-active', index === currentPage);
      });
      progressBar.style.width = ((currentPage + 1) / totalPages) * 100 + '%';
      prevButton.disabled = totalPages <= 1;
      nextButton.disabled = totalPages <= 1;
    };

    const goToPage = (page, behavior = 'smooth') => {
      currentPage = Math.max(0, Math.min(page, totalPages - 1));
      viewport.scrollTo({ left: pageWidth() * currentPage, behavior });
      updateUi();
    };

    const recalc = (behavior = 'auto') => {
      totalPages = Math.max(1, Math.ceil(slides.length / visibleSlides()));
      currentPage = Math.min(currentPage, totalPages - 1);
      buildDots();
      goToPage(currentPage, behavior);
    };

    const stopAuto = () => {
      window.clearInterval(autoTimer);
      autoTimer = undefined;
    };

    const startAuto = () => {
      stopAuto();
      if (totalPages <= 1) return;
      autoTimer = window.setInterval(() => {
        goToPage((currentPage + 1) % totalPages);
      }, 4000);
    };

    const pauseAndResume = () => {
      stopAuto();
      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(startAuto, 4000);
    };

    prevButton.addEventListener('click', () => {
      goToPage((currentPage - 1 + totalPages) % totalPages);
      pauseAndResume();
    });

    nextButton.addEventListener('click', () => {
      goToPage((currentPage + 1) % totalPages);
      pauseAndResume();
    });

    viewport.addEventListener('mouseenter', stopAuto);
    viewport.addEventListener('mouseleave', startAuto);
    viewport.addEventListener('focusin', stopAuto);
    viewport.addEventListener('focusout', startAuto);

    let resizeRaf = 0;
    window.addEventListener('resize', () => {
      window.cancelAnimationFrame(resizeRaf);
      resizeRaf = window.requestAnimationFrame(() => recalc('auto'));
    });

    recalc('auto');
    startAuto();
  })();
</script>

<style>
  .testimonial-toolbar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .testimonial-toolbar-rail {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 1;
  }

  .testimonial-viewport {
    overflow: hidden;
    padding: 0.35rem 0;
  }

  .testimonial-track {
    display: flex;
    gap: 1.75rem;
    scroll-snap-type: x mandatory;
  }

  .testimonial-slide {
    min-width: 100%;
    scroll-snap-align: start;
  }

  .testimonial-progress-track {
    height: 4px;
    width: 100%;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .testimonial-progress-bar {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, rgba(172, 105, 255, 0.95), rgba(0, 126, 255, 0.9));
    transition: width 450ms ease;
  }

  .testimonial-toolbar-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .testimonial-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(14, 19, 31, 0.96);
    color: #d8b4fe;
    box-shadow: 0 10px 24px rgba(2, 6, 23, 0.18);
    transition: transform 180ms ease, border-color 180ms ease, color 180ms ease, box-shadow 180ms ease;
  }

  .testimonial-nav:hover {
    transform: translateY(-1px);
    border-color: rgba(172, 105, 255, 0.5);
    color: white;
    box-shadow: 0 14px 30px rgba(37, 99, 235, 0.12);
  }

  .testimonial-nav:disabled {
    opacity: 0.5;
    cursor: default;
    box-shadow: none;
  }

  .testimonial-footer {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.75rem;
  }

  .testimonial-dots {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
  }

  .testimonial-dot {
    width: 0.7rem;
    height: 0.75rem;
    border-radius: 9999px;
    border: 0;
    background: rgba(148, 163, 184, 0.28);
    transition: transform 180ms ease, background-color 180ms ease, width 180ms ease;
  }

  .testimonial-dot.is-active {
    width: 1.9rem;
    transform: none;
    background: #ac69ff;
  }

  .testimonial-footer-copy {
    text-align: center;
    font-size: 0.92rem;
    color: rgba(148, 163, 184, 0.9);
  }

  @media (min-width: 768px) {
    .testimonial-footer {
      grid-template-columns: 1fr auto;
      align-items: center;
    }

    .testimonial-dots {
      justify-content: flex-start;
    }

    .testimonial-footer-copy {
      text-align: right;
    }
  }

</style>
