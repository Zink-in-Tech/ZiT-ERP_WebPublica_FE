---
const testimonials = [
  {
    name: "Martina",
    position: "Cajera y Atención al Cliente",
    company: "Papelera Pilar Manualidades",
    companyUrl: "https://www.papelerapilarmanualidades.com.ar/",
    logoSrc: "",
    logoAlt: "",
    content: "Desde que empezamos a usar ZinkERP, las ventas y los pagos se registran automáticamente. Antes lo hacíamos todo manual y perdíamos mucho tiempo. Ahora es super práctico y ágil, tanto para nosotros como para los clientes.",
    before: "Registros manuales y pérdida de tiempo",
    after: "Ventas y pagos automatizados",
    impact: "Mayor rapidez en atención",
    result: "Mostrador más ágil"
  },
  {
    name: "Antonella",
    position: "Gerente",
    company: "Limpieza Blue Gualeguaychu",
    companyUrl: "https://www.instagram.com/limpiezablue_gchu/",
    logoSrc: "/img/testimonials/limpieza-blue.svg",
    logoAlt: "Logo de Limpieza Blue Gualeguaychu",
    content: "ZinkERP nos permitió tener todo en un solo lugar: stock, finanzas, ventas, proveedores y clientes. Lo mejor es que cada movimiento queda registrado automáticamente. Es ideal tanto para emprendedores nuevos como para negocios con experiencia.",
    before: "Información dispersa en varios lugares",
    after: "Todo centralizado y controlado",
    impact: "Control total del negocio",
    result: "Operación más ordenada"
  },
  {
    name: "Julieta",
    position: "Encargada",
    company: "Dietéticas Naturales - Sucursal Tortuguitas",
    companyUrl: "https://www.instagram.com/dieteticasnaturales_/?hl=es",
    logoSrc: "/img/testimonials/dieteticas-naturales.svg",
    logoAlt: "Logo de Dietéticas Naturales",
    content: "Pasamos de tener todo disperso a manejar nuestras 3 sucursales desde un solo lugar. Ahora controlamos ventas, stock y caja en tiempo real, sin importar dónde estemos.",
    before: "Sistemas separados para cada tarea",
    after: "Todo integrado en una sola plataforma",
    impact: "Control total entre sucursales",
    result: "Gestión remota y centralizada"
  },
  {
    name: "Juan",
    position: "Kiosco LO DEL MAROTA",
    company: "Lo de Marota - 2 sucursales",
    companyUrl: "https://www.instagram.com/marotas.sr/",
    logoSrc: "/img/testimonials/marota.jpeg",
    logoAlt: "Logo de Lo de Marota",
    content: "Antes trabajábamos con 3 apps distintas y no teníamos una forma real de manejar las dos sucursales desde un mismo lugar. Con ZinkERP, la gestión de precios y la operación diaria dejaron de ser inmantenibles.",
    before: "Precios y operación repartidos en 3 apps sin control multi-sucursal",
    after: "Gestión centralizada para las 2 sucursales en un solo sistema",
    impact: "Menos fricción operativa y más control diario",
    result: "Multi-sucursal manejable"
  },
  {
    name: "Miguel y Alberto",
    position: "Dueños",
    company: "Química Tortuguitas y El Cruce",
    links: [
      {
        label: "Tortuguitas",
        href: "http://www.quimicatortuguitas.com.ar/",
      },
      {
        label: "El Cruce",
        href: "http://quimicaelcruce.com.ar/",
      }
    ],
    logoSrc: "/img/testimonials/quimica-el-cruce.svg",
    logoAlt: "Logo de Química Tortuguitas y El Cruce",
    content: "Antes no estaba todo integrado y manejar varias sucursales implicaba demasiados pasos sueltos. Ahora pueden controlar stock, compras y operación desde un solo lugar, con una base mucho más preparada para sumar una nueva sucursal.",
    before: "Información, stock y compras repartidos sin integración real entre sucursales",
    after: "Operación centralizada para todas las sucursales desde un mismo sistema",
    impact: "Más control multi-sucursal y mejor base para crecer",
    result: "Escala con orden"
  }
];
---

<section id="testimonials" class="py-20 relative bg-dark-800">
  <div class="absolute inset-0 z-0 opacity-20">
    <div class="absolute top-0 right-0 w-80 h-80 rounded-full bg-primary-600/20 blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-80 h-80 rounded-full bg-secondary-600/20 blur-3xl"></div>
  </div>

  <div class="container mx-auto px-4 z-10 relative">
    <div class="text-center mb-16 animate-on-scroll">
      <p class="text-primary font-medium mb-3">Prueba social</p>
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Historias reales de empresas que ya ordenaron su operación</h2>
      <p class="text-gray-300 max-w-3xl mx-auto">Casos concretos de equipos que pasaron de trabajar con dispersión y tareas manuales a operar con más control.</p>
    </div>
    
    <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-8 max-w-7xl mx-auto">
      {testimonials.map((testimonial, index) => (
        <div class="bg-dark-700 rounded-lg p-8 border border-dark-600 hover:border-primary-500 transition-all duration-300 animate-on-scroll" style={`animation-delay: ${index * 0.15}s`}>
          <div class="flex items-start justify-between gap-4 mb-6">
            <div class="flex items-center min-w-0">
              {testimonial.logoSrc ? (
                <div class="bg-white rounded-2xl h-14 w-14 flex items-center justify-center mr-4 shrink-0 overflow-hidden p-2">
                  <img src={testimonial.logoSrc} alt={testimonial.logoAlt || `Logo de ${testimonial.company}`} class="h-full w-full object-contain" loading="lazy" />
                </div>
              ) : (
                <div class="bg-primary-900 rounded-2xl h-14 w-14 flex items-center justify-center mr-4 shrink-0">
                  <span class="text-primary-400 font-bold text-xl">{testimonial.name[0]}</span>
                </div>
              )}
              <div class="min-w-0">
                <h4 class="font-semibold text-lg">{testimonial.name}</h4>
                {testimonial.position && <p class="text-gray-400">{testimonial.position}</p>}
                <p class="text-gray-400 text-sm">{testimonial.company}</p>
              </div>
            </div>
            <div class="flex flex-col items-end gap-2 shrink-0">
              <span class="px-3 py-1 rounded-full border border-primary/30 bg-primary/10 text-primary-light text-xs whitespace-nowrap">{testimonial.result}</span>
              {testimonial.links ? (
                <div class="flex flex-col items-end gap-1">
                  {testimonial.links.map((link) => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noreferrer"
                      class="text-xs text-primary hover:text-primary-light transition-colors"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              ) : testimonial.companyUrl && (
                <a
                  href={testimonial.companyUrl}
                  target="_blank"
                  rel="noreferrer"
                  class="text-xs text-primary hover:text-primary-light transition-colors"
                >
                  Ver empresa
                </a>
              )}
            </div>
          </div>

          <div class="mb-6">
            <p class="text-gray-300 text-lg italic">"{testimonial.content}"</p>
          </div>

          <div class="grid grid-cols-2 gap-4 mt-6 pt-6 border-t border-dark-500">
            <div>
              <div class="flex items-center gap-2 mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" />
                </svg>
                <span class="text-sm text-gray-400">Antes</span>
              </div>
              <p class="text-sm text-gray-300">{testimonial.before}</p>
            </div>
            <div>
              <div class="flex items-center gap-2 mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-500" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" />
                </svg>
                <span class="text-sm text-gray-400">Ahora</span>
              </div>
              <p class="text-sm text-gray-300">{testimonial.after}</p>
            </div>
          </div>

          <div class="mt-4 pt-4 border-t border-dark-500">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 7.414V15a1 1 0 11-2 0V7.414L6.707 9.707a1 1 0 01-1.414 0z" />
              </svg>
              <span class="text-sm text-primary">{testimonial.impact}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
