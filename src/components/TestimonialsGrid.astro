---
import type { TestimonialEntry } from '../data/testimonials';
import TestimonialCard from './TestimonialCard.astro';

interface Props {
  testimonials: TestimonialEntry[];
  columnsClass?: string;
}

const {
  testimonials,
  columnsClass = 'grid md:grid-cols-2 xl:grid-cols-4 gap-8 max-w-7xl mx-auto',
} = Astro.props;
---

<div class={columnsClass}>
  {testimonials.map((testimonial, index) => (
    <TestimonialCard testimonial={testimonial} className="animate-on-scroll" style={`animation-delay: ${index * 0.15}s`} />
  ))}
</div>
