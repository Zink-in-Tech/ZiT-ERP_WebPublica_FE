---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import TestimonialsGrid from './TestimonialsGrid.astro';
import { getTestimonialsByIds } from '../data/testimonials';
import UseCasePainsSection from './use-cases/UseCasePainsSection.astro';
import UseCaseHelpsSection from './use-cases/UseCaseHelpsSection.astro';
import UseCaseFeaturesSection from './use-cases/UseCaseFeaturesSection.astro';
import UseCaseWorkflowsSection from './use-cases/UseCaseWorkflowsSection.astro';

type UseCaseLink = {
  name: string;
  href: string;
};

type UseCaseFaq = {
  question: string;
  answer: string;
};

interface Props {
  family: 'storefront' | 'replenishment' | 'validation';
  pageTitle: string;
  pageDescription: string;
  caseName: string;
  eyebrow: string;
  heroTitle: string;
  heroText: string;
  heroNote: string;
  pains: string[];
  helps: { title: string; text: string }[];
  features: string[];
  workflows: { title: string; text: string }[];
  integrations?: UseCaseLink[];
  testimonialIds?: string[];
  faqs: UseCaseFaq[];
  ctaTitle: string;
  ctaText: string;
  backHref?: string;
  backLabel?: string;
  noindex?: boolean;
}

const {
  family,
  pageTitle,
  pageDescription,
  caseName,
  eyebrow,
  heroTitle,
  heroText,
  heroNote,
  pains,
  helps,
  features,
  workflows,
  integrations = [],
  testimonialIds = [],
  faqs,
  ctaTitle,
  ctaText,
  backHref = '/casos-de-uso',
  backLabel = 'Volver a casos de uso',
  noindex = false,
} = Astro.props;

const whatsappUrl = 'https://wa.link/sgzvr4';
const demoUrl = 'https://cal.com/zinkintech';
const integrationsGridClass =
  integrations.length >= 3 ? 'grid md:grid-cols-2 xl:grid-cols-3 gap-6' : 'grid md:grid-cols-2 gap-6';
const useCaseTestimonials = getTestimonialsByIds(testimonialIds);
const familyMeta = {
  storefront: {
    heroPanelTitle: 'Áreas clave',
    heroPanelClass: 'bg-dark-800 border-dark-700',
    heroGridClass: 'grid sm:grid-cols-2 gap-3',
    heroItemClass: 'rounded-lg bg-dark-700 border border-dark-600 p-4',
  },
  replenishment: {
    heroPanelTitle: 'Puntos a controlar',
    heroPanelClass: 'bg-dark-900 border-emerald-400/10',
    heroGridClass: 'grid gap-3',
    heroItemClass: 'rounded-xl bg-emerald-400/[0.03] border border-emerald-400/10 p-4',
  },
  validation: {
    heroPanelTitle: 'Aspectos a validar',
    heroPanelClass: 'bg-dark-900 border-amber-400/10',
    heroGridClass: 'grid gap-3',
    heroItemClass: 'rounded-xl bg-amber-400/[0.03] border border-amber-400/10 p-4',
  },
}[family];
---

<Layout title={pageTitle} description={pageDescription} noindex={noindex}>
  <Header />
  <main>
    <section class="pt-32 pb-20 bg-dark-900 border-b border-dark-700">
      <div class="container mx-auto px-4">
        <div class="grid gap-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] items-start">
          <div class="max-w-3xl">
            <a href={backHref} class="inline-flex items-center gap-2 text-primary hover:text-primary-light mb-6 animate-on-scroll">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
                <path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd" />
              </svg>
              {backLabel}
            </a>
            <p class="inline-flex items-center gap-2 px-4 py-2 mb-6 rounded-full border border-primary/30 bg-primary/10 text-primary-light text-sm font-medium animate-on-scroll">
              {eyebrow}
            </p>
            <h1 class="text-4xl md:text-6xl font-bold leading-tight mb-6 animate-on-scroll" style="animation-delay: 0.05s;">
              {heroTitle}
            </h1>
            <p class="text-xl text-gray-300 mb-8 animate-on-scroll" style="animation-delay: 0.1s;">
              {heroText}
            </p>
            <div class="flex flex-col sm:flex-row gap-4 animate-on-scroll" style="animation-delay: 0.15s;">
              <a href={demoUrl} class="inline-flex justify-center items-center px-8 py-4 bg-blue-primary hover:bg-blue-primary/90 rounded-lg text-lg font-medium transition-colors sm:w-auto">
                Solicitar demo
              </a>
              <a href={whatsappUrl} class="inline-flex justify-center items-center px-8 py-4 border border-gray-600 hover:border-gray-400 rounded-lg text-lg font-medium transition-colors sm:w-auto">
                Hablar por WhatsApp
              </a>
            </div>
          </div>

          <div class={`border rounded-lg p-6 md:p-8 animate-on-scroll ${familyMeta.heroPanelClass}`} style="animation-delay: 0.2s;">
            <p class="text-sm text-gray-400 mb-4">{familyMeta.heroPanelTitle}</p>
            <div class={familyMeta.heroGridClass}>
              {features.map((item) => (
                <div class={familyMeta.heroItemClass}>
                  <p class="font-medium">{item}</p>
                </div>
              ))}
            </div>
            <p class="text-gray-300 mt-6">
              {heroNote}
            </p>
          </div>
        </div>
      </div>
    </section>

    {family === 'storefront' && (
      <>
        <UseCasePainsSection caseName={caseName} pains={pains} family={family} />
        <UseCaseHelpsSection helps={helps} family={family} />
        <UseCaseFeaturesSection features={features} family={family} />
        <UseCaseWorkflowsSection workflows={workflows} family={family} />
      </>
    )}

    {family === 'replenishment' && (
      <>
        <UseCaseHelpsSection helps={helps} family={family} />
        <UseCaseWorkflowsSection workflows={workflows} family={family} />
        <UseCasePainsSection caseName={caseName} pains={pains} family={family} />
        <UseCaseFeaturesSection features={features} family={family} />
      </>
    )}

    {family === 'validation' && (
      <>
        <UseCasePainsSection caseName={caseName} pains={pains} family={family} />
        <UseCaseWorkflowsSection workflows={workflows} family={family} />
        <UseCaseHelpsSection helps={helps} family={family} />
        <UseCaseFeaturesSection features={features} family={family} />
      </>
    )}

    {integrations.length > 0 && (
      <section class="py-20 bg-dark-800">
        <div class="container mx-auto px-4">
          <div class="max-w-3xl mb-12 animate-on-scroll">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">Integraciones relacionadas</h2>
            <p class="text-lg text-gray-300">
              Cuando el flujo lo requiere, ZinkERP puede conectarse con facturación, pagos o ecommerce.
            </p>
          </div>
          <div class={integrationsGridClass}>
            {integrations.map((integration) => (
              <a href={integration.href} class="group bg-dark-700 border border-dark-600 rounded-lg p-6 h-full hover:border-primary/40 transition-colors animate-on-scroll">
                <p class="text-sm text-primary-light mb-2">Integración</p>
                <h3 class="text-2xl font-bold mb-3 group-hover:text-primary-light transition-colors">{integration.name}</h3>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {useCaseTestimonials.length > 0 && (
      <section class="py-20 bg-dark-800 border-t border-dark-700">
        <div class="container mx-auto px-4">
          <div class="max-w-3xl mb-12 animate-on-scroll">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">Historias del rubro</h2>
            <p class="text-lg text-gray-300">
              Casos reales de negocios similares que ya usan ZinkERP para ordenar la operación diaria.
            </p>
          </div>
          <TestimonialsGrid
            testimonials={useCaseTestimonials}
            columnsClass="grid md:grid-cols-2 gap-8 max-w-6xl mx-auto"
          />
        </div>
      </section>
    )}

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12 animate-on-scroll">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">Preguntas frecuentes</h2>
            <p class="text-lg text-gray-300">Respuestas concretas para entender dónde puede aportar valor ZinkERP en este tipo de operación.</p>
          </div>
          <div class="space-y-4">
            {faqs.map((faq) => (
              <details class="group bg-dark-800 border border-dark-700 rounded-lg p-6 animate-on-scroll">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold text-base md:text-lg">
                  {faq.question}
                  <span class="text-primary transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="mt-4 text-gray-300">{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="demo" class="py-20 bg-dark-800 border-t border-dark-700">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center animate-on-scroll">
          <h2 class="text-3xl md:text-5xl font-bold mb-6">{ctaTitle}</h2>
          <p class="text-xl text-gray-300 mb-8">
            {ctaText}
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
            <a href={demoUrl} class="inline-flex justify-center items-center px-8 py-4 bg-blue-primary hover:bg-blue-primary/90 rounded-lg text-lg font-medium transition-colors">
              Solicitar demo
            </a>
            <a href={whatsappUrl} class="inline-flex justify-center items-center px-8 py-4 border border-gray-600 hover:border-gray-400 rounded-lg text-lg font-medium transition-colors">
              Hablar por WhatsApp
            </a>
          </div>
          <a href="/casos-de-uso" class="inline-flex items-center gap-2 text-primary hover:text-primary-light transition-colors">
            Ver otros casos de uso
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
