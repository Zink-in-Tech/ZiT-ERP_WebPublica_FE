---
import type { UseCaseProblem } from '../../data/useCases';

interface Props {
  caseName: string;
  problems: UseCaseProblem[];
}

const { caseName, problems } = Astro.props;
---

<section class="py-20 bg-dark-800" aria-labelledby="use-case-problems-title">
  <div class="container mx-auto px-4">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] items-start">
      <div class="animate-on-scroll">
        <h2 id="use-case-problems-title" class="text-3xl md:text-4xl font-bold mb-4">
          Problemas concretos de {caseName}
        </h2>
        <p class="text-lg text-gray-300">
          No es falta de módulos. Es carga manual, errores de precio o stock, y pérdida de control entre sedes.
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-4">
        {problems.map((problem, index) => (
          <article class="group bg-dark-900 border border-white/5 rounded-xl p-5 animate-on-scroll relative overflow-hidden">
            <div class="absolute inset-y-0 left-0 w-1 bg-gradient-to-b from-rose-500 via-orange-400 to-transparent"></div>
            <div class="flex items-start gap-4">
              <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-rose-500/10 text-rose-300 font-bold">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="font-semibold text-white mb-2">{problem.title}</h3>
                <p class="text-gray-300 leading-relaxed">{problem.text}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
