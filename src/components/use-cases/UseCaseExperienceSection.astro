---
import TestimonialsGrid from '../TestimonialsGrid.astro';
import { getTestimonialsByIds } from '../../data/testimonials';
import type { UseCaseExperience } from '../../data/useCases';

interface Props {
  experience?: UseCaseExperience;
  testimonialIds?: string[];
}

const { experience, testimonialIds = [] } = Astro.props;
const testimonials = getTestimonialsByIds(testimonialIds);
---

{(experience || testimonials.length > 0) && (
  <section class="py-20 bg-dark-800 border-t border-dark-700" aria-labelledby="use-case-experience-title">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mb-12 animate-on-scroll">
        <h2 id="use-case-experience-title" class="text-3xl md:text-4xl font-bold mb-4">
          Experiencia en el rubro
        </h2>
        <p class="text-lg text-gray-300">
          {experience?.kind === 'anonymized'
            ? 'Un caso representativo de cómo opera este rubro con ZinkERP.'
            : 'Experiencia real de negocios que ya operan este circuito con ZinkERP.'}
        </p>
      </div>

      {experience && (
        <article class="max-w-4xl mb-12 rounded-2xl border border-white/8 bg-dark-900 p-6 md:p-8 animate-on-scroll">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary-light mb-3">
            {experience.kind === 'anonymized' ? 'Caso de uso' : 'Cliente'}
          </p>
          <h3 class="text-2xl font-bold mb-6">{experience.title}</h3>
          <dl class="grid gap-5 md:grid-cols-2">
            {experience.business && (
              <div>
                <dt class="text-xs uppercase tracking-[0.14em] text-gray-500 mb-1">Negocio</dt>
                <dd class="text-gray-200">{experience.business}</dd>
              </div>
            )}
            {experience.complexity && (
              <div>
                <dt class="text-xs uppercase tracking-[0.14em] text-gray-500 mb-1">Complejidad</dt>
                <dd class="text-gray-200">{experience.complexity}</dd>
              </div>
            )}
            <div class="md:col-span-2">
              <dt class="text-xs uppercase tracking-[0.14em] text-gray-500 mb-1">Problema inicial</dt>
              <dd class="text-gray-200">{experience.problem}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-[0.14em] text-gray-500 mb-1">Flujo implementado</dt>
              <dd class="text-gray-200">{experience.flow}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-[0.14em] text-gray-500 mb-1">Resultado observable</dt>
              <dd class="text-gray-200">{experience.result}</dd>
            </div>
          </dl>
        </article>
      )}

      {testimonials.length > 0 && (
        <TestimonialsGrid
          testimonials={testimonials}
          columnsClass="grid md:grid-cols-2 gap-8 max-w-6xl"
        />
      )}
    </div>
  </section>
)}
