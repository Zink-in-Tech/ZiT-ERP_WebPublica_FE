---
type UseCaseFamily = 'storefront' | 'replenishment' | 'validation';

interface Props {
  caseName: string;
  pains: string[];
  family: UseCaseFamily;
}

const { caseName, pains, family } = Astro.props;

const sectionTitle =
  family === 'replenishment'
    ? 'Fricciones que frenan la operación'
    : family === 'validation'
      ? 'Puntos delicados del rubro'
      : 'Problemas comunes del rubro';

const sectionText =
  family === 'replenishment'
    ? `${caseName} necesita reposición, disponibilidad y ritmo comercial alineados para no vender a ciegas.`
    : family === 'validation'
      ? `${caseName} mezcla operación, criterio comercial y procesos propios del rubro que conviene revisar con más cuidado.`
      : `${caseName} suele exigir ventas bien resueltas, control operativo y decisiones rápidas sin perder ritmo en el día a día.`;
---

<section class="py-20 bg-dark-800">
  <div class="container mx-auto px-4">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] items-start">
      <div class="animate-on-scroll">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">{sectionTitle}</h2>
        <p class="text-lg text-gray-300">{sectionText}</p>
      </div>
      <div class="grid md:grid-cols-2 gap-4">
        {pains.map((pain, index) => (
          family === 'validation' ? (
            <div class="group bg-dark-900 border border-amber-400/10 rounded-xl p-5 animate-on-scroll relative overflow-hidden hover:-translate-y-1 hover:border-amber-300/25 hover:bg-amber-400/[0.04]">
              <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-amber-400/60 via-amber-200/20 to-transparent"></div>
              <div class="flex items-start gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-amber-400/10 text-amber-200 font-bold group-hover:bg-amber-400/15">?</span>
                <p class="text-gray-100 leading-relaxed">{pain}</p>
              </div>
            </div>
          ) : family === 'replenishment' ? (
            <div class="group bg-dark-900 border border-emerald-400/10 rounded-xl p-5 animate-on-scroll relative overflow-hidden hover:-translate-y-1 hover:border-emerald-300/25 hover:bg-emerald-400/[0.04]">
              <div class="absolute inset-y-0 left-0 w-1 bg-gradient-to-b from-emerald-400 via-teal-400 to-transparent"></div>
              <div class="flex items-start gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-emerald-400/10 text-emerald-200 font-bold group-hover:bg-emerald-400/15">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <p class="text-gray-100 leading-relaxed">{pain}</p>
              </div>
            </div>
          ) : (
            <div class="group bg-dark-900 border border-white/5 rounded-xl p-5 animate-on-scroll relative overflow-hidden hover:-translate-y-1 hover:border-rose-300/20 hover:bg-white/[0.02]">
              <div class="absolute inset-y-0 left-0 w-1 bg-gradient-to-b from-rose-500 via-orange-400 to-transparent"></div>
              <div class="flex items-start gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-rose-500/10 text-rose-300 font-bold group-hover:bg-rose-500/15">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <p class="text-gray-100 leading-relaxed">{pain}</p>
              </div>
            </div>
          )
        ))}
      </div>
    </div>
  </div>
</section>
