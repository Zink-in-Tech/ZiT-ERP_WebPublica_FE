---
type UseCaseFamily = 'storefront' | 'replenishment' | 'validation';

interface HelpItem {
  title: string;
  text: string;
}

interface Props {
  helps: HelpItem[];
  family: UseCaseFamily;
}

const { helps, family } = Astro.props;

const title =
  family === 'validation'
    ? 'Dónde puede aportar valor ZinkERP'
    : family === 'replenishment'
      ? 'Cómo ordena la operación'
      : 'Cómo ayuda ZinkERP';

const intro =
  family === 'validation'
    ? 'En estos casos, el valor aparece cuando ventas, stock, facturación y seguimiento comercial dejan de quedar repartidos entre herramientas sueltas.'
    : family === 'replenishment'
      ? 'El foco está en vender con menos fricción, reponer con más criterio y mirar mejor qué está pasando en el negocio.'
      : 'ZinkERP ayuda a que ventas, stock, POS y facturación trabajen dentro del mismo circuito operativo, con menos fricción para el equipo.';

const accentClasses =
  family === 'validation'
    ? 'from-amber-400/60 to-orange-400/40 bg-amber-400/10 text-amber-200'
    : family === 'replenishment'
      ? 'from-emerald-400/60 to-teal-400/40 bg-emerald-400/10 text-emerald-200'
      : 'from-primary/70 to-fuchsia-400/40 bg-primary/10 text-primary';
---

<section class="py-20">
  <div class="container mx-auto px-4">
    <div class="max-w-3xl mb-12 animate-on-scroll">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">{title}</h2>
      <p class="text-lg text-gray-300">{intro}</p>
    </div>
    <div class={`grid gap-6 ${family === 'storefront' ? 'md:grid-cols-2 xl:grid-cols-4' : 'md:grid-cols-2 xl:grid-cols-2'}`}>
      {helps.map((item, index) => (
        <article class="bg-dark-800 border border-dark-700 rounded-2xl p-6 hover:border-white/10 transition-colors animate-on-scroll relative overflow-hidden">
          <div class={`absolute inset-x-0 top-0 h-px bg-gradient-to-r ${accentClasses.split(' ')[0]} ${accentClasses.split(' ')[1]}`}></div>
          <div class={`w-11 h-11 rounded-xl flex items-center justify-center mb-5 ${accentClasses.split(' ')[2]} ${accentClasses.split(' ')[3]}`}>
            <span class="font-bold">{index + 1}</span>
          </div>
          <h2 class="text-xl font-bold mb-3">{item.title}</h2>
          <p class="text-gray-300">{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
