---
import type { UseCaseDifferential } from '../../data/useCases';

interface Props {
  differentials: UseCaseDifferential[];
}

const { differentials } = Astro.props;
---

<section class="py-20" aria-labelledby="use-case-differentials-title">
  <div class="container mx-auto px-4">
    <div class="max-w-3xl mb-12 animate-on-scroll">
      <h2 id="use-case-differentials-title" class="text-3xl md:text-4xl font-bold mb-4">
        Cómo se conecta la operación
      </h2>
      <p class="text-lg text-gray-300">
        ZinkERP no es “muchos módulos”. Es el circuito que evita recargar el mismo dato y perder control de stock, caja o cuenta corriente.
      </p>
    </div>
    <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">
      {differentials.map((item) => (
        <article class="bg-dark-800 border border-dark-700 rounded-2xl p-6 animate-on-scroll">
          <h3 class="text-xl font-bold mb-3">{item.title}</h3>
          <p class="text-gray-300">{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
