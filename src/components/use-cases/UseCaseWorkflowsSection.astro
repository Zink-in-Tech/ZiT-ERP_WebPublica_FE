---
type UseCaseFamily = 'storefront' | 'replenishment' | 'validation';

interface WorkflowItem {
  title: string;
  text: string;
}

interface Props {
  workflows: WorkflowItem[];
  family: UseCaseFamily;
}

const { workflows, family } = Astro.props;

const dotClasses =
  family === 'validation'
    ? 'bg-amber-400/10 text-amber-200'
    : family === 'replenishment'
      ? 'bg-emerald-400/10 text-emerald-200'
      : 'bg-primary/10 text-primary';
---

<section class="py-20">
  <div class="container mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center mb-12 animate-on-scroll">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Flujos que se pueden ordenar</h2>
      <p class="text-lg text-gray-300">
        Estos suelen ser algunos de los momentos donde más se nota la diferencia entre operar con método o apagar incendios sobre la marcha.
      </p>
    </div>
    <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">
      {workflows.map((workflow, index) => (
        <article class="group bg-dark-800 border border-dark-700 rounded-lg p-6 animate-on-scroll hover:-translate-y-1 hover:border-primary/30 hover:bg-white/[0.02]">
          <span class={`inline-flex h-9 w-9 items-center justify-center rounded-lg font-bold mb-5 ${dotClasses} group-hover:scale-105`}>
            {index + 1}
          </span>
          <h3 class="text-xl font-bold mb-3">{workflow.title}</h3>
          <p class="text-gray-300">{workflow.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
