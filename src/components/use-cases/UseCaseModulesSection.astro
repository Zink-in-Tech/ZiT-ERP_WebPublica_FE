---
import type { UseCaseModule } from '../../data/useCases';

interface Props {
  modules: UseCaseModule[];
}

const { modules } = Astro.props;
---

<section class="py-20 bg-dark-800" aria-labelledby="use-case-modules-title">
  <div class="container mx-auto px-4">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] items-start">
      <div class="animate-on-scroll">
        <h2 id="use-case-modules-title" class="text-3xl md:text-4xl font-bold mb-4">
          Módulos que resuelven este rubro
        </h2>
        <p class="text-lg text-gray-300">
          No es una lista completa del producto. Son los módulos que cierran el circuito de este negocio y para qué sirven.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {modules.map((module) => (
          <a
            href={module.href}
            class="group rounded-xl border border-white/8 bg-dark-900 px-5 py-5 hover:border-primary/30 transition-colors animate-on-scroll"
          >
            <h3 class="font-semibold text-white mb-2 group-hover:text-primary-light">{module.name}</h3>
            <p class="text-sm text-gray-300 leading-6">{module.purpose}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
