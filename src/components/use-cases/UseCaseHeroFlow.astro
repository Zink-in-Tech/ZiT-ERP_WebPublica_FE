---
import type { UseCaseFlowStep } from '../../data/useCases';

interface Props {
  steps: UseCaseFlowStep[];
  label?: string;
}

const { steps, label = 'Flujo operativo' } = Astro.props;
---

<div class="border border-dark-700 rounded-2xl bg-dark-800 p-6 md:p-8">
  <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary-light mb-5">{label}</p>
  <ol class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
    {steps.map((step, index) => (
      <li class="relative rounded-xl border border-white/8 bg-dark-900/80 p-4">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Paso {index + 1}</p>
        <p class="mt-2 font-semibold text-white">{step.title}</p>
        {step.impact && (
          <p class="mt-2 text-xs text-primary-light">{step.impact}</p>
        )}
      </li>
    ))}
  </ol>
</div>
