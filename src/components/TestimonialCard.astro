---
import type { TestimonialEntry } from '../data/testimonials';

interface Props {
  testimonial: TestimonialEntry;
  variant?: 'full' | 'compact';
  className?: string;
  style?: string;
}

const { testimonial, variant = 'full', className = '', style = '' } = Astro.props;
const quote = testimonial.homeQuote ?? testimonial.content;
---

{variant === 'compact' ? (
  <article
    class:list={[
      'group flex h-full flex-col rounded-[1.15rem] bg-white/[0.02] px-6 py-6 ring-1 ring-inset ring-white/7 transition-all duration-300 hover:-translate-y-1 hover:bg-white/[0.03] hover:ring-white/10',
      className,
    ]}
    style={style}
  >
    <div class="mb-4 flex items-start justify-between gap-3">
      <span class="text-3xl leading-none text-primary/80 font-serif" aria-hidden="true">“</span>
      <span class="max-w-[60%] truncate rounded-full border border-primary/15 bg-primary/[0.06] px-3 py-1 text-[11px] text-primary-light">
        {testimonial.result}
      </span>
    </div>

    <blockquote class="mb-6 flex-1">
      <p class="text-[1.02rem] leading-7 text-white/94">{quote}</p>
    </blockquote>

    <footer class="mt-auto border-t border-white/8 pt-5">
      <div class="flex items-start gap-4 min-w-0">
        {testimonial.logoSrc ? (
          <div class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-white p-2 shadow-sm shadow-black/10">
            <img
              src={testimonial.logoSrc}
              alt={testimonial.logoAlt || `Logo de ${testimonial.company}`}
              width="56"
              height="56"
              class="h-full w-full object-contain"
              loading="lazy"
            />
          </div>
        ) : (
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-primary-900">
            <span class="text-lg font-bold text-primary-400">{testimonial.name[0]}</span>
          </div>
        )}
        <div class="min-w-0 flex-1">
          <cite class="not-italic">
            <h3 class="text-[1.02rem] font-semibold leading-6 text-white">{testimonial.name}</h3>
          </cite>
          {testimonial.position && <p class="text-sm leading-5 text-gray-400">{testimonial.position}</p>}
          <p class="text-sm leading-5 text-gray-400">{testimonial.company}</p>
          {testimonial.industry && (
            <p class="mt-1 text-xs leading-5 text-gray-500">{testimonial.industry}</p>
          )}
        </div>
      </div>

      <div class="mt-3 flex flex-wrap items-center gap-3">
        {testimonial.links ? (
          testimonial.links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs text-primary transition-colors hover:text-primary-light"
            >
              {link.label}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.25 10A.75.75 0 016 9.25h6.19L9.22 6.28a.75.75 0 111.06-1.06l4.25 4.25a.75.75 0 010 1.06l-4.25 4.25a.75.75 0 01-1.06-1.06l2.97-2.97H6A.75.75 0 015.25 10z" clip-rule="evenodd" />
              </svg>
            </a>
          ))
        ) : testimonial.companyUrl && (
          <a
            href={testimonial.companyUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visitar web de ${testimonial.company}`}
            class="inline-flex items-center gap-1.5 text-xs text-primary transition-colors hover:text-primary-light"
          >
            Ver empresa
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.25 10A.75.75 0 016 9.25h6.19L9.22 6.28a.75.75 0 111.06-1.06l4.25 4.25a.75.75 0 010 1.06l-4.25 4.25a.75.75 0 01-1.06-1.06l2.97-2.97H6A.75.75 0 015.25 10z" clip-rule="evenodd" />
            </svg>
          </a>
        )}
      </div>
    </footer>
  </article>
) : (
  <article class:list={['bg-dark-800/96 rounded-[1.25rem] p-5 border border-white/8 hover:-translate-y-1 hover:border-primary/25 hover:bg-white/[0.015] transition-all duration-300 flex h-full flex-col', className]} style={style}>
    <div class="mb-4">
      <div class="flex items-start justify-between gap-3 mb-4">
        <span class="text-4xl leading-none text-primary/70 font-serif">“</span>
        <span class="max-w-full truncate px-3 py-1 rounded-full border border-primary/15 bg-primary/[0.06] text-primary-light text-[11px] whitespace-nowrap">{testimonial.result}</span>
      </div>

      <div class="mb-4 max-w-2xl">
        <p class="text-[1rem] leading-7 text-white/95">
          {testimonial.content}
        </p>
      </div>

      <div class="flex items-start gap-3 min-w-0">
        {testimonial.logoSrc ? (
          <div class="bg-white rounded-xl h-11 w-11 flex items-center justify-center shrink-0 overflow-hidden p-1.5 shadow-sm shadow-black/10">
            <img src={testimonial.logoSrc} alt={testimonial.logoAlt || `Logo de ${testimonial.company}`} width="44" height="44" class="h-full w-full object-contain" loading="lazy" />
          </div>
        ) : (
          <div class="bg-primary-900 rounded-xl h-11 w-11 flex items-center justify-center shrink-0">
            <span class="text-primary-400 font-bold text-lg">{testimonial.name[0]}</span>
          </div>
        )}
        <div class="min-w-0 flex-1">
          <h4 class="font-semibold text-[1.05rem] text-white leading-6">{testimonial.name}</h4>
          {testimonial.position && <p class="text-gray-400 text-sm leading-5">{testimonial.position}</p>}
          <p class="text-gray-400 text-sm leading-5">{testimonial.company}</p>
        </div>
      </div>

      <div class="mt-3 flex flex-wrap items-center gap-3">
        {testimonial.links ? (
          <div class="flex flex-wrap items-center gap-3">
            {testimonial.links.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs text-primary hover:text-primary-light transition-colors"
              >
                {link.label}
              </a>
            ))}
          </div>
        ) : testimonial.companyUrl && (
          <a
            href={testimonial.companyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-primary hover:text-primary-light transition-colors"
          >
            Ver empresa
          </a>
        )}
      </div>
    </div>

    <div class="grid gap-3 mt-auto pt-4 border-t border-white/8 md:grid-cols-2">
      <div class="rounded-xl bg-white/[0.02] px-4 py-3">
        <div class="flex items-center gap-2 mb-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" />
          </svg>
          <span class="text-xs uppercase tracking-[0.18em] text-gray-500">Antes</span>
        </div>
        <p class="text-sm text-gray-300 leading-6">{testimonial.before}</p>
      </div>
      <div class="rounded-xl bg-white/[0.02] px-4 py-3">
        <div class="flex items-center gap-2 mb-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-500" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" />
          </svg>
          <span class="text-xs uppercase tracking-[0.18em] text-gray-500">Ahora</span>
        </div>
        <p class="text-sm text-gray-300 leading-6">{testimonial.after}</p>
      </div>
    </div>

    <div class="mt-3 rounded-xl bg-primary/[0.05] px-4 py-3">
      <div class="flex items-start gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 7.414V15a1 1 0 11-2 0V7.414L6.707 9.707a1 1 0 01-1.414 0z" />
        </svg>
        <span class="text-sm text-primary leading-6">{testimonial.impact}</span>
      </div>
    </div>
  </article>
)}
