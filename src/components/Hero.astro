---
---

<section class="relative min-h-screen pt-24 pb-16 flex items-center">
  <div class="absolute inset-0 z-0 opacity-30">
    <div class="absolute inset-0 bg-gradient-to-b from-dark-900 via-dark-800 to-dark-900"></div>
    <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-dark-900 to-transparent"></div>
    
    <!-- Gradient orbs - hidden on mobile -->
    <div class="hidden md:block">
      <div class="absolute top-1/4 right-1/4 w-64 h-64 rounded-full bg-primary/20 blur-3xl"></div>
      <div class="absolute bottom-1/3 left-1/3 w-80 h-80 rounded-full bg-primary/20 blur-3xl"></div>
    </div>
  </div>
  
  <div class="container mx-auto px-4 z-10">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="animate-on-scroll">
        <p class="inline-flex items-center gap-2 px-4 py-2 mb-6 rounded-full border border-primary/30 bg-primary/10 text-primary-light text-sm font-medium">
          ERP operativo para pymes argentinas
        </p>
        <h1 class="text-4xl md:text-6xl font-bold leading-tight mb-4">
          El sistema operativo para tu pyme. <span class="text-primary">Desde una sucursal o veinte.</span>
        </h1>
        <p class="text-gray-300 text-lg md:text-xl mb-8 max-w-2xl">
          Ventas, stock, caja, ARCA y sucursales en un solo lugar. ZinkERP te ayuda a ordenar la operación diaria y crecer sin perder agilidad.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 mb-12">
          <a href="#features" class="px-6 py-3 rounded-md bg-blue-primary hover:bg-blue-primary/90 transition-colors text-center font-medium">
            Ver cómo funciona
          </a>
          <a href="https://cal.com/zinkintech" class="px-6 py-3 rounded-md border border-gray-600 hover:border-gray-400 transition-colors text-center font-medium">
            Pedí tu demo
          </a>
        </div>
        
        <div class="grid sm:grid-cols-2 gap-3 max-w-2xl">
          <div class="flex items-center rounded-xl border border-dark-600 bg-dark-800/80 px-4 py-3">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-primary shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="ml-2 text-gray-300">ARCA nativa</span>
          </div>
          <div class="flex items-center rounded-xl border border-dark-600 bg-dark-800/80 px-4 py-3">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-primary shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="ml-2 text-gray-300">Usuarios ilimitados</span>
          </div>
          <div class="flex items-center rounded-xl border border-dark-600 bg-dark-800/80 px-4 py-3">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-primary shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="ml-2 text-gray-300">Operación multi-sucursal</span>
          </div>
          <div class="flex items-center rounded-xl border border-dark-600 bg-dark-800/80 px-4 py-3">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-primary shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="ml-2 text-gray-300">Soporte cercano</span>
          </div>
        </div>
      </div>
      
      <div class="animate-on-scroll" style="animation-delay: 0.3s;">
        <div class="relative">
          <div class="">
            <img 
              src="/img/hero-img.png" 
              alt="ZinkERP Dashboard" 
              class="rounded-lg w-full"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
