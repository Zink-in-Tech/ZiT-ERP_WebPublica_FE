---
const productMoments = [
  {
    title: 'Venta en mostrador',
    description: 'Una venta corta, clara y sin pasos de más. Ideal para reemplazar con el video de POS.',
    eyebrow: 'Venta rápida',
    kind: 'video',
    poster: '/img/product-captures/pos-nuevo.png',
    src: '/img/product-motion/venta-pos.mp4',
    span: 'feature',
  },
  {
    title: 'Toma de inventario',
    description: 'Un flujo corto para mostrar conteo, control y actualización del stock en tiempo real.',
    eyebrow: 'Inventario',
    kind: 'video',
    poster: '/img/product-captures/actualizacion-masiva-productos.png',
    src: '/img/product-motion/toma-inventario.mp4',
    span: 'support',
  },
  {
    title: 'Venta comercial',
    description: 'Un flujo más comercial para mostrar presupuestos, clientes y cierre de venta fuera del mostrador.',
    eyebrow: 'Gestión comercial',
    kind: 'video',
    poster: '/img/product-captures/informes-centro.png',
    src: '/img/product-motion/venta-comercial.mp4',
    span: 'support',
  },
  {
    title: 'Dashboard general',
    description: 'Una vista rápida para mostrar ventas, vencimientos y control diario del negocio en un solo panel.',
    eyebrow: 'Visión general',
    kind: 'video',
    poster: '/img/product-captures/dashboard.png',
    src: '/img/product-motion/dashboard-base.mp4',
    span: 'support',
  },
];

const [featureMoment, ...supportMoments] = productMoments;
const initialSupportMoment = supportMoments[0];
---

<section class="relative py-24 bg-dark-900 before:absolute before:inset-x-0 before:top-0 before:h-px before:bg-gradient-to-r before:from-transparent before:via-slate-700/55 before:to-transparent">
  <div class="container mx-auto px-4">
    <div class="max-w-3xl mb-14 animate-on-scroll">
      <p class="text-primary/90 font-medium mb-3 tracking-[0.18em] uppercase text-xs">Producto visible</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-[-0.02em] mb-4">Videos cortos de una operación que ya está en marcha</h2>
      <p class="text-lg text-gray-300 leading-8">
        La idea de esta sección es mostrar acciones reales del sistema en movimiento: vender, controlar inventario, resolver una venta comercial y leer el estado general del negocio desde un solo lugar.
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-[1.18fr_0.82fr] items-stretch">
      <article class="group rounded-[1.5rem] bg-white/[0.02] ring-1 ring-inset ring-white/7 p-5 md:p-6 transition-all duration-300 hover:-translate-y-1 hover:bg-white/[0.03] hover:ring-white/10 animate-on-scroll">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="px-3 py-1 rounded-full border border-primary/15 bg-primary/[0.06] text-primary-light text-xs whitespace-nowrap">{featureMoment.eyebrow}</span>
          <p class="text-sm text-gray-400">{featureMoment.description}</p>
        </div>
        <h3 class="text-2xl font-bold mb-5">{featureMoment.title}</h3>
        <div class="rounded-[1.2rem] overflow-hidden bg-dark-900 ring-1 ring-inset ring-white/8">
          <video
            class="w-full aspect-[16/10] object-cover"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={featureMoment.poster}
          >
            <source src={featureMoment.src} type="video/mp4" />
          </video>
        </div>
      </article>

      <article class="group rounded-[1.35rem] bg-white/[0.02] ring-1 ring-inset ring-white/7 p-5 transition-all duration-300 hover:-translate-y-1 hover:bg-white/[0.03] hover:ring-white/10 animate-on-scroll">
        <div class="flex flex-wrap gap-2 mb-5" role="tablist" aria-label="Otras vistas del producto">
          {supportMoments.map((moment, index) => (
            <button
              type="button"
              class:list={[
                'product-showcase-tab rounded-full border px-3 py-1.5 text-xs transition-colors duration-200',
                index === 0
                  ? 'border-primary/30 bg-primary/[0.09] text-primary-light'
                  : 'border-white/10 bg-white/[0.02] text-gray-300 hover:border-white/20 hover:text-white'
              ]}
              data-title={moment.title}
              data-description={moment.description}
              data-eyebrow={moment.eyebrow}
              data-poster={moment.poster}
              data-src={moment.src}
              aria-selected={index === 0 ? 'true' : 'false'}
              role="tab"
            >
              {moment.eyebrow}
            </button>
          ))}
        </div>

        <div id="product-showcase-support-copy" class="transition-opacity duration-200 ease-out">
        <div class="mb-4">
          <span id="product-showcase-support-eyebrow" class="inline-flex px-3 py-1 rounded-full border border-primary/15 bg-primary/[0.06] text-primary-light text-xs whitespace-nowrap">{initialSupportMoment.eyebrow}</span>
        </div>

        <h3 id="product-showcase-support-title" class="text-xl font-bold mb-3">{initialSupportMoment.title}</h3>
        <p id="product-showcase-support-description" class="text-sm text-gray-300 leading-6 mb-4">{initialSupportMoment.description}</p>
        </div>

        <div class="rounded-[1.05rem] overflow-hidden bg-dark-900 ring-1 ring-inset ring-white/8">
          <video
            id="product-showcase-support-video"
            class="w-full aspect-[16/10] object-cover transition-opacity duration-200 ease-out"
            muted
            loop
            playsinline
            preload="metadata"
            poster={initialSupportMoment.poster}
            aria-label={`${initialSupportMoment.title}. Reproducir vista previa al pasar el cursor.`}
          >
            <source id="product-showcase-support-source" src={initialSupportMoment.src} type="video/mp4" />
          </video>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  const supportCard = document.getElementById('product-showcase-support-video')?.closest('article');
  const supportVideo = document.getElementById('product-showcase-support-video');
  const supportSource = document.getElementById('product-showcase-support-source');
  const supportEyebrow = document.getElementById('product-showcase-support-eyebrow');
  const supportTitle = document.getElementById('product-showcase-support-title');
  const supportDescription = document.getElementById('product-showcase-support-description');
  const supportCopy = document.getElementById('product-showcase-support-copy');
  const supportTabs = Array.from(document.querySelectorAll('.product-showcase-tab'));

  const playPreview = () => {
    if (!supportVideo) return;
    supportVideo.currentTime = 0;
    void supportVideo.play().catch(() => {});
  };

  const pausePreview = () => {
    if (!supportVideo) return;
    supportVideo.pause();
    supportVideo.currentTime = 0;
  };

  const setActiveTab = async (activeTab) => {
    if (!supportVideo || !supportSource || !supportEyebrow || !supportTitle || !supportDescription || !supportCopy) return;

    for (const tab of supportTabs) {
      const isActive = tab === activeTab;
      tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      tab.classList.toggle('border-primary/30', isActive);
      tab.classList.toggle('bg-primary/[0.09]', isActive);
      tab.classList.toggle('text-primary-light', isActive);
      tab.classList.toggle('border-white/10', !isActive);
      tab.classList.toggle('bg-white/[0.02]', !isActive);
      tab.classList.toggle('text-gray-300', !isActive);
    }

    supportCopy.classList.add('opacity-0');
    supportVideo.classList.add('opacity-0');
    await new Promise((resolve) => setTimeout(resolve, 140));

    supportEyebrow.textContent = activeTab.dataset.eyebrow ?? '';
    supportTitle.textContent = activeTab.dataset.title ?? '';
    supportDescription.textContent = activeTab.dataset.description ?? '';
    supportVideo.setAttribute('poster', activeTab.dataset.poster ?? '');
    supportVideo.setAttribute('aria-label', `${activeTab.dataset.title ?? 'Vista del producto'}. Reproducir vista previa al pasar el cursor.`);
    supportSource.setAttribute('src', activeTab.dataset.src ?? '');
    supportVideo.load();
    supportCopy.classList.remove('opacity-0');
    supportVideo.classList.remove('opacity-0');
    playPreview();
  };

  for (const tab of supportTabs) {
    tab.addEventListener('click', () => setActiveTab(tab));
    tab.addEventListener('focus', () => setActiveTab(tab));
  }

  if (supportCard) {
    supportCard.addEventListener('mouseenter', playPreview);
    supportCard.addEventListener('mouseleave', pausePreview);
    supportCard.addEventListener('focusin', playPreview);
    supportCard.addEventListener('focusout', pausePreview);
  }
</script>
