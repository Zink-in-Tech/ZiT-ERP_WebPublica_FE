---
const benefits = [
  {
    group: "Control Operativo",
    icon: "🟣",
    description: "Simplificás el día a día. Lo urgente deja de tapar lo importante.",
    color: "from-purple-500 to-indigo-600",
    items: [
      {
        title: "Compras eficientes",
        description: "Automatizá pedidos, aprobaciones y control de proveedores. Evitá errores y duplicaciones que te hacen perder plata.",
        icon: "shopping"
      },
      {
        title: "Stock sin complicaciones",
        description: "Sabé exactamente qué tenés y dónde. Dejá atrás las planillas eternas y el 'me parece que queda'.",
        icon: "clipboard"
      },
      {
        title: "Usuarios con permisos claros",
        description: "Asigná perfiles por área o sucursal. Cada persona ve lo que tiene que ver, sin poner en riesgo la operación.",
        icon: "lock"
      }
    ]
  },
  {
    group: "Visión Financiera",
    icon: "🔵",
    description: "Entendés tu negocio con números reales, no con intuición.",
    color: "from-blue-500 to-cyan-600",
    items: [
      {
        title: "Cuentas claras",
        description: "Visualizá ingresos, egresos y vencimientos de clientes y proveedores en tiempo real. Sin sorpresas al cierre del mes.",
        icon: "money"
      },
      {
        title: "Decisiones basadas en datos",
        description: "Accedé a informes visuales de ventas, márgenes y resultados. Tomá decisiones con información concreta, no con suposiciones.",
        icon: "graph"
      }
    ]
  },
  {
    group: "Negocio Conectado",
    icon: "🟢",
    description: "Todo tu sistema funcionando como uno solo.",
    color: "from-green-500 to-emerald-600",
    items: [
      {
        title: "Información sincronizada",
        description: "Precios, stock, usuarios e informes conectados en tiempo real entre la casa central y las sucursales. Cada parte del negocio habla el mismo idioma.",
        icon: "chart"
      }
    ]
  }
];
---

<section id="benefits" class="py-24 relative bg-dark-800">
  <div class="absolute inset-0 z-0 opacity-20">
    <div class="absolute bottom-0 left-1/4 w-96 h-96 rounded-full bg-primary-600/30 blur-3xl"></div>
    <div class="absolute top-1/3 right-1/4 w-80 h-80 rounded-full bg-secondary-600/30 blur-3xl"></div>
  </div>

  <div class="container mx-auto px-4 z-10 relative">
    <div class="text-center mb-16 animate-on-scroll">
      <p class="text-primary/90 font-medium mb-3 tracking-[0.22em] uppercase text-xs">Qué mejora en la práctica</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-[-0.02em] mb-4">Beneficios reales para tu negocio</h2>
      <p class="text-gray-300 max-w-3xl mx-auto text-lg leading-8">Descubrí cómo ZinkERP puede transformar la gestión de tu empresa</p>
    </div>
    
    <div class="grid lg:grid-cols-3 gap-8">
      {benefits.map((group, groupIndex) => (
        <div class="group animate-on-scroll" style={{animationDelay: `${groupIndex * 0.2}s`}}>
          <div class={`bg-dark-800/95 rounded-[1.45rem] overflow-hidden border border-white/8 transition-all duration-300 hover:-translate-y-1 hover:bg-white/[0.015] hover:border-white/12`}>
            <div class={`h-2 bg-gradient-to-r ${group.color}`}></div>
            <div class="p-7">
              <div class="flex items-center gap-3 mb-4">
                <span class="text-2xl">{group.icon}</span>
                <h3 class="text-xl font-bold">{group.group}</h3>
              </div>
              <p class="text-gray-300 text-sm leading-7 mb-6">{group.description}</p>
              
              <div class="space-y-4">
                {group.items.map((benefit) => (
                  <div class="rounded-2xl bg-dark-700/45 p-4 md:p-5 transition-colors duration-300 group-hover:bg-dark-700/60">
                    <div class="flex items-start gap-4">
                      <div class="h-full w-px self-stretch rounded-full bg-gradient-to-b from-primary/55 via-primary/20 to-transparent"></div>
                      <div class="bg-dark-700/95 rounded-2xl p-2.5 transition-colors duration-300 group-hover:bg-primary/12 shadow-[inset_0_0_0_1px_rgba(255,255,255,0.05)]">
                        {benefit.icon === "money" && (
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" class="w-10 h-10 text-primary-100 transition-colors duration-300 group-hover:text-primary">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" />
                          </svg>
                        )}
                        {benefit.icon === "shopping" && (
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" class="w-10 h-10 text-primary-100 transition-colors duration-300 group-hover:text-primary">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
                          </svg>
                        )}
                        {benefit.icon === "clipboard" && (
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" class="w-10 h-10 text-primary-100 transition-colors duration-300 group-hover:text-primary">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" />
                          </svg>
                        )}
                        {benefit.icon === "lock" && (
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" class="w-10 h-10 text-primary-100 transition-colors duration-300 group-hover:text-primary">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                          </svg>
                        )}
                        {benefit.icon === "chart" && (
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" class="w-10 h-10 text-primary-100 transition-colors duration-300 group-hover:text-primary">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />
                          </svg>
                        )}
                        {benefit.icon === "graph" && (
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" class="w-10 h-10 text-primary-100 transition-colors duration-300 group-hover:text-primary">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                          </svg>
                        )}
                      </div>
                      <div class="pt-0.5">
                        <h4 class="font-semibold mb-1">{benefit.title}</h4>
                        <p class="text-gray-300 text-sm leading-6">{benefit.description}</p>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-16 animate-on-scroll">
      <p class="text-lg text-gray-300 mb-6 leading-8">
        Cada mejora impacta en tus costos, tu tiempo y tu cabeza.<br>
        Con ZinkERP ganás control sin perder agilidad.
      </p>
      <a href="/modulos" class="inline-block px-6 py-3.5 rounded-xl bg-blue-primary hover:bg-blue-primary/90 transition-colors text-center font-medium">
        Descubrí todas las funciones
      </a>
    </div>
  </div>
</section>
