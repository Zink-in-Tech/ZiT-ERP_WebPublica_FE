---
const docsUrl = "https://docs.zinkerp.com/";

const tools = [
  {
    title: "Caja Diaria",
    description: "Llevá el control de ingresos y egresos de tu negocio sin complicaciones.",
    icon: "💰",
    link: "/recursos/caja-diaria"
  },
  {
    title: "Precios Inteligentes",
    description: "Calculadora de precios por costo, margen deseado y percepción del cliente.",
    icon: "🏷️",
    link: "/recursos/precios-inteligentes"
  }
];

// Íconos Phosphor (bold), inline para evitar una petición a un tercero.
const iconPaths = {
  toolbox: 'M224 64h-44v-8a28 28 0 0 0-28-28h-48a28 28 0 0 0-28 28v8H32a20 20 0 0 0-20 20v108a20 20 0 0 0 20 20h192a20 20 0 0 0 20-20V84a20 20 0 0 0-20-20m-124-8a4 4 0 0 1 4-4h48a4 4 0 0 1 4 4v8h-56Zm120 32v32h-24v-4a12 12 0 0 0-24 0v4H84v-4a12 12 0 0 0-24 0v4H36V88ZM36 188v-44h24v4a12 12 0 0 0 24 0v-4h88v4a12 12 0 0 0 24 0v-4h24v44Z',
  arrowRight: 'm224.49 136.49l-72 72a12 12 0 0 1-17-17L187 140H40a12 12 0 0 1 0-24h147l-51.49-51.52a12 12 0 0 1 17-17l72 72a12 12 0 0 1-.02 17.01',
  headset: 'M204.73 51.85A108.07 108.07 0 0 0 20 128v56a28 28 0 0 0 28 28h16a28 28 0 0 0 28-28v-40a28 28 0 0 0-28-28H44.84A84.05 84.05 0 0 1 128 44h.64a83.7 83.7 0 0 1 82.52 72H192a28 28 0 0 0-28 28v40a28 28 0 0 0 28 28h19.6a20 20 0 0 1-19.6 16h-56a12 12 0 0 0 0 24h56a44.05 44.05 0 0 0 44-44v-80a107.34 107.34 0 0 0-31.27-76.15M64 140a4 4 0 0 1 4 4v40a4 4 0 0 1-4 4H48a4 4 0 0 1-4-4v-44Zm124 44v-40a4 4 0 0 1 4-4h20v48h-20a4 4 0 0 1-4-4',
  graduationCap: 'm249.8 85.49l-116-64a12 12 0 0 0-11.6 0l-116 64a12 12 0 0 0 0 21l21.8 12v47.76a19.9 19.9 0 0 0 5.09 13.32C46.63 194.7 77 220 128 220a136.9 136.9 0 0 0 40-5.75V240a12 12 0 0 0 24 0v-35.88a119.5 119.5 0 0 0 30.91-24.51a19.9 19.9 0 0 0 5.09-13.32v-47.76l21.8-12a12 12 0 0 0 0-21ZM128 45.71L219.16 96L186 114.3a2 2 0 0 1-.18-.12l-52-28.69a12 12 0 0 0-11.6 21l39 21.49L128 146.3L36.84 96ZM128 196c-40.42 0-64.65-19.07-76-31.27v-33l70.2 38.74a12 12 0 0 0 11.6 0l34.2-18.83v37.23a110.5 110.5 0 0 1-40 7.13m76-31.27a93 93 0 0 1-12 10.81v-37.15l12-6.62Z',
};
---

<section class="py-20 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-primary/20 to-dark-900/95"></div>
  
  {/* Decorative elements - hidden on mobile */}
  <div class="hidden md:block absolute inset-0">
    <div class="absolute top-0 left-1/4 w-96 h-96 rounded-full bg-primary/20 blur-3xl animate-pulse"></div>
    <div class="absolute bottom-0 right-1/4 w-80 h-80 rounded-full bg-primary/10 blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16 animate-on-scroll">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">
          Crecé con nosotros. No estás solo.
        </h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          En ZinkERP creemos que ayudar a crecer a una pyme es mucho más que ofrecerle un buen sistema.
          Te acompañamos con capacitación y soporte humano, siempre que lo necesites.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {/* Recursos gratuitos */}
        <div class="bg-dark-800/50 backdrop-blur rounded-xl p-8 border border-primary/20 hover:border-primary/40 transition-all duration-300 group animate-on-scroll">
          <div class="bg-primary/10 w-16 h-16 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            <svg viewBox="0 0 256 256" class="w-8 h-8 text-primary" aria-hidden="true"><path fill="currentColor" d={iconPaths.toolbox} /></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Recursos gratuitos para tu negocio</h3>
          <ul class="space-y-4 mb-6 text-gray-300">
            {tools.map(tool => (
              <li class="flex items-center gap-3 bg-dark-700/50 p-4 rounded-lg hover:bg-dark-700 transition-colors">
                <span class="text-2xl">{tool.icon}</span>
                <span>{tool.title}</span>
              </li>
            ))}
          </ul>
          <a href="/recursos" class="inline-flex items-center gap-2 text-primary hover:text-primary-light transition-colors">
            Ver todas las herramientas
            <svg viewBox="0 0 256 256" class="w-4 h-4 group-hover:translate-x-1 transition-transform text-primary" aria-hidden="true"><path fill="currentColor" d={iconPaths.arrowRight} /></svg>
          </a>
        </div>

        {/* Support */}
        <div class="bg-dark-800/50 backdrop-blur rounded-xl p-8 border border-primary/20 hover:border-primary/40 transition-all duration-300 group animate-on-scroll" style="animation-delay: 0.1s;">
          <div class="bg-primary/10 w-16 h-16 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            <svg viewBox="0 0 256 256" class="w-8 h-8 text-primary" aria-hidden="true"><path fill="currentColor" d={iconPaths.headset} /></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Soporte local 24x7</h3>
          <ul class="space-y-4 mb-6 text-gray-300">
            <li class="flex items-center gap-3 bg-dark-700/50 p-4 rounded-lg hover:bg-dark-700 transition-colors">
              <span class="text-primary">•</span>
              Atención humana en tu idioma
            </li>
            <li class="flex items-center gap-3 bg-dark-700/50 p-4 rounded-lg hover:bg-dark-700 transition-colors">
              <span class="text-primary">•</span>
              WhatsApp, teléfono y email
            </li>
            <li class="flex items-center gap-3 bg-dark-700/50 p-4 rounded-lg hover:bg-dark-700 transition-colors">
              <span class="text-primary">•</span>
              Sin bots ni tickets eternos
            </li>
            <li class="flex items-center gap-3 bg-dark-700/50 p-4 rounded-lg hover:bg-dark-700 transition-colors">
              <span class="text-primary">•</span>
              Base de conocimiento con guías paso a paso
            </li>
          </ul>
          <a href={docsUrl} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 text-primary hover:text-primary-light transition-colors">
            Ir a documentación y soporte
            <svg viewBox="0 0 256 256" class="w-4 h-4 group-hover:translate-x-1 transition-transform text-primary" aria-hidden="true"><path fill="currentColor" d={iconPaths.arrowRight} /></svg>
          </a>
        </div>

        {/* Learning */}
        <div class="bg-dark-800/50 backdrop-blur rounded-xl p-8 border border-primary/20 hover:border-primary/40 transition-all duration-300 group animate-on-scroll" style="animation-delay: 0.2s;">
          <div class="bg-primary/10 w-16 h-16 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            <svg viewBox="0 0 256 256" class="w-8 h-8 text-primary" aria-hidden="true"><path fill="currentColor" d={iconPaths.graduationCap} /></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Aprendizaje y comunidad</h3>
          <ul class="space-y-4 mb-6 text-gray-300">
            <li class="flex items-center gap-3 bg-dark-700/50 p-4 rounded-lg hover:bg-dark-700 transition-colors">
              <span class="text-primary">•</span>
              Acceso a contenido educativo
            </li>
            <li class="flex items-center gap-3 bg-dark-700/50 p-4 rounded-lg hover:bg-dark-700 transition-colors">
              <span class="text-primary">•</span>
              Videos tutoriales
            </li>
            <li class="flex items-center gap-3 bg-dark-700/50 p-4 rounded-lg hover:bg-dark-700 transition-colors">
              <span class="text-primary">•</span>
              Eventos virtuales y workshops
            </li>
          </ul>
          <a href="https://zinkerp.beehiiv.com/" class="inline-flex items-center gap-2 text-primary hover:text-primary-light transition-colors">
            Suscribite al newsletter
            <svg viewBox="0 0 256 256" class="w-4 h-4 group-hover:translate-x-1 transition-transform text-primary" aria-hidden="true"><path fill="currentColor" d={iconPaths.arrowRight} /></svg>
          </a>
        </div>
      </div>

      <div class="mt-16 text-center animate-on-scroll">
        <h3 class="text-2xl font-bold mb-4">¿Querés empezar a mejorar tu negocio hoy?</h3>
        <p class="text-gray-300 mb-8">
          Suscribite a nuestro newsletter y recibí tips, guías y novedades para hacer crecer tu negocio.
        </p>
        <div class="max-w-xl mx-auto bg-dark-800/50 backdrop-blur p-6 rounded-xl border border-primary/20">
          <iframe 
            src="https://embeds.beehiiv.com/a98f31c0-4464-430b-885d-da8c41eab6f5?slim=true" 
            data-test-id="beehiiv-embed" 
            height="52" 
            frameborder="0" 
            scrolling="no" 
            style="margin: 0; border-radius: 0px !important; background-color: transparent; width: 100%;"
            title="Formulario de suscripción al newsletter"
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
