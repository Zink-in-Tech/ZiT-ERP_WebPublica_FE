---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

type ToolIcon = 'cash' | 'calculator' | 'barcode' | 'tag' | 'ticket' | 'trending';

const availableTools: {
  title: string;
  description: string;
  features: string[];
  link: string;
  icon: ToolIcon;
}[] = [
  {
    title: "Caja Diaria",
    description: "Llevá ingresos y egresos del día en el navegador, sin registro ni instalación.",
    features: ["Ingresos y egresos", "Saldos automáticos", "Exportar datos"],
    link: "/recursos/caja-diaria",
    icon: "cash"
  },
  {
    title: "Precios Inteligentes",
    description: "Armá precios con markup o margen, impuestos y hasta 6 listas por producto.",
    features: ["Markup o margen", "Hasta 6 listas", "Exportá CSV"],
    link: "/recursos/precios-inteligentes",
    icon: "calculator"
  },
  {
    title: "Códigos de barras",
    description: "Generá EAN13 uno a uno o por CSV y descargá un PDF listo para imprimir.",
    features: ["EAN13 retail", "Importar CSV", "PDF imprimible"],
    link: "/recursos/codigos-de-barras",
    icon: "barcode"
  },
  {
    title: "Etiquetas góndola",
    description: "Pasá tu lista de productos a etiquetas A4 con descripción, precio y código.",
    features: ["Desde Excel/CSV", "Formato profesional", "PDF A4"],
    link: "/recursos/etiquetas-gondola",
    icon: "tag"
  },
  {
    title: "Ticket promedio",
    description: "Sabé cuánto sale en promedio cada venta y compará un período contra el anterior.",
    features: ["Cálculo rápido", "Lista o CSV", "Compará períodos"],
    link: "/recursos/ticket-promedio",
    icon: "ticket"
  }
];

const upcomingTools: {
  title: string;
  description: string;
  features: string[];
  icon: ToolIcon;
}[] = [
  {
    title: "Impacto de la venta sugerida",
    description: "Simulá cuánto sube tu ticket si más clientes llevan un producto extra.",
    features: ["Ticket actual", "% de adopción", "Incremento %"],
    icon: "trending"
  }
];

const arrowPath =
  "M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z";
---

<Layout title="Recursos y Herramientas Gratuitas | ZinkERP">
  <Header />
  <main>
    {/* Hero Section */}
    <section class="pt-32 pb-16 relative">
      <div class="absolute inset-0 z-0 opacity-20">
        <div class="absolute top-1/4 right-1/4 w-96 h-96 rounded-full bg-primary-600/30 blur-3xl"></div>
        <div class="absolute bottom-1/3 left-1/3 w-80 h-80 rounded-full bg-primary-600/30 blur-3xl"></div>
      </div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl font-bold mb-6 animate-on-scroll">
            Herramientas gratuitas para tu negocio
          </h1>
          <p class="text-xl text-gray-300 mb-4 animate-on-scroll" style="animation-delay: 0.1s;">
            Recursos prácticos y fáciles de usar para ayudarte a gestionar mejor tu empresa.
            <br>
            Sin registros, sin instalaciones, todo online.
          </p>
        </div>
      </div>
    </section>

    {/* Available Tools — compact feature grid */}
    <section class="pb-20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold mb-8">Herramientas disponibles</h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {availableTools.map((tool, index) => {
              const isLastOdd = index === availableTools.length - 1 && availableTools.length % 2 === 1;
              return (
              <a
                href={tool.link}
                class:list={[
                  "bg-dark-800 rounded-xl p-5 sm:p-6 border border-dark-700 hover:border-primary/50 hover:ring-1 hover:ring-primary/30 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-dark-900 transition-all duration-200 group h-full cursor-pointer",
                  isLastOdd
                    ? "md:col-span-2 md:flex md:items-center md:gap-6"
                    : "flex flex-col"
                ]}
              >
                <div class:list={[
                  "flex items-start gap-4",
                  isLastOdd ? "md:flex-1 md:min-w-0 mb-0" : "mb-3"
                ]}>
                  <div class="w-11 h-11 shrink-0 bg-primary/10 rounded-xl flex items-center justify-center text-primary transition-transform duration-200 group-hover:scale-105" aria-hidden="true">
                    {tool.icon === 'cash' && (
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" />
                      </svg>
                    )}
                    {tool.icon === 'calculator' && (
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25V15.75zm0 2.25h.008v.008H8.25V18zm2.25-4.5h.008v.008H10.5v-.008zm0 2.25h.008v.008H10.5V15.75zm0 2.25h.008v.008H10.5V18zm2.25-4.5h.008v.008H12.75v-.008zm0 2.25h.008v.008H12.75V15.75zm0 2.25h.008v.008H12.75V18zm2.25-4.5h.008v.008H15v-.008zm0 2.25h.008v.008H15V15.75zm0 2.25h.008v.008H15V18zm2.25-4.5h.008v.008H17.25v-.008zm0 2.25h.008v.008H17.25V15.75zm0 2.25h.008v.008H17.25V18zM6 21h12a2.25 2.25 0 002.25-2.25V5.25A2.25 2.25 0 0018 3H6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 006 21z" />
                      </svg>
                    )}
                    {tool.icon === 'barcode' && (
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 5.25v13.5M6.75 5.25v13.5M8.25 5.25v13.5M12 5.25v13.5M13.5 5.25v13.5M16.5 5.25v13.5M18 5.25v13.5M20.25 5.25v13.5" />
                      </svg>
                    )}
                    {tool.icon === 'tag' && (
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z" />
                      </svg>
                    )}
                    {tool.icon === 'ticket' && (
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z" />
                      </svg>
                    )}
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center justify-between gap-3">
                      <h3 class="text-lg font-bold leading-snug group-hover:text-primary transition-colors">
                        {tool.title}
                      </h3>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class:list={[
                        "w-5 h-5 text-gray-400 group-hover:text-primary group-hover:translate-x-0.5 shrink-0 transition-all duration-200",
                        isLastOdd && "md:hidden"
                      ]} aria-hidden="true">
                        <path fill-rule="evenodd" d={arrowPath} clip-rule="evenodd" />
                      </svg>
                    </div>
                    <p class="text-gray-400 text-sm mt-1.5 leading-relaxed line-clamp-2">{tool.description}</p>
                  </div>
                </div>

                <ul class:list={[
                  "flex flex-wrap gap-2",
                  isLastOdd ? "mt-3 md:mt-0 md:shrink-0" : "mt-auto pt-3"
                ]}>
                  {tool.features.map(feature => (
                    <li class="px-2.5 py-1 rounded-md bg-dark-700/80 border border-dark-600/80 text-xs text-gray-300">
                      {feature}
                    </li>
                  ))}
                </ul>

                {isLastOdd && (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="hidden md:block w-6 h-6 text-gray-400 group-hover:text-primary group-hover:translate-x-0.5 shrink-0 transition-all duration-200 ml-auto" aria-hidden="true">
                    <path fill-rule="evenodd" d={arrowPath} clip-rule="evenodd" />
                  </svg>
                )}
              </a>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    {/* Upcoming Tools — same grid, muted */}
    {upcomingTools.length > 0 && (
      <section class="py-16 bg-dark-800/60 border-t border-dark-700">
        <div class="container mx-auto px-4">
          <div class="max-w-5xl mx-auto">
            <h2 class="text-2xl md:text-3xl font-bold mb-8">Próximamente</h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              {upcomingTools.map(tool => (
                <article class="flex flex-col bg-dark-900/40 rounded-xl p-5 sm:p-6 border border-dark-600/80 h-full opacity-90">
                  <div class="flex items-start gap-4 mb-3">
                    <div class="w-11 h-11 shrink-0 bg-dark-700 rounded-xl flex items-center justify-center text-gray-400" aria-hidden="true">
                      {tool.icon === 'trending' && (
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" />
                        </svg>
                      )}
                    </div>
                    <div class="min-w-0">
                      <div class="flex flex-wrap items-center gap-2 mb-1">
                        <h3 class="text-lg font-bold leading-snug">{tool.title}</h3>
                        <span class="px-2.5 py-0.5 bg-primary/15 text-primary text-xs font-medium rounded-full">
                          Próximamente
                        </span>
                      </div>
                      <p class="text-gray-400 text-sm leading-relaxed line-clamp-2">{tool.description}</p>
                    </div>
                  </div>

                  <ul class="flex flex-wrap gap-2 mt-auto pt-3">
                    {tool.features.map(feature => (
                      <li class="px-2.5 py-1 rounded-md bg-dark-800/80 border border-dark-600/60 text-xs text-gray-400">
                        {feature}
                      </li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    {/* Newsletter Section */}
    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="text-3xl font-bold mb-4">¿Querés recibir más herramientas?</h2>
          <p class="text-gray-300 mb-8">
            Suscribite a nuestro newsletter y sé el primero en probar las nuevas herramientas que lanzamos.
          </p>
          <iframe
            src="https://embeds.beehiiv.com/a98f31c0-4464-430b-885d-da8c41eab6f5?slim=true"
            data-test-id="beehiiv-embed"
            height="52"
            title="Formulario de suscripción al newsletter"
            style="margin: 0; border: none; border-radius: 0; background-color: transparent; width: 100%;"
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
