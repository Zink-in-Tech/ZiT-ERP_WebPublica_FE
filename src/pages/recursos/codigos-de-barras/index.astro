---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
const PAGE_TITLE = 'Generador de Códigos de Barras EAN13 Gratis | Crear e Imprimir | ZinkERP';
const META_DESC = 'Generá códigos de barras EAN13 gratis y online. Creá uno a uno o importá un CSV, descargá el PDF listo para imprimir. Herramienta gratuita para comercios. Sin registro.';
const WHATSAPP_CTA_NUMBER = '5491135598389';
---

<Layout title={PAGE_TITLE} description={META_DESC}>
  <Header />
  <main>
    {/* Hero Section (mismo patrón que Caja Diaria) */}
    <section class="pt-32 pb-32 relative">
      <div class="absolute inset-0 z-0 opacity-20">
        <div class="absolute top-1/4 right-1/4 w-96 h-96 rounded-full bg-primary-600/30 blur-3xl"></div>
        <div class="absolute bottom-1/3 left-1/3 w-80 h-80 rounded-full bg-primary-600/30 blur-3xl"></div>
      </div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="grid md:grid-cols-2 gap-12 items-center max-w-6xl mx-auto">
          <div>
            <h1 class="text-4xl md:text-5xl font-bold mb-6 animate-on-scroll">
              Generador de códigos de barras EAN13 gratis y online
            </h1>
            <p class="text-xl text-gray-300 mb-8 animate-on-scroll" style="animation-delay: 0.1s;">
              Creá códigos de barras EAN13 uno a uno o importando un CSV. Descargá un PDF listo para imprimir en etiquetas. Sin registros, sin instalaciones, todo en tu navegador.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a
                href="#herramienta"
                class="inline-block px-6 py-3 bg-blue-primary hover:bg-blue-primary/90 rounded-lg font-medium transition-colors animate-on-scroll text-center"
                style="animation-delay: 0.2s;"
              >
                Generar códigos de barras
              </a>
              <a
                href="#newsletter"
                class="inline-block px-6 py-3 border border-blue-primary text-blue-primary hover:bg-blue-primary/10 rounded-lg font-medium transition-colors animate-on-scroll text-center"
                style="animation-delay: 0.3s;"
              >
                50% OFF en Plan Emprendedor
              </a>
            </div>
          </div>

          <div id="newsletter" class="bg-dark-800 p-8 rounded-xl border border-dark-700 animate-on-scroll" style="animation-delay: 0.3s;">
            <h2 class="text-2xl font-bold mb-6">
              Unite gratis a la comunidad y recibí más herramientas gratis para tu negocio
            </h2>
            <p class="text-gray-300 mb-8">
              Además de recursos para mejorar en todo sentido.
            </p>
            <iframe
              src="https://embeds.beehiiv.com/a98f31c0-4464-430b-885d-da8c41eab6f5?slim=true"
              data-test-id="beehiiv-embed"
              height="52"
              frameborder="0"
              scrolling="no"
              style="margin: 0; border-radius: 0px !important; background-color: transparent; width: 100%;"
              title="Formulario de suscripción al newsletter"
              loading="lazy"
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    {/* Cómo funciona */}
    <section class="py-12 border-y border-dark-700">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold mb-8 text-center">Cómo funciona</h2>
          <div class="grid md:grid-cols-3 gap-8 md:gap-4">
            <div class="flex flex-col items-center text-center group">
              <span class="flex h-20 w-20 items-center justify-center rounded-full bg-primary/25 text-primary font-bold text-3xl mb-4 ring-2 ring-primary/30 shadow-xl transition-transform duration-300 group-hover:scale-110">1</span>
              <p class="text-gray-300 font-medium">Ingresá tus códigos (uno a uno o subiendo un CSV con columnas codigo y descripcion)</p>
            </div>
            <div class="flex flex-col items-center text-center group">
              <span class="flex h-20 w-20 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 font-bold text-3xl mb-4 ring-2 ring-emerald-500/30 shadow-xl transition-transform duration-300 group-hover:scale-110">2</span>
              <p class="text-gray-300 font-medium">Revisá la lista y quitá lo que no quieras incluir</p>
            </div>
            <div class="flex flex-col items-center text-center group">
              <span class="flex h-20 w-20 items-center justify-center rounded-full bg-amber-500/20 text-amber-400 font-bold text-3xl mb-4 ring-2 ring-amber-500/30 shadow-xl transition-transform duration-300 group-hover:scale-110">3</span>
              <p class="text-gray-300 font-medium">Descargá el PDF con todas las etiquetas listas para imprimir</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Herramienta */}
    <section id="herramienta" class="pb-20" data-whatsapp-cta={WHATSAPP_CTA_NUMBER}>
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-2xl font-bold mb-2">Crear códigos de barras</h2>
          <p class="text-gray-400 text-sm mb-6">Agregá códigos EAN13 uno a uno o importá un CSV. Máximo 50 etiquetas por PDF.</p>

          {/* Uno a uno */}
          <div class="bg-dark-800 rounded-xl p-6 border border-dark-700 mb-6">
            <h3 class="text-lg font-bold mb-4">Agregar uno a uno</h3>
            <div class="flex flex-wrap gap-4 items-end">
              <div class="flex-1 min-w-[180px]">
                <label for="codigoEan" class="block text-sm font-medium text-gray-400 mb-1">Código EAN13 (13 dígitos)</label>
                <div class="flex gap-2 h-10 items-stretch">
                  <input type="text" id="codigoEan" inputmode="numeric" pattern="[0-9]*" maxlength="13" placeholder="Ej. 7790123456789" class="flex-1 min-h-0 h-10 px-3 py-2 bg-dark-700 border border-dark-600 rounded-lg text-sm focus:ring-2 focus:ring-primary box-border" />
                  <button type="button" id="btnGenerarCodigo" class="shrink-0 w-10 h-10 flex items-center justify-center border border-dark-600 hover:border-primary/50 rounded-lg text-sm transition-colors" title="Generar código EAN13">✨</button>
                </div>
              </div>
              <div class="flex-1 min-w-[180px]">
                <label for="descripcion" class="block text-sm font-medium text-gray-400 mb-1">Descripción del producto (opcional)</label>
                <input type="text" id="descripcion" placeholder="Ej. Gaseosa 1.5L" class="w-full h-10 px-3 py-2 bg-dark-700 border border-dark-600 rounded-lg text-sm focus:ring-2 focus:ring-primary box-border" />
              </div>
              <button type="button" id="btnAgregar" class="h-10 px-4 py-2 bg-blue-primary hover:bg-blue-primary/90 rounded-lg font-medium text-sm shrink-0">Agregar a la lista</button>
            </div>
            <p class="text-xs text-gray-500 mt-1">Debe ser un EAN13 válido (dígito verificador correcto)</p>
            <p id="msgUnoAUno" class="text-sm mt-2 hidden"></p>
          </div>

          {/* CSV */}
          <div class="bg-dark-800 rounded-xl p-6 border border-dark-700 mb-6">
            <h3 class="text-lg font-bold mb-2">Importar desde CSV</h3>
            <p class="text-gray-400 text-sm mb-3">Columnas esperadas: <strong>codigo</strong> (o codigo_barras), <strong>descripcion</strong> (opcional). Separador punto y coma (;) recomendado.</p>
            <div class="flex flex-wrap items-center gap-3">
              <input type="file" id="inputCsv" accept=".csv" class="hidden" />
              <button type="button" id="btnElegirCsv" class="px-4 py-2 border border-dark-600 hover:border-primary/50 rounded-lg font-medium text-sm transition-colors">Elegir archivo</button>
              <span class="text-gray-500 text-sm">o arrastrá un CSV aquí</span>
              <a href="#" id="linkPlantillaCsv" class="text-primary hover:underline text-sm">Descargar plantilla CSV</a>
            </div>
            <div id="zonaDropCsv" class="mt-3 p-6 border-2 border-dashed border-dark-600 rounded-lg text-center text-gray-500 text-sm hover:border-primary/30 transition-colors">Arrastrá tu archivo CSV aquí</div>
            <p id="msgCsv" class="text-sm mt-2 hidden"></p>
          </div>

          {/* Tabla preview */}
          <div class="bg-dark-800 rounded-xl p-6 border border-dark-700 mb-6">
            <div class="flex items-center justify-between flex-wrap gap-2 mb-4">
              <h3 class="text-lg font-bold">Lista de códigos</h3>
              <p id="previewCount" class="text-sm text-gray-500"></p>
            </div>
            <div class="overflow-x-auto max-h-[400px] overflow-y-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-dark-600 text-left">
                    <th class="py-3 pr-2">Código</th>
                    <th class="py-3 px-2">Descripción</th>
                    <th class="py-3 pl-2 w-20"></th>
                  </tr>
                </thead>
                <tbody id="tbodyLista"></tbody>
              </table>
            </div>
            <p id="listaVacia" class="py-6 text-center text-gray-500">Aún no hay códigos. Agregá uno desde el formulario o importá un CSV.</p>
            <p id="listaOculta" class="text-sm text-gray-400 mt-2 hidden">Mostrando los primeros 15 de <span id="totalItems">0</span> ítems.</p>
          </div>

          {/* Disclaimer */}
          <div class="rounded-xl p-4 mb-6 border border-amber-500/40 bg-amber-500/10 text-amber-200/90 text-sm">
            <p class="font-medium mb-1">Aviso importante</p>
            <p>No somos responsables del uso que se le dé a los códigos generados. Esta herramienta no asigna códigos oficiales GS1 ni garantiza unicidad global. El usuario es responsable de asegurar que los códigos cumplan con las normativas aplicables (EAN, GS1, etc.) y de su uso conforme a la ley.</p>
          </div>

          {/* Acciones */}
          <div class="flex flex-wrap items-center gap-4">
            <button type="button" id="btnDescargarPdf" class="px-6 py-3 bg-blue-primary hover:bg-blue-primary/90 rounded-lg font-medium transition-colors">Descargar PDF</button>
            <button type="button" id="btnLimpiar" class="px-4 py-2 border border-dark-600 hover:border-primary/50 rounded-lg font-medium text-sm transition-colors">Limpiar lista</button>
          </div>
          <p id="msgPdf" class="text-sm mt-2 hidden"></p>
        </div>
      </div>
    </section>

    {/* Modal post-descarga CTA WhatsApp */}
    <div id="postDownloadModal" class="fixed inset-0 z-[100] hidden" aria-modal="true" aria-labelledby="postDownloadTitle" role="dialog">
      <div class="absolute inset-0 bg-black/70 backdrop-blur-md" id="postDownloadOverlay"></div>
      <div class="absolute inset-0 flex items-center justify-center p-4">
        <div class="bg-dark-800 rounded-2xl p-8 max-w-md w-full border border-dark-600 shadow-2xl">
          <div class="flex justify-center mb-4">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-green-500/20 text-green-400" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-6 h-6">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
              </svg>
            </span>
          </div>
          <h3 id="postDownloadTitle" class="text-xl font-bold text-center mb-2">Estamos preparando tu archivo</h3>
          <p class="text-gray-300 text-center text-sm leading-relaxed mb-1">Mientras se descarga, ¿querés que te ayudemos a ordenar códigos, etiquetas y stock?</p>
          <p class="text-gray-400 text-center text-sm leading-relaxed mb-6">Te podemos abrir WhatsApp con un mensaje listo para enviar.</p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a id="whatsappCtaBtn" href="#" target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center gap-2 px-5 py-3 bg-green-600 hover:bg-green-500 rounded-xl font-medium transition-colors shrink-0">Abrir WhatsApp</a>
            <button type="button" id="postDownloadClose" class="px-5 py-3 text-gray-300 border border-dark-500 hover:bg-dark-700 rounded-xl transition-colors">Ahora no</button>
          </div>
          <div class="mt-6 rounded-xl border border-dark-600 bg-dark-900/60 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1">También te puede servir</p>
            <p class="text-sm font-medium text-white mb-1">Etiquetas de góndola</p>
            <p class="text-xs text-gray-400 mb-3">Usá tus códigos para imprimir etiquetas listas para pegar.</p>
            <a href="/recursos/etiquetas-gondola" class="text-sm font-medium text-blue-primary hover:text-blue-primary/80 transition-colors">Crear etiquetas</a>
          </div>
        </div>
      </div>
    </div>

    {/* CTA ZinkERP */}
    <section class="py-20 bg-dark-800">
      <div class="container mx-auto px-4">
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="text-2xl font-bold mb-4">¿Necesitás gestionar códigos de barras en tu negocio?</h2>
          <p class="text-gray-300 mb-6">En ZinkERP podés asignar códigos a tus productos, imprimir etiquetas y sincronizar con facturación y stock.</p>
          <a href="https://zinkerp.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-primary hover:bg-blue-primary/90 rounded-lg font-medium transition-colors">Conocer ZinkERP</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    import '../../../scripts/codigos-de-barras-app';
  </script>
</Layout>
