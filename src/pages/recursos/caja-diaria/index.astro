---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
---

<Layout title="Caja Diaria | Herramienta gratuita para control de caja">
  <Header />
  <main>
    {/* Hero Section */}
    <section class="pt-32 pb-32 relative">
      <div class="absolute inset-0 z-0 opacity-20">
        <div class="absolute top-1/4 right-1/4 w-96 h-96 rounded-full bg-primary-600/30 blur-3xl"></div>
        <div class="absolute bottom-1/3 left-1/3 w-80 h-80 rounded-full bg-primary-600/30 blur-3xl"></div>
      </div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="grid md:grid-cols-2 gap-12 items-center max-w-6xl mx-auto">
          <div>
            <h1 class="text-4xl md:text-5xl font-bold mb-6 animate-on-scroll">
              Controlá tu Caja Diaria gratis y online
            </h1>
            <p class="text-xl text-gray-300 mb-8 animate-on-scroll" style="animation-delay: 0.1s;">
              Llevá el control de ingresos y egresos de tu negocio sin complicaciones. Sin registros, sin instalaciones, todo en tu navegador.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a 
                href="#herramienta"
                class="inline-block px-6 py-3 bg-blue-primary hover:bg-blue-primary/90 rounded-lg font-medium transition-colors animate-on-scroll text-center"
                style="animation-delay: 0.2s;"
              >
                Comenzar ahora
              </a>
              <a 
                href="#cta"
                class="inline-block px-6 py-3 border border-blue-primary text-blue-primary hover:bg-blue-primary/10 rounded-lg font-medium transition-colors animate-on-scroll text-center"
                style="animation-delay: 0.3s;"
              >
                50% OFF en Plan Emprendedor
              </a>
            </div>
          </div>

          <div class="bg-dark-800 p-8 rounded-xl border border-dark-700 animate-on-scroll" style="animation-delay: 0.3s;">
            <h2 class="text-2xl font-bold mb-6">
              Unite gratis a la comunidad y recibí más herramientas gratis para tu negocio
            </h2>
            <p class="text-gray-300 mb-8">
              Además de recursos para mejorar en todo sentido.
            </p>
            <iframe 
              src="https://embeds.beehiiv.com/a98f31c0-4464-430b-885d-da8c41eab6f5?slim=true" 
              data-test-id="beehiiv-embed" 
              height="52" 
              frameborder="0" 
              scrolling="no" 
              style="margin: 0; border-radius: 0px !important; background-color: transparent; width: 100%;"
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    {/* Main Tool Section */}
    <section id="herramienta" class="pb-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold mb-8">Herramienta para el control de Caja Diaria</h2>
          
          <div class="bg-dark-800 rounded-xl p-8">
            {/* Resumen */}
            <div class="grid md:grid-cols-4 gap-6 mb-8">
              <div class="bg-dark-700 p-6 rounded-xl border border-dark-600">
                <h3 class="text-sm font-medium text-gray-300 mb-2">Ingresos Totales</h3>
                <p id="totalIncome" class="text-xl font-bold text-green-500">$0,00</p>
              </div>
              
              <div class="bg-dark-700 p-6 rounded-xl border border-dark-600">
                <h3 class="text-sm font-medium text-gray-300 mb-2">Egresos Totales</h3>
                <p id="totalExpenses" class="text-xl font-bold text-red-500">$0,00</p>
              </div>
              
              <div class="bg-dark-700 p-6 rounded-xl border border-dark-600">
                <h3 class="text-sm font-medium text-gray-300 mb-2">Saldo Actual</h3>
                <p id="currentBalance" class="text-xl font-bold text-primary">$0,00</p>
              </div>

              <div class="bg-dark-700 p-6 rounded-xl border border-dark-600">
                <h3 class="text-sm font-medium text-gray-300 mb-2">Ticket Promedio</h3>
                <p id="averageTicket" class="text-xl font-bold text-blue-400">$0,00</p>
              </div>
            </div>

            {/* Botones de Acción Rápida */}
            <div class="grid grid-cols-2 gap-4 mb-8">
              <button 
                id="quickIncomeBtn"
                class="p-6 bg-green-500 hover:bg-green-600 rounded-xl font-medium transition-all duration-300 flex flex-col items-center gap-2 group"
              >
                <span class="text-2xl group-hover:scale-110 transition-transform">💰</span>
                Registrar Ingreso
              </button>
              
              <button 
                id="quickExpenseBtn"
                class="p-6 bg-red-500 hover:bg-red-600 rounded-xl font-medium transition-all duration-300 flex flex-col items-center gap-2 group"
              >
                <span class="text-2xl group-hover:scale-110 transition-transform">📤</span>
                Registrar Egreso
              </button>
            </div>

            {/* Formulario Modal */}
            <div id="movementModal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50">
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md">
                <div class="bg-dark-800 rounded-xl p-6 shadow-xl border border-dark-600">
                  <h2 class="text-xl font-bold mb-6" id="modalTitle">Registrar Movimiento</h2>
                  
                  <form id="movementForm">
                    <input type="hidden" id="type" value="ingreso" />
                    
                    <div class="mb-4">
                      <label class="block text-sm font-medium text-gray-300 mb-2">Monto</label>
                      <input 
                        type="number" 
                        id="amount" 
                        min="1"
                        step="0.01"
                        required
                        class="w-full px-4 py-3 bg-dark-700 border border-dark-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary text-lg"
                      />
                    </div>

                    <div class="mb-6">
                      <label class="block text-sm font-medium text-gray-300 mb-2">Descripción</label>
                      <input 
                        type="text" 
                        id="description"
                        class="w-full px-4 py-3 bg-dark-700 border border-dark-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary"
                        placeholder="Opcional"
                      />
                    </div>

                    <div class="flex gap-4">
                      <button 
                        type="submit"
                        class="flex-1 py-3 bg-primary hover:bg-primary-dark rounded-lg font-medium transition-colors"
                      >
                        Registrar
                      </button>
                      
                      <button 
                        type="button"
                        id="cancelButton"
                        class="flex-1 py-3 bg-dark-700 hover:bg-dark-600 rounded-lg font-medium transition-colors"
                      >
                        Cancelar
                      </button>
                    </div>
                  </form>
                </div>
              </div>
            </div>

            {/* Gráficos */}
            <div class="grid md:grid-cols-2 gap-6 mb-8">
              <div class="bg-dark-700 p-6 rounded-xl border border-dark-600">
                <h3 class="text-sm font-medium text-gray-300 mb-4">Ingresos vs Egresos</h3>
                <canvas id="barChart" class="w-full"></canvas>
              </div>
              
              <div class="bg-dark-700 p-6 rounded-xl border border-dark-600">
                <h3 class="text-sm font-medium text-gray-300 mb-4">Evolución del Saldo</h3>
                <canvas id="lineChart" class="w-full"></canvas>
              </div>
            </div>

            {/* Lista de Movimientos */}
            <div class="bg-dark-700 rounded-xl overflow-hidden border border-dark-600">
              <div class="p-4 border-b border-dark-600 flex items-center justify-between">
                <h3 class="font-medium">Movimientos del Día</h3>
                
                <div class="flex gap-2">
                  <button 
                    id="exportButton"
                    class="px-4 py-2 bg-dark-600 hover:bg-dark-500 rounded-lg text-sm font-medium transition-colors flex items-center gap-2"
                  >
                    <span>Exportar</span>
                  </button>
                  
                  <button 
                    id="printButton"
                    class="px-4 py-2 bg-dark-600 hover:bg-dark-500 rounded-lg text-sm font-medium transition-colors flex items-center gap-2"
                  >
                    <span>Imprimir</span>
                  </button>
                  
                  <button 
                    id="resetButton"
                    class="px-4 py-2 bg-red-500 hover:bg-red-600 rounded-lg text-sm font-medium transition-colors flex items-center gap-2"
                  >
                    <span>Reiniciar</span>
                  </button>
                </div>
              </div>
              
              <div class="overflow-x-auto">
                <table class="w-full">
                  <thead class="bg-dark-600">
                    <tr>
                      <th class="px-4 py-3 text-left text-sm font-medium text-gray-300">Hora</th>
                      <th class="px-4 py-3 text-left text-sm font-medium text-gray-300">Tipo</th>
                      <th class="px-4 py-3 text-left text-sm font-medium text-gray-300">Descripción</th>
                      <th class="px-4 py-3 text-right text-sm font-medium text-gray-300">Monto</th>
                    </tr>
                  </thead>
                  <tbody id="movementsList">
                    {/* Los movimientos se agregarán aquí dinámicamente */}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* SEO Content Section */}
    <section class="py-20 bg-dark-800">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="prose prose-invert mx-auto">
            <h2>¿Por qué es importante llevar el control de caja diaria?</h2>
            <p>
              El control de caja diaria es fundamental para cualquier negocio, independientemente de su tamaño. 
              Un registro detallado de ingresos y egresos te permite:
            </p>
            
            <ul>
              <li>Detectar discrepancias o errores en el momento</li>
              <li>Tomar decisiones financieras informadas</li>
              <li>Mantener un registro claro para fines contables</li>
              <li>Prevenir pérdidas y detectar patrones de gasto</li>
              <li>Mejorar la gestión del flujo de efectivo</li>
            </ul>

            <h3>Beneficios de usar una herramienta digital</h3>
            <p>
              A diferencia de los métodos tradicionales en papel, una herramienta digital como esta te ofrece:
            </p>

            <ul>
              <li>Cálculos automáticos que eliminan errores humanos</li>
              <li>Visualización en tiempo real de tu situación financiera</li>
              <li>Capacidad de exportar datos para análisis posterior</li>
              <li>Acceso desde cualquier dispositivo con internet</li>
              <li>Respaldo automático de la información</li>
            </ul>

            <h3>Cómo sacar el máximo provecho</h3>
            <p>
              Para aprovechar al máximo esta herramienta gratuita de control de caja, te recomendamos:
            </p>

            <ol>
              <li>Registrar cada movimiento en el momento que ocurre</li>
              <li>Usar descripciones claras y específicas</li>
              <li>Revisar los gráficos para identificar patrones</li>
              <li>Exportar los datos regularmente como respaldo</li>
              <li>Analizar el ticket promedio para optimizar ventas</li>
            </ol>

            <h3>Preguntas frecuentes</h3>
            
            <h4>¿Es seguro usar esta herramienta?</h4>
            <p>
              Sí, todos los datos se almacenan localmente en tu navegador. Ninguna información se envía a servidores externos, 
              garantizando total privacidad.
            </p>

            <h4>¿Puedo acceder a mis datos desde otro dispositivo?</h4>
            <p>
              Al ser una herramienta que funciona con almacenamiento local, los datos son específicos del dispositivo que uses. 
              Te recomendamos exportar regularmente la información si necesitas acceder desde múltiples dispositivos.
            </p>

            <h4>¿Qué pasa si cierro el navegador?</h4>
            <p>
              Tus datos se guardan automáticamente y permanecerán disponibles la próxima vez que abras la herramienta en el mismo 
              dispositivo y navegador.
            </p>

            <h3>Consejos para una mejor gestión de caja</h3>
            <p>
              Además de usar esta herramienta, te recomendamos:
            </p>

            <ul>
              <li>Establecer un fondo fijo para iniciar cada día</li>
              <li>Categorizar tus gastos para mejor análisis</li>
              <li>Realizar arqueos de caja al final del día</li>
              <li>Mantener separados los gastos personales de los del negocio</li>
              <li>Revisar regularmente los indicadores clave como el ticket promedio</li>
            </ul>

            <h3>Recursos adicionales</h3>
            <p>
              Para mejorar aún más tu gestión financiera, te recomendamos:
            </p>

            <ul>
              <li>Suscribirte a nuestro newsletter para recibir más herramientas y consejos</li>
              <li>Explorar otras herramientas gratuitas en nuestra sección de recursos</li>
              <li>Seguir nuestro blog para tips sobre gestión de negocios</li>
              <li>Participar en nuestra comunidad para compartir experiencias</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* CTA Section */}
    <section id="cta" class="py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="bg-dark-800 rounded-xl p-8 border border-primary/20">
            <div class="grid md:grid-cols-2 gap-8 items-center">
              <div>
                <span class="inline-block px-3 py-1 bg-blue-primary/20 text-blue-primary rounded-full text-sm font-medium mb-4">
                  50% OFF por 6 meses
                </span>
                <h2 class="text-3xl font-bold mb-4">
                  ¿Querés llevar tu negocio al siguiente nivel?
                </h2>
                <p class="text-gray-300 mb-6">
                  Con ZinkERP podés gestionar mucho más que tu caja diaria. Stock, ventas, compras, sucursales y más, todo desde un solo lugar.
                </p>
                <div class="flex items-center gap-4 mb-8">
                  <div class="flex items-center gap-2">
                    <span class="text-4xl font-bold">$15</span>
                    <div class="text-sm text-gray-400">
                      <span>/mes</span>
                      <span class="block">primeros 6 meses</span>
                    </div>
                  </div>
                  <span class="text-sm text-gray-400 line-through">$29/mes</span>
                </div>
                <a 
                  href="https://cal.com/zinkintech" 
                  class="inline-flex items-center gap-2 px-6 py-3 bg-blue-primary hover:bg-blue-primary/90 rounded-lg font-medium transition-colors"
                >
                  Empezá ahora por solo US $15/mes
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
                    <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
                  </svg>
                </a>
              </div>
              
              <div class="space-y-4">
                <div class="flex items-start gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 text-primary shrink-0 mt-0.5">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                  </svg>
                  <span class="text-gray-300">Control total de stock y ventas</span>
                </div>
                <div class="flex items-start gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 text-primary shrink-0 mt-0.5">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                  </svg>
                  <span class="text-gray-300">Usuarios ilimitados sin costo extra</span>
                </div>
                <div class="flex items-start gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 text-primary shrink-0 mt-0.5">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                  </svg>
                  <span class="text-gray-300">Soporte 24/7 incluido</span>
                </div>
                <div class="flex items-start gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 text-primary shrink-0 mt-0.5">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                  </svg>
                  <span class="text-gray-300">Implementación guiada sin costo</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    import Chart from 'chart.js/auto';
    import { format } from 'date-fns';

    // Estado inicial
    let movements = JSON.parse(localStorage.getItem('movements') || '[]');
    let barChart, lineChart;

    // Elementos DOM
    const modal = document.getElementById('movementModal');
    const form = document.getElementById('movementForm');
    const modalTitle = document.getElementById('modalTitle');
    const typeInput = document.getElementById('type');
    const quickIncomeBtn = document.getElementById('quickIncomeBtn');
    const quickExpenseBtn = document.getElementById('quickExpenseBtn');
    const cancelButton = document.getElementById('cancelButton');
    const resetButton = document.getElementById('resetButton');
    const exportButton = document.getElementById('exportButton');
    const printButton = document.getElementById('printButton');

    // Función para formatear números al estilo argentino
    function formatNumber(number) {
      return new Intl.NumberFormat('es-AR', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }).format(number);
    }

    // Funciones de Modal
    function openModal(type: 'ingreso' | 'egreso') {
      if (modal && modalTitle && typeInput) {
        modal.classList.remove('hidden');
        modalTitle.textContent = type === 'ingreso' ? 'Registrar Ingreso' : 'Registrar Egreso';
        typeInput.value = type;
        document.body.style.overflow = 'hidden';
      }
    }

    function closeModal() {
      if (modal && form) {
        modal.classList.add('hidden');
        form.reset();
        document.body.style.overflow = '';
      }
    }

    // Inicializar gráficos
    function initCharts() {
      const barCtx = document.getElementById('barChart')?.getContext('2d');
      const lineCtx = document.getElementById('lineChart')?.getContext('2d');

      if (barCtx && lineCtx) {
        barChart = new Chart(barCtx, {
          type: 'bar',
          data: {
            labels: ['Ingresos', 'Egresos'],
            datasets: [{
              data: [0, 0],
              backgroundColor: ['#22c55e', '#ef4444']
            }]
          },
          options: {
            plugins: {
              legend: {
                display: false
              }
            },
            scales: {
              y: {
                beginAtZero: true,
                grid: {
                  color: 'rgba(255, 255, 255, 0.1)'
                },
                ticks: {
                  color: '#9ca3af'
                }
              },
              x: {
                grid: {
                  display: false
                },
                ticks: {
                  color: '#9ca3af'
                }
              }
            }
          }
        });

        lineChart = new Chart(lineCtx, {
          type: 'line',
          data: {
            labels: [],
            datasets: [{
              label: 'Saldo',
              data: [],
              borderColor: '#AC69FF',
              tension: 0.4
            }]
          },
          options: {
            plugins: {
              legend: {
                display: false
              }
            },
            scales: {
              y: {
                grid: {
                  color: 'rgba(255, 255, 255, 0.1)'
                },
                ticks: {
                  color: '#9ca3af'
                }
              },
              x: {
                grid: {
                  display: false
                },
                ticks: {
                  color: '#9ca3af'
                }
              }
            }
          }
        });
      }
    }

    // Actualizar UI
    function updateUI() {
      const incomeMovements = movements.filter(m => m.type === 'ingreso');
      const expenseMovements = movements.filter(m => m.type === 'egreso');
      
      const totalIncome = incomeMovements.reduce((sum, m) => sum + m.amount, 0);
      const totalExpenses = expenseMovements.reduce((sum, m) => sum + m.amount, 0);
      const balance = totalIncome - totalExpenses;
      
      const averageTicket = incomeMovements.length > 0 
        ? totalIncome / incomeMovements.length 
        : 0;

      const totalIncomeEl = document.getElementById('totalIncome');
      const totalExpensesEl = document.getElementById('totalExpenses');
      const currentBalanceEl = document.getElementById('currentBalance');
      const averageTicketEl = document.getElementById('averageTicket');

      if (totalIncomeEl && totalExpensesEl && currentBalanceEl && averageTicketEl) {
        totalIncomeEl.textContent = `$${formatNumber(totalIncome)}`;
        totalExpensesEl.textContent = `$${formatNumber(totalExpenses)}`;
        currentBalanceEl.textContent = `$${formatNumber(balance)}`;
        averageTicketEl.textContent = `$${formatNumber(averageTicket)}`;
        
        currentBalanceEl.className = balance >= 0 
          ? 'text-xl font-bold text-primary'
          : 'text-xl font-bold text-red-500';
      }
      
      // Actualizar gráfico de barras
      if (barChart) {
        barChart.data.datasets[0].data = [totalIncome, totalExpenses];
        barChart.update();
      }

      // Actualizar gráfico de línea
      if (lineChart) {
        let runningBalance = 0;
        const balanceData = movements.map(m => {
          runningBalance += m.type === 'ingreso' ? m.amount : -m.amount;
          return runningBalance;
        });

        lineChart.data.labels = movements.map(m => format(new Date(m.timestamp), 'HH:mm'));
        lineChart.data.datasets[0].data = balanceData;
        lineChart.update();
      }

      // Actualizar lista de movimientos
      const tbody = document.getElementById('movementsList');
      if (tbody) {
        tbody.innerHTML = movements
          .map(m => `
            <tr class="border-t border-dark-600">
              <td class="px-4 py-3 text-sm">${format(new Date(m.timestamp), 'HH:mm')}</td>
              <td class="px-4 py-3 text-sm">
                <span class="px-2 py-1 rounded-full text-xs ${
                  m.type === 'ingreso' 
                    ? 'bg-green-500/20 text-green-500' 
                    : 'bg-red-500/20 text-red-500'
                }">
                  ${m.type}
                </span>
              </td>
              <td class="px-4 py-3 text-sm">${m.description || '-'}</td>
              <td class="px-4 py-3 text-sm text-right ${
                m.type === 'ingreso' ? 'text-green-500' : 'text-red-500'
              }">
                ${m.type === 'ingreso' ? '+' : '-'}$${formatNumber(m.amount)}
              </td>
            </tr>
          `)
          .join('');
      }

      // Guardar en localStorage
      localStorage.setItem('movements', JSON.stringify(movements));
    }

    // Event Listeners
    quickIncomeBtn?.addEventListener('click', () => openModal('ingreso'));
    quickExpenseBtn?.addEventListener('click', () => openModal('egreso'));
    cancelButton?.addEventListener('click', closeModal);

    // Cerrar modal al hacer clic fuera
    
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const amountInput = document.getElementById('amount') as HTMLInputElement;
      const descriptionInput = document.getElementById('description') as HTMLInputElement;
      
      
      
      const amount = parseFloat(amountInput.value);
      
      if (isNaN(amount) || amount <= 0) {
        alert('Por favor ingrese un monto válido mayor a 0');
        return;
      }

      movements.push({
        type: typeInput?.value,
        amount,
        description: descriptionInput.value,
        timestamp: new Date().toISOString()
      });

      closeModal();
      updateUI();
    });

    resetButton?.addEventListener('click', () => {
      if (confirm('¿Estás seguro de que quieres reiniciar la caja? Esta acción no se puede deshacer.')) {
        movements = [];
        updateUI();
      }
    });

    exportButton?.addEventListener('click', () => {
      const csv = [
        ['Fecha', 'Hora', 'Tipo', 'Descripción', 'Monto'].join(','),
        ...movements.map(m => [
          format(new Date(m.timestamp), 'yyyy-MM-dd'),
          format(new Date(m.timestamp), 'HH:mm'),
          m.type,
          m.description || '',
          formatNumber(m.amount)
        ].join(','))
      ].join('\n');

      const blob = new Blob([csv], { type: 'text/csv' });
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `caja-${format(new Date(), 'yyyy-MM-dd')}.csv`;
      a.click();
    });

    printButton?.addEventListener('click', () => {
      window.print();
    });

    // Inicializar
    initCharts();
    updateUI();
  </script>

  <style>
    @media print {
      header, footer, button {
        display: none !important;
      }
      
      body {
        background: white !important;
        color: black !important;
      }

      canvas {
        max-width: 100% !important;
        height: auto !important;
      }

      .container {
        max-width: none !important;
        width: 100% !important;
        padding: 0 !important;
      }

      table {
        border-collapse: collapse !important;
      }

      td, th {
        border: 1px solid #ddd !important;
        padding: 8px !important;
      }
    }
  </style>
</Layout>