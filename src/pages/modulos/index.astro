---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { modules } from '../../data/modules';

---

<Layout title="Módulos ZinkERP | Sistema de gestión integral">
  <Header />
  <main>
    <section class="pt-32 pb-20 relative">
      <div class="absolute inset-0 z-0 opacity-20">
        <div class="absolute top-1/4 right-1/4 w-96 h-96 rounded-full bg-primary-600/30 blur-3xl"></div>
        <div class="absolute bottom-1/3 left-1/3 w-80 h-80 rounded-full bg-primary-600/30 blur-3xl"></div>
      </div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="text-center mb-16 animate-on-scroll">
          <h1 class="text-4xl md:text-5xl font-bold mb-6">Módulos ZinkERP</h1>
          <p class="text-xl text-gray-300 max-w-3xl mx-auto">
            Descubrí todas las herramientas que ZinkERP tiene para hacer crecer tu negocio
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {modules.map((module) => (
            <div class="bg-dark-700 rounded-2xl overflow-hidden group hover:scale-[1.02] transition-all duration-300 animate-on-scroll">
              <div class={`h-1 bg-gradient-to-r ${module.color}`}></div>
              <div class="p-6 h-full flex flex-col">
                <div class="flex items-start gap-4 mb-4">
                  <div class={`flex items-center justify-center w-12 h-12 rounded-xl bg-gradient-to-r ${module.color} p-3 group-hover:scale-110 transition-transform duration-300 shrink-0`}>
                    <span class="text-xl text-white font-bold">{module.title[0]}</span>
                  </div>
                  <div>
                    <h2 class="text-xl font-bold">{module.title}</h2>
                    <p class="text-primary-400 text-sm">{module.subtitle}</p>
                  </div>
                </div>
                
                <p class="text-gray-300 text-sm mb-6">{module.description}</p>
                
                <div class="flex-grow">
                  <ul class="space-y-2 mb-4">
                    {module.features.map((feature) => (
                      <li class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-primary shrink-0">
                          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                        </svg>
                        <span class="text-gray-300 text-sm">{feature}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                
                <a 
                  href={`/modulos/${module.id}`} 
                  class="inline-flex items-center gap-2 text-primary hover:text-primary-light transition-colors text-sm group-hover:translate-x-1 transition-transform duration-300 mt-auto"
                >
                  <span>Ver más sobre {module.title}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                    <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>