---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const links = [
  { href: '/producto/', label: 'Producto' },
  { href: '/precios/', label: 'Precios' },
  { href: '/blog/', label: 'Blog' },
  { href: '/recursos/', label: 'Herramientas gratuitas' },
];
---

<Layout title="Página no encontrada | ZinkERP" description="La página que buscás no existe o cambió de dirección." noindex>
  <Header />
  <main>
    <section class="min-h-[70vh] pt-32 pb-20 flex items-center">
      <div class="container mx-auto px-4">
        <div class="max-w-2xl mx-auto text-center">
          <p class="inline-flex items-center gap-2 px-4 py-2 mb-6 rounded-full border border-primary/30 bg-primary/10 text-primary-light text-sm font-medium">
            Error 404
          </p>
          <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-6">No encontramos esta página</h1>
          <p class="text-lg text-gray-300 mb-10">
            Puede que la dirección haya cambiado o que el enlace esté mal escrito. Estos son buenos lugares para seguir:
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
            <a href="/" class="px-6 py-3.5 rounded-xl bg-blue-primary hover:bg-blue-primary/90 transition-colors font-medium">
              Volver al inicio
            </a>
            <a href="https://cal.com/zinkintech" class="px-6 py-3.5 rounded-xl border border-white/12 hover:border-white/20 transition-colors font-medium">
              Pedí tu demo
            </a>
          </div>
          <nav aria-label="Secciones del sitio" class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-gray-300">
            {links.map((link) => (
              <a href={link.href} class="underline underline-offset-4 decoration-white/20 hover:text-white hover:decoration-white/60">{link.label}</a>
            ))}
          </nav>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
