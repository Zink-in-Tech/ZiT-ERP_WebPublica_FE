---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { productPages } from '../../data/productPages';
---

<Layout
  title="Producto | ZinkERP - Funcionalidades para ventas, stock, finanzas y multi-sucursal"
  description="Explorá las funcionalidades clave de ZinkERP para ventas, compras, inventario, facturación, finanzas, informes, sucursales y control de acceso."
>
  <Header />
  <main>
    <section class="border-b border-dark-700 bg-dark-900 pt-32 pb-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl">
          <p class="mb-5 inline-flex rounded-full border border-primary/30 bg-primary/10 px-4 py-2 text-sm font-medium text-primary-light">
            Producto
          </p>
          <h1 class="text-4xl font-bold leading-tight md:text-6xl">
            Un ERP operativo para vender, controlar stock y ordenar la gestión de punta a punta.
          </h1>
          <p class="mt-6 max-w-3xl text-lg text-gray-300 md:text-xl">
            Recorré las capacidades de ZinkERP por flujo real de negocio: ventas, compras, inventario, facturación, finanzas, multi-sucursal y más.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-dark-900 py-20">
      <div class="container mx-auto px-4">
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {productPages.map((page) => (
            <a
              href={`/producto/${page.slug}`}
              class="group rounded-[28px] border border-white/8 bg-dark-800/95 p-7 transition-all duration-300 hover:-translate-y-1 hover:border-primary/20 hover:bg-white/[0.03]"
            >
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary-light">Producto</p>
              <h2 class="mt-4 text-2xl font-bold group-hover:text-primary-light transition-colors">
                {page.title.split(' | ')[0]}
              </h2>
              <p class="mt-4 text-gray-300">{page.heroSubtitle}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-primary group-hover:text-primary-light transition-colors">
                Ver funcionalidad
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
                  <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
                </svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
