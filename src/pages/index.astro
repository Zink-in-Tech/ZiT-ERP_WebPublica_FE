---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ValueProps from '../components/ValueProps.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import Features from '../components/Features.astro';
import Benefits from '../components/Benefits.astro';
import Integrations from '../components/Integrations.astro';
import Resources from '../components/Resources.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="ZinkERP | Gestión integral para múltiples sucursales">
  <Header />
  <main>
    <Hero />
    <ValueProps />
    <ProductShowcase />
    <Features />
    <Benefits />
    <Integrations />
    <Resources />
    <Testimonials />
    <FAQ />
    <CTASection />
  </main>
  <Footer />
</Layout>
