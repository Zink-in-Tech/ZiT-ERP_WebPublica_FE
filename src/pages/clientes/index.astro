---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TestimonialsGrid from '../../components/TestimonialsGrid.astro';
import { testimonials } from '../../data/testimonials';

const pageTitle = 'Clientes | ZinkERP';
const pageDescription =
  'Historias reales de comercios que usan ZinkERP para ordenar ventas, stock, caja, proveedores y sucursales.';
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  <main>
    <section class="pt-32 pb-16 bg-dark-900 border-b border-dark-700">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <p class="inline-flex items-center gap-2 px-4 py-2 mb-6 rounded-full border border-primary/30 bg-primary/10 text-primary-light text-sm font-medium animate-on-scroll">
            Clientes
          </p>
          <h1 class="text-4xl md:text-6xl font-bold leading-tight mb-6 animate-on-scroll" style="animation-delay: 0.05s;">
            Historias reales de empresas que ya ordenaron su operación
          </h1>
          <p class="text-xl text-gray-300 animate-on-scroll" style="animation-delay: 0.1s;">
            Comercios de distintos rubros que pasaron de procesos dispersos a una operación más clara con ZinkERP.
          </p>
        </div>
      </div>
    </section>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <TestimonialsGrid
          testimonials={testimonials}
          columnsClass="grid md:grid-cols-2 gap-8 max-w-6xl mx-auto"
        />
      </div>
    </section>

    <section class="py-20 bg-dark-800 border-t border-dark-700">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center animate-on-scroll">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">¿Tu rubro no aparece acá?</h2>
          <p class="text-lg text-gray-300 mb-8">
            Explorá casos de uso por industria o agendá una demo para revisar tu operación real.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/casos-de-uso"
              class="inline-flex justify-center items-center px-8 py-4 border border-gray-600 hover:border-gray-400 rounded-lg text-lg font-medium transition-colors"
            >
              Ver casos de uso
            </a>
            <a
              href="https://cal.com/zinkintech"
              class="inline-flex justify-center items-center px-8 py-4 bg-blue-primary hover:bg-blue-primary/90 rounded-lg text-lg font-medium transition-colors"
            >
              Solicitar demo
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
