---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PortableTextRenderer from '../../components/PortableTextRenderer.astro';
import { fetchSanityData } from '../../lib/sanity';
import { buildPostMarkdown, fetchPublishedPost, fetchPublishedPostSlugs } from '../../lib/blogArticle';
import { articleMarkdownPath, buildAssistantLinks } from '../../lib/aiAssistants';
import type { PostDetail } from '../../types/blog';

// 1. Generamos las rutas estáticas con manejo de errores
export async function getStaticPaths() {
  const slugs = await fetchPublishedPostSlugs();
  return slugs.map((s) => ({ params: { slug: s } }));
}

// 2. Fetch del post actual y posts relacionados con manejo de errores
const slug = Astro.params.slug as string;
const [post, relatedPosts]: [PostDetail | null, PostDetail[]] = await Promise.all([
  fetchPublishedPost(slug),
  fetchSanityData(
    `*[_type == "post" && slug.current != $slug && !(_id in path("drafts.**"))][0...2]{
      title,
      "slug": slug.current,
      "mainImageUrl": mainImage.asset->url,
      publishedAt,
      "excerpt": pt::text(body)[0],
      "author": author->{name, "imageUrl": image.asset->url},
      "categories": categories[]->{title, "slug": slug.current}
    }`,
    { slug }
  )
]) || [null, []];

// Redirect to 404 if post not found
if (!post) {
  return Astro.redirect('/404');
}

// Social sharing URLs
const pageUrl = Astro.url.toString();
const shareUrls = {
  twitter: `https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(pageUrl)}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`,
  linkedin: `https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(pageUrl)}&title=${encodeURIComponent(post.title)}`,
  whatsapp: `https://wa.me/?text=${encodeURIComponent(`${post.title} ${pageUrl}`)}`,
};

// Markdown para usar el artículo con asistentes de IA (ChatGPT, Claude, etc.)
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const articleMarkdown = buildPostMarkdown(post, canonicalUrl, Astro.site?.origin);
const assistantLinks = buildAssistantLinks(new URL(articleMarkdownPath(slug), Astro.site).toString());
// Escapamos `<` para que el contenido no pueda cerrar el <script> inline que lo transporta.
const articleMarkdownJson = JSON.stringify(articleMarkdown).replace(/</g, '\\u003c');
const markdownFilename = `${slug}.md`;
---

<Layout title={`${post.title} | Blog ZinkERP`}>
  <Header />
  <main>
    {/* Hero Section */}
    <section class="pt-32 pb-20 relative bg-gradient-to-b from-primary/5 via-primary/10 to-dark-900">
      <div class="absolute inset-0 z-0">
        {/* Animated gradient orbs */}
        <div class="absolute top-1/4 right-1/4 w-96 h-96 rounded-full bg-primary/10 blur-3xl animate-pulse"></div>
        <div class="absolute bottom-1/3 left-1/3 w-80 h-80 rounded-full bg-primary/5 blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
        
        {/* Gradient overlay */}
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-dark-900/50 to-dark-900"></div>
      </div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl mx-auto">
          <div class="flex items-center gap-4 mb-8">
            <a 
              href="/blog"
              class="flex items-center gap-2 text-gray-300 hover:text-white transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
                <path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd" />
              </svg>
              Volver al blog
            </a>
          </div>

          <div class="flex items-center gap-4 mb-6">
            {post.categories?.map((cat) => cat.slug ? (
              <a 
                href={`/blog/categoria/${cat.slug}`}
                class="px-3 py-1 rounded-full bg-primary/20 text-primary text-sm hover:bg-primary/30 transition-colors"
              >
                {cat.title}
              </a>
            ) : (
              <span class="px-3 py-1 rounded-full bg-primary/20 text-primary text-sm">
                {cat.title}
              </span>
            ))}
          </div>

          <h1 class="text-4xl md:text-5xl font-bold mb-6 animate-on-scroll">
            {post.title}
          </h1>

          <div class="flex items-center gap-4 mb-12">
            <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center">
              {post.author.imageUrl ? (
                <img
                  src={post.author.imageUrl}
                  alt={post.author.name}
                  class="w-12 h-12 rounded-full"
                />
              ) : (
                <span class="text-xl font-bold">{post.author.name[0]}</span>
              )}
            </div>
            <div>
              <p class="font-medium">{post.author.name}</p>
              <p class="text-sm text-gray-400">{post.author.bio}</p>
            </div>
          </div>

          {post.mainImageUrl && (
            <div class="relative h-[400px] rounded-2xl overflow-hidden mb-12 animate-on-scroll" style="animation-delay: 0.2s;">
              <img
                src={post.mainImageUrl}
                alt={post.title}
                class="absolute inset-0 w-full h-full object-cover"
              />
            </div>
          )}
        </div>
      </div>
    </section>

    {/* Post Content with Sidebar */}
    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="flex flex-col lg:flex-row gap-12 max-w-6xl mx-auto">
          {/* Main Content */}
          <div class="w-full min-w-0 lg:w-2/3">
            <PortableTextRenderer content={post.body} pageUrl={canonicalUrl} />
          </div>

          {/* Sidebar: en mobile queda debajo del artículo; el CTA de demo ya está en la barra fija */}
          <div class="w-full lg:w-1/3">
            <div class="lg:[@media(min-height:860px)]:sticky lg:top-32 space-y-8">
              {/* Demo CTA */}
              <div class="hidden lg:block bg-dark-700 rounded-xl p-6 border border-primary/20">
                <h3 class="text-xl font-bold mb-4">¿Querés ver ZinkERP en acción?</h3>
                <p class="text-gray-300 mb-6">
                  Agendá una demo personalizada de 30 minutos y descubrí cómo podemos ayudarte a mejorar la gestión de tu negocio.
                </p>
                <a
                  href="https://cal.com/zinkintech"
                  class="block w-full px-6 py-3 bg-blue-primary hover:bg-blue-primary/90 rounded-lg text-center font-medium transition-colors"
                >
                  Coordinar demo
                </a>
              </div>

              {/* Social Sharing */}
              <div class="bg-dark-700 rounded-xl p-6 border border-dark-600">
                <h3 class="text-lg font-bold mb-4">Compartir</h3>
                <div class="flex gap-4">
                  <a
                    href={shareUrls.twitter}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-2 bg-dark-600 rounded-lg hover:bg-dark-500 transition-colors"
                    aria-label="Compartir en Twitter"
                  >
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                    </svg>
                  </a>
                  <a
                    href={shareUrls.facebook}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-2 bg-dark-600 rounded-lg hover:bg-dark-500 transition-colors"
                    aria-label="Compartir en Facebook"
                  >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/>
                    </svg>
                  </a>
                  <a
                    href={shareUrls.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-2 bg-dark-600 rounded-lg hover:bg-dark-500 transition-colors"
                    aria-label="Compartir en LinkedIn"
                  >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                  </a>
                  <a
                    href={shareUrls.whatsapp}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-2 bg-dark-600 rounded-lg hover:bg-dark-500 transition-colors"
                    aria-label="Compartir en WhatsApp"
                  >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                    </svg>
                  </a>
                </div>

                <div class="mt-6 pt-6 border-t border-dark-600" data-article-markdown data-filename={markdownFilename}>
                  <h4 class="text-base font-bold">Usalo con IA</h4>
                  <p id="article-ai-hint" class="text-sm text-gray-400 mt-1 mb-4">
                    Abrí el artículo en tu asistente para resumirlo o aplicarlo en tu negocio.
                  </p>
                  <div class="flex gap-3">
                    <a
                      href={assistantLinks.chatgpt}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-describedby="article-ai-hint"
                      class="flex-1 inline-flex items-center justify-center gap-2 px-3 py-2.5 bg-dark-600 rounded-lg hover:bg-dark-500 transition-colors text-sm font-semibold focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                    >
                      <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.872zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654l2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997Z"/>
                      </svg>
                      <span><span class="sr-only">Abrir en </span>ChatGPT</span>
                      <span class="sr-only">(se abre en una pestaña nueva)</span>
                    </a>
                    <a
                      href={assistantLinks.claude}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-describedby="article-ai-hint"
                      class="flex-1 inline-flex items-center justify-center gap-2 px-3 py-2.5 bg-dark-600 rounded-lg hover:bg-dark-500 transition-colors text-sm font-semibold focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                    >
                      <svg class="w-5 h-5 text-[#D97757]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m4.7144 15.9555 4.7174-2.6471.079-.2307-.079-.1275h-.2307l-.7893-.0486-2.6956-.0729-2.3375-.0971-2.2646-.1214-.5707-.1215-.5343-.7042.0546-.3522.4797-.3218.686.0608 1.5179.1032 2.2767.1578 1.6514.0972 2.4468.255h.3886l.0546-.1579-.1336-.0971-.1032-.0972L6.973 9.8356l-2.55-1.6879-1.3356-.9714-.7225-.4918-.3643-.4614-.1578-1.0078.6557-.7225.8803.0607.2246.0607.8925.686 1.9064 1.4754 2.4893 1.8336.3643.3035.1457-.1032.0182-.0728-.164-.2733-1.3539-2.4467-1.445-2.4893-.6435-1.032-.17-.6194c-.0607-.255-.1032-.4674-.1032-.7285L6.287.1335 6.6997 0l.9957.1336.419.3642.6192 1.4147 1.0018 2.2282 1.5543 3.0296.4553.8985.2429.8318.091.255h.1579v-.1457l.1275-1.706.2368-2.0947.2307-2.6957.0789-.7589.3764-.9107.7468-.4918.5828.2793.4797.686-.0668.4433-.2853 1.8517-.5586 2.9021-.3643 1.9429h.2125l.2429-.2429.9835-1.3053 1.6514-2.0643.7286-.8196.85-.9046.5464-.4311h1.0321l.759 1.1293-.34 1.1657-1.0625 1.3478-.8804 1.1414-1.2628 1.7-.7893 1.36.0729.1093.1882-.0183 2.8535-.607 1.5421-.2794 1.8396-.3157.8318.3886.091.3946-.3278.8075-1.967.4857-2.3072.4614-3.4364.8136-.0425.0304.0486.0607 1.5482.1457.6618.0364h1.621l3.0175.2247.7892.522.4736.6376-.079.4857-1.2142.6193-1.6393-.3886-3.825-.9107-1.3113-.3279h-.1822v.1093l1.0929 1.0686 2.0035 1.8092 2.5075 2.3314.1275.5768-.3218.4554-.34-.0486-2.2039-1.6575-.85-.7468-1.9246-1.621h-.1275v.17l.4432.6496 2.3436 3.5214.1214 1.0807-.17.3521-.6071.2125-.6679-.1214-1.3721-1.9246L14.38 17.959l-1.1414-1.9428-.1397.079-.674 7.2552-.3156.3703-.7286.2793-.6071-.4614-.3218-.7468.3218-1.4753.3886-1.9246.3157-1.53.2853-1.9004.17-.6314-.0121-.0425-.1397.0182-1.4328 1.9672-2.1796 2.9446-1.7243 1.8456-.4128.164-.7164-.3704.0667-.6618.4008-.5889 2.386-3.0357 1.4389-1.882.929-1.0868-.0062-.1579h-.0546l-6.3385 4.1164-1.1293.1457-.4857-.4554.0608-.7467.2307-.2429 1.9064-1.3114Z"/>
                      </svg>
                      <span><span class="sr-only">Abrir en </span>Claude</span>
                      <span class="sr-only">(se abre en una pestaña nueva)</span>
                    </a>
                  </div>
                  <p id="article-markdown-hint" class="text-sm text-gray-400 mt-5 mb-2">
                    ¿Usás otra herramienta? Llevate el artículo en Markdown.
                  </p>
                  <div class="flex flex-wrap gap-x-4 gap-y-2">
                    <button
                      type="button"
                      data-markdown-action="copy"
                      aria-describedby="article-markdown-hint"
                      class="inline-flex items-center gap-1.5 py-1 text-sm font-medium text-gray-300 hover:text-white transition-colors rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
                      </svg>
                      Copiar Markdown
                    </button>
                    <button
                      type="button"
                      data-markdown-action="download"
                      aria-describedby="article-markdown-hint"
                      class="inline-flex items-center gap-1.5 py-1 text-sm font-medium text-gray-300 hover:text-white transition-colors rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                      </svg>
                      Descargar .md
                    </button>
                  </div>
                  <p data-markdown-status role="status" aria-live="polite" class="mt-3 text-sm min-h-[1.25rem]"></p>
                  <script is:inline type="application/json" id="article-markdown-source" set:html={articleMarkdownJson}></script>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Related Posts */}
    {relatedPosts.length > 0 && (
      <section class="py-20 bg-dark-800">
        <div class="container mx-auto px-4">
          <div class="max-w-6xl mx-auto">
            <h2 class="text-3xl font-bold mb-12">Artículos relacionados</h2>
            
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
              {relatedPosts.map((relatedPost, index) => (
                <a 
                  href={`/blog/${relatedPost.slug}`}
                  class="group bg-dark-700 rounded-xl overflow-hidden hover:ring-1 hover:ring-primary/30 transition-all duration-300 animate-on-scroll"
                  style={`animation-delay: ${index * 0.1}s`}
                >
                  {relatedPost.mainImageUrl && (
                    <div class="relative h-48 overflow-hidden">
                      <img 
                        src={relatedPost.mainImageUrl}
                        alt={relatedPost.title}
                        class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      />
                    </div>
                  )}
                  <div class="p-6">
                    <div class="flex items-center gap-4 mb-4">
                      {relatedPost.categories?.map((cat) => (
                        <span class="px-3 py-1 rounded-full bg-primary/20 text-primary text-sm">
                          {cat.title}
                        </span>
                      ))}
                    </div>
                    <h3 class="text-xl font-bold mb-2 group-hover:text-primary transition-colors line-clamp-2">
                      {relatedPost.title}
                    </h3>
                    <p class="text-gray-300 text-sm line-clamp-2">
                      {relatedPost.excerpt}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    {/* Newsletter */}
    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="text-3xl font-bold mb-4">¿Te gustó este artículo?</h2>
          <p class="text-gray-300 mb-8">
            Suscribite a nuestro newsletter y recibí más contenido como este en tu email.
          </p>
          <iframe 
            src="https://embeds.beehiiv.com/a98f31c0-4464-430b-885d-da8c41eab6f5?slim=true" 
            data-test-id="beehiiv-embed" 
            height="52" 
            frameborder="0" 
            scrolling="no" 
            style="margin: 0; border-radius: 0px !important; background-color: transparent; width: 100%;"
          ></iframe>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const container = document.querySelector<HTMLElement>('[data-article-markdown]');
  const status = container?.querySelector<HTMLElement>('[data-markdown-status]');
  let clearStatusTimer: number | undefined;

  function showStatus(message: string, tone: 'success' | 'error') {
    if (!status) return;
    window.clearTimeout(clearStatusTimer);
    status.textContent = '';
    status.classList.toggle('text-green-400', tone === 'success');
    status.classList.toggle('text-red-400', tone === 'error');
    // Vaciar y reescribir en el próximo frame hace que los lectores de pantalla repitan el anuncio.
    window.requestAnimationFrame(() => {
      status.textContent = message;
    });
    if (tone === 'success') {
      clearStatusTimer = window.setTimeout(() => {
        status.textContent = '';
      }, 6000);
    }
  }

  function readMarkdown(): string {
    const source = document.getElementById('article-markdown-source')?.textContent;
    const markdown: unknown = source ? JSON.parse(source) : null;
    if (typeof markdown !== 'string' || !markdown.trim()) {
      throw new Error('Markdown del artículo no disponible');
    }
    return markdown;
  }

  async function copyToClipboard(text: string, trigger: HTMLElement) {
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        return;
      } catch {
        // Algunos navegadores bloquean la API asíncrona; probamos el método clásico.
      }
    }

    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    const copied = document.execCommand('copy');
    textarea.remove();
    trigger.focus();
    if (!copied) throw new Error('El navegador rechazó la copia');
  }

  function downloadMarkdown(text: string, filename: string) {
    const url = URL.createObjectURL(new Blob([text], { type: 'text/markdown;charset=utf-8' }));
    const link = document.createElement('a');
    link.href = url;
    link.download = filename;
    link.hidden = true;
    document.body.appendChild(link);
    link.click();
    link.remove();
    window.setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  container?.querySelector('[data-markdown-action="copy"]')?.addEventListener('click', async (event) => {
    const trigger = event.currentTarget as HTMLElement;
    try {
      await copyToClipboard(readMarkdown(), trigger);
      showStatus('Markdown copiado. Ya podés pegarlo en tu asistente de IA.', 'success');
    } catch (error) {
      console.error('No se pudo copiar el Markdown del artículo:', error);
      showStatus('No pudimos copiar el Markdown. Probá con “Descargar .md” o revisá los permisos del portapapeles.', 'error');
    }
  });

  container?.querySelector('[data-markdown-action="download"]')?.addEventListener('click', () => {
    const filename = container?.dataset.filename || 'articulo.md';
    try {
      downloadMarkdown(readMarkdown(), filename);
      showStatus(`Descargamos ${filename}.`, 'success');
    } catch (error) {
      console.error('No se pudo descargar el Markdown del artículo:', error);
      showStatus('No pudimos descargar el archivo. Probá con “Copiar Markdown”.', 'error');
    }
  });
</script>
