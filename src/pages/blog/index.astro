---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { fetchSanityData } from '../../lib/sanity';
import type { PostSummary } from '../../types/blog';

// 1. Fetch de todos los posts con manejo de errores
const posts: PostSummary[] = await fetchSanityData(`
  *[_type == "post"] | order(publishedAt desc){
    title,
    "slug": slug.current,
    "mainImageUrl": mainImage.asset->url,
    publishedAt,
    "excerpt": pt::text(body)[0],
    "author": author->{name, "slug": slug.current, "imageUrl": image.asset->url},
    "categories": categories[]->{title, "slug": slug.current}
  }
`) || [];

// 2. Configuración del filtro de categorías
const allCats = ['gestion-stock','finanzas','implementacion','operaciones'];
const baseBtn = 'px-4 py-2 rounded-full text-sm font-medium transition-colors';
---

<Layout title="Blog | ZinkERP - Recursos y consejos para tu negocio">
  <Header />
  <main>
    {/* Hero Section */}
    <section class="pt-32 pb-20 relative">
      <div class="absolute inset-0 z-0 opacity-20">
        <div class="absolute top-1/4 right-1/4 w-96 h-96 rounded-full bg-primary-600/30 blur-3xl"></div>
        <div class="absolute bottom-1/3 left-1/3 w-80 h-80 rounded-full bg-primary-600/30 blur-3xl"></div>
      </div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl font-bold mb-6 animate-on-scroll">
            Insights para hacer crecer tu negocio
          </h1>
          <p class="text-xl text-gray-300 mb-8 animate-on-scroll" style="animation-delay: 0.1s;">
            Recursos, guías y consejos prácticos para mejorar la gestión de tu empresa
          </p>
        </div>
      </div>
    </section>

    {/* Featured Post */}
    {posts.length > 0 && (
      <section class="py-20">
        <div class="container mx-auto px-4">
          <div class="max-w-6xl mx-auto">
            <a 
              href={`/blog/${posts[0].slug}`}
              class="group block bg-dark-700 rounded-2xl overflow-hidden hover:ring-1 hover:ring-primary/30 transition-all duration-300 animate-on-scroll"
              style="animation-delay: 0.2s;"
            >
              <div class="relative h-[400px] overflow-hidden">
                <img 
                  src={posts[0].mainImageUrl}
                  alt={posts[0].title}
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-dark-900 to-transparent"></div>
                <div class="absolute bottom-0 left-0 p-8">
                  <div class="flex items-center gap-4 mb-4">
                    {posts[0].categories?.map((cat) => (
                      <span class="px-3 py-1 rounded-full bg-primary/20 text-primary text-sm">
                        {cat.title}
                      </span>
                    ))}
                    <span class="text-gray-300 text-sm">
                      {new Date(posts[0].publishedAt).toLocaleDateString('es-AR', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                      })}
                    </span>
                  </div>
                  <h2 class="text-3xl font-bold mb-4 group-hover:text-primary transition-colors">
                    {posts[0].title}
                  </h2>
                  <p class="text-gray-300 max-w-2xl line-clamp-2">
                    {posts[0].excerpt}
                  </p>
                </div>
              </div>
            </a>
          </div>
        </div>
      </section>
    )}

    {/* Categories */}
    <section class="py-8 bg-dark-800">
      <div class="container mx-auto px-4">
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/blog"
            class={`${baseBtn} bg-primary hover:bg-primary-dark`}
          >
            Todos
          </a>
          {allCats.map((cat) => {
            const label = cat
              .split('-')
              .map(w => w[0].toUpperCase() + w.slice(1))
              .join(' ');
            return (
              <a
                href={`/blog/categoria/${cat}`}
                class={`${baseBtn} bg-dark-700 hover:bg-dark-600`}
              >
                {label}
              </a>
            );
          })}
        </div>
      </div>
    </section>

    {/* Posts Grid */}
    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
          {posts.slice(1).map((post, index) => (
            <a 
              href={`/blog/${post.slug}`}
              class="group bg-dark-700 rounded-xl overflow-hidden hover:ring-1 hover:ring-primary/30 transition-all duration-300 animate-on-scroll"
              style={`animation-delay: ${(index + 1) * 0.1}s`}
            >
              <div class="relative h-48 overflow-hidden">
                <img 
                  src={post.mainImageUrl}
                  alt={post.title}
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </div>
              <div class="p-6">
                <div class="flex items-center gap-4 mb-4">
                  {post.categories?.map((cat) => (
                    <span class="px-3 py-1 rounded-full bg-primary/20 text-primary text-sm">
                      {cat.title}
                    </span>
                  ))}
                  <span class="text-gray-300 text-sm">
                    {new Date(post.publishedAt).toLocaleDateString('es-AR', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </span>
                </div>
                <h3 class="text-xl font-bold mb-2 group-hover:text-primary transition-colors line-clamp-2">
                  {post.title}
                </h3>
                <p class="text-gray-300 text-sm mb-4 line-clamp-2">
                  {post.excerpt}
                </p>
                <div class="flex items-center gap-3">
                  <img 
                    src={post.author.imageUrl}
                    alt={post.author.name}
                    class="w-8 h-8 rounded-full"
                  />
                  <p class="text-sm font-medium">{post.author.name}</p>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* Newsletter */}
    <section class="py-20 bg-dark-800">
      <div class="container mx-auto px-4">
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="text-3xl font-bold mb-4">¿Querés recibir más contenido?</h2>
          <p class="text-gray-300 mb-8">
            Suscribite a nuestro newsletter y recibí tips, guías y novedades para hacer crecer tu negocio.
          </p>
          <form class="flex gap-4">
            <input 
              type="email"
              placeholder="tu@email.com"
              class="flex-1 px-4 py-3 bg-dark-700 rounded-lg border border-dark-600 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors"
            />
            <button 
              type="submit"
              class="px-6 py-3 bg-blue-primary hover:bg-blue-primary/90 rounded-lg font-medium transition-colors"
            >
              Suscribirme
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>



