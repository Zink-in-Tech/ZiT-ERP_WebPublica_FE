  headline="Integrá Mercado Pago con ZinkERP"
  subheadline="Conectá tus cobros con la operación comercial de ZinkERP usando autorización segura desde Mercado Pago."
  logoSrc="/img/integrations/mercadopago.svg"
  logoAlt="Logo de Mercado Pago"
  logoTitle="Mercado Pago + ZinkERP"
  summaryCards={summaryCards}
  detailSections={detailSections}
  faqs={faqs}
  ctaTitle="Conectá tus cobros con más contexto operativo"
  ctaText="Coordinemos una demo para revisar cómo Mercado Pago se integra con los flujos comerciales de ZinkERP en tu negocio."
