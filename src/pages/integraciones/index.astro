---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = 'Integraciones | ZinkERP';
const pageDescription = 'Conectá ZinkERP con ecommerce, facturación y pagos para ordenar la operación diaria de tu comercio o pyme.';

const integrations = [
  {
    name: 'WooCommerce',
    id: 'woocommerce',
    category: 'Ecommerce',
    description: 'Conectá tu tienda online con la gestión diaria de ventas, stock, facturación y operación comercial.',
    href: '/integraciones/woocommerce',
    cta: 'Ver integración',
    logoSrc: '/img/integrations/woocommerce.svg',
    logoAlt: 'Logo de WooCommerce',
  },
  {
    name: 'Facturante',
    id: 'facturante',
    category: 'Facturación',
    description: 'Integración operativa para acompañar flujos de facturación dentro del contexto de gestión de ZinkERP.',
    href: '#contacto',
    cta: 'Consultar alcance',
    logoSrc: '/img/integrations/facturante.svg',
    logoAlt: 'Logo de Facturante',
  },
  {
    name: 'MercadoPago',
    id: 'mercadopago',
    category: 'Pagos',
    description: 'Integración operativa para conectar pagos con la operación comercial y reducir separación entre herramientas.',
    href: '#contacto',
    cta: 'Consultar alcance',
    logoSrc: '/img/integrations/mercadopago.svg',
    logoAlt: 'Logo de Mercado Pago',
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  <main>
    <section class="pt-32 pb-20 bg-dark-900 border-b border-dark-700">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <p class="inline-flex items-center gap-2 px-4 py-2 mb-6 rounded-full border border-primary/30 bg-primary/10 text-primary-light text-sm font-medium animate-on-scroll">
            Integraciones operativas
          </p>
          <h1 class="text-4xl md:text-6xl font-bold leading-tight mb-6 animate-on-scroll" style="animation-delay: 0.05s;">
            Conectá ZinkERP con las herramientas de tu operación
          </h1>
          <p class="text-xl text-gray-300 animate-on-scroll" style="animation-delay: 0.1s;">
            Ecommerce, facturación y pagos pueden convivir con la gestión diaria de ventas, stock, POS, sucursales y administración.
          </p>
        </div>
      </div>
    </section>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="grid md:grid-cols-3 gap-6">
          {integrations.map((integration) => (
            <a
              id={integration.id}
              href={integration.href}
              class="group block scroll-mt-28 bg-dark-800 border border-dark-700 rounded-lg p-6 min-h-[300px] hover:border-primary/40 hover:-translate-y-1 transition-all duration-300 animate-on-scroll focus:outline-none focus:ring-2 focus:ring-primary/60"
              aria-label={`${integration.cta}: ${integration.name}`}
            >
              <div class="flex items-start justify-between gap-4 mb-6">
                <div class="h-16 w-28 rounded-lg bg-white flex items-center justify-center shrink-0 shadow-lg overflow-hidden p-2">
                  <img src={integration.logoSrc} alt={integration.logoAlt} class="h-full w-full object-contain" loading="lazy" />
                </div>
                <span class="px-3 py-1 rounded-full bg-green-500/10 text-green-300 text-xs border border-green-500/30">Operativa</span>
              </div>
              <p class="text-sm text-primary-light mb-1">{integration.category}</p>
              <h2 class="text-2xl font-bold mb-4 group-hover:text-primary-light transition-colors">{integration.name}</h2>
              <p class="text-gray-300 mb-6">{integration.description}</p>
              <span class="inline-flex items-center gap-2 text-primary group-hover:text-primary-light transition-colors font-medium">
                {integration.cta}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 group-hover:translate-x-1 transition-transform">
                  <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
                </svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-dark-800">
      <div class="container mx-auto px-4">
        <div class="grid lg:grid-cols-2 gap-12 items-start">
          <div class="animate-on-scroll">
            <h2 class="text-3xl md:text-4xl font-bold mb-6">Por qué importan las integraciones</h2>
            <p class="text-lg text-gray-300">
              ZinkERP busca ser la base operativa del negocio. Las integraciones ayudan a conectar herramientas que ya usa el equipo con ventas, stock, facturación, POS, sucursales y control administrativo.
            </p>
          </div>
          <div class="grid gap-4">
            <div class="bg-dark-700 border border-dark-600 rounded-lg p-5 animate-on-scroll">
              <h3 class="font-bold mb-2">Menos trabajo duplicado</h3>
              <p class="text-gray-300">Reducí tareas manuales entre ecommerce, pagos, facturación y gestión.</p>
            </div>
            <div class="bg-dark-700 border border-dark-600 rounded-lg p-5 animate-on-scroll">
              <h3 class="font-bold mb-2">Más contexto operativo</h3>
              <p class="text-gray-300">La información comercial tiene más valor cuando se conecta con la operación diaria.</p>
            </div>
            <div class="bg-dark-700 border border-dark-600 rounded-lg p-5 animate-on-scroll">
              <h3 class="font-bold mb-2">Acompañamiento local</h3>
              <p class="text-gray-300">ZinkERP está pensado para pymes argentinas que necesitan orden sin complejidad innecesaria.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="contacto" class="py-20 scroll-mt-28">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center animate-on-scroll">
          <h2 class="text-3xl md:text-5xl font-bold mb-6">¿Querés revisar qué integración aplica a tu negocio?</h2>
          <p class="text-xl text-gray-300 mb-8">
            Coordinemos una demo para ver cómo conectar ecommerce, facturación o pagos con la operación de ZinkERP.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="https://cal.com/zinkintech" class="inline-flex justify-center items-center px-8 py-4 bg-blue-primary hover:bg-blue-primary/90 rounded-lg text-lg font-medium transition-colors">
              Solicitar demo
            </a>
            <a href="https://cal.com/zinkintech" class="inline-flex justify-center items-center px-8 py-4 border border-gray-600 hover:border-gray-400 rounded-lg text-lg font-medium transition-colors">
              Hablar con un especialista
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
