---
import IntegrationDetailPage from '../../../components/IntegrationDetailPage.astro';

const summaryCards = [
  {
    title: 'Integración nativa',
    text: 'ZinkERP se conecta directo con ARCA para emitir comprobantes electrónicos, sin proveedores externos.',
  },
  {
    title: 'Sin vincular cuentas de terceros',
    text: 'Cargás los datos fiscales de tu organización tal como figuran en ARCA. No hay que conectar otras cuentas.',
  },
  {
    title: 'Habilitación',
    text: 'Después del trámite, ARCA puede demorar hasta 24 horas en habilitar el punto de venta.',
  },
];

const detailSections = [
  {
    title: '1. Trámite en ARCA',
    text: 'Desde el portal de ARCA creás un punto de venta para facturación electrónica y delegás el servicio en Zink in Tech.',
    items: [
      'Punto de venta exclusivo para ZinkERP.',
      'Delegación del servicio a la CUIT de Zink in Tech.',
      'Te guiamos si es tu primera vez con el trámite.',
    ],
  },
  {
    title: '2. Datos fiscales en ZinkERP',
    text: 'En Configuración → Preferencias → Integraciones → ARCA cargás los datos fiscales de la organización.',
    items: [
      'Número de punto de venta habilitado en ARCA.',
      'Domicilio fiscal e ingresos brutos.',
      'Inicio de actividades.',
    ],
  },
  {
    title: '3. Validación y primera factura',
    text: 'Con el trámite y la carga hechos, nuestro equipo de soporte valida la delegación y habilita la emisión.',
    items: [
      'Avisás a soporte con tu CUIT y el punto de venta.',
      'Validamos la delegación en ARCA.',
      'Listo para emitir comprobantes desde ZinkERP.',
    ],
  },
];

const faqs = [
  {
    question: '¿Qué necesito para configurarlo?',
    answer: 'Un punto de venta habilitado en ARCA, la delegación del servicio a Zink in Tech y los datos fiscales de tu organización (domicilio fiscal, ingresos brutos e inicio de actividades) tal como figuran en ARCA.',
  },
  {
    question: '¿La integración con ARCA es nativa?',
    answer: 'Sí. ZinkERP se conecta directo con ARCA, sin intermediarios ni cuentas de terceros.',
  },
  {
    question: '¿Por qué puede demorar hasta 24 horas?',
    answer: 'Después del trámite, ARCA puede tardar hasta 24 horas en habilitar el punto de venta. Es un plazo externo a ZinkERP: si necesitás facturar en una fecha puntual, conviene hacer el alta con margen.',
  },
  {
    question: '¿Puedo usar un punto de venta que ya uso en otro sistema?',
    answer: 'No conviene. Lo recomendable es un punto de venta exclusivo para ZinkERP, habilitado en ARCA para facturación electrónica.',
  },
  {
    question: '¿ZinkERP reemplaza la gestión fiscal de mi contador?',
    answer: 'No. ZinkERP ordena la facturación dentro de la operación, pero no reemplaza el criterio contable ni las obligaciones fiscales del negocio.',
  },
];
---

<IntegrationDetailPage
  pageTitle="Integración ARCA | ZinkERP"
  pageDescription="Integración nativa de ZinkERP con ARCA: punto de venta, delegación y datos fiscales para emitir factura electrónica sin proveedores externos."
  eyebrow="Integración nativa para facturación"
  headline="ARCA nativa dentro de ZinkERP"
  subheadline="Conectá tu CUIT con ZinkERP en tres pasos: trámite en ARCA, carga de datos fiscales y validación de nuestro equipo."
  logoSrc="/img/integrations/arca.svg"
  logoAlt="Logo ARCA"
  logoTitle="ARCA + ZinkERP"
  statusLabel="Nativa"
  summaryCards={summaryCards}
  detailSections={detailSections}
  relatedLink={{
    text: '¿Qué comprobantes podés emitir, desde dónde y cómo le llegan al cliente?',
    label: 'Ver Facturación en ZinkERP',
    href: '/producto/facturacion',
  }}
  faqs={faqs}
  ctaTitle="Revisemos tu alta en ARCA"
  ctaText="Coordinemos una demo y revisamos juntos los pasos para conectar tu CUIT con ZinkERP."
/>
