---

<IntegrationDetailPage
  pageTitle="Integración ARCA | ZinkERP"
  pageDescription="Facturación electrónica con ARCA integrada de forma nativa en ZinkERP para comercios y pymes argentinas."
  eyebrow="Integración nativa para facturación"
  headline="ARCA nativa dentro de ZinkERP"
  subheadline="Facturación electrónica conectada a tu operación diaria para vender, cobrar y ordenar la gestión desde un solo lugar."
  logoSrc="/img/integrations/arca.svg"
  logoAlt="Logo ARCA"
  logoTitle="ARCA + ZinkERP"
  statusLabel="Nativa"
  summaryCards={summaryCards}
  detailSections={detailSections}
  faqs={faqs}
  ctaTitle="Revisemos tu circuito de facturación"
  ctaText="Coordinemos una demo para validar cómo queda la facturación con ARCA dentro de la operación real de tu empresa."
/>
