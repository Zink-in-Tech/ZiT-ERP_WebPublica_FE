<IntegrationDetailPage
  pageTitle="Integración WooCommerce | ZinkERP"
  pageDescription="Conectá WooCommerce con ZinkERP para ordenar catálogo, productos vinculados y operación comercial de tu tienda online."
  eyebrow="Integración operativa para ecommerce"
  headline="Integrá WooCommerce con ZinkERP"
  subheadline="Conectá tu tienda online con la gestión de productos, precios, existencias y operación comercial de ZinkERP."
  logoSrc="/img/integrations/woocommerce.svg"
  logoAlt="Logo de WooCommerce"
  logoTitle="WooCommerce + ZinkERP"
  summaryCards={summaryCards}
  detailSections={detailSections}
  steps={steps}
  faqs={faqs}
  ctaTitle="Conectá tu tienda con una operación más ordenada"
  ctaText="Coordinemos una demo para revisar cómo WooCommerce puede integrarse con ZinkERP según tu catálogo, tus productos y tu forma de operar."
/>
