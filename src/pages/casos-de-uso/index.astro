---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import UseCaseCtas from '../../components/use-cases/UseCaseCtas.astro';
import UseCaseLeadForm from '../../components/use-cases/UseCaseLeadForm.astro';
import UseCaseTracking from '../../components/use-cases/UseCaseTracking.astro';
import { buildWhatsAppUrl } from '../../lib/whatsapp';

const pageTitle = 'Casos de uso de ZinkERP | Ferreterías, dietéticas, papeleras y más';
const pageDescription =
  'Cómo funciona ZinkERP en comercios argentinos de 2 a 4 sucursales: ferreterías, dietéticas, artículos de limpieza, papeleras e insumos de repostería. Pedí una demo.';

const whatsappUrl = buildWhatsAppUrl(
  'Hola, quiero ver el flujo de ZinkERP para mi comercio: ventas, stock y compras.',
);
const demoUrl = '/agendar-demo';

const priorityCases = [
  {
    name: 'Ferreterías',
    kicker: 'Cotización → venta → cuenta corriente',
    description: 'Mostrador, presupuestos a obra, stock amplio y saldos de clientes en un solo circuito.',
    highlights: ['Presupuesto que se convierte', 'Stock del mostrador', 'Cuenta corriente'],
    accent: 'from-violet-500 to-purple-600',
    iconLabel: 'F',
    href: '/casos-de-uso/ferreterias',
    cta: 'Ver flujo de ferretería',
  },
  {
    name: 'Dietéticas',
    kicker: 'Pesable → venta → caja',
    description: 'Venta rápida, productos pesables, factura ARCA y descuento de stock en el mismo paso.',
    highlights: ['Productos pesables', 'Stock al instante', 'Caja por sucursal'],
    accent: 'from-blue-500 to-cyan-600',
    iconLabel: 'D',
    href: '/casos-de-uso/dieteticas',
    cta: 'Ver flujo de dietética',
  },
  {
    name: 'Artículos de limpieza',
    kicker: 'Compra → recepción → reposición',
    description: 'Presentaciones, listas mayorista/minorista y compras que actualizan el stock al recibir.',
    highlights: ['Órdenes de compra', 'Listas de precios', 'Multi-sucursal'],
    accent: 'from-green-500 to-emerald-600',
    iconLabel: 'L',
    href: '/casos-de-uso/articulos-de-limpieza',
    cta: 'Ver flujo de limpieza',
  },
  {
    name: 'Papeleras / librerías comerciales',
    kicker: 'Catálogo → precios → caja',
    description: 'Miles de SKUs, temporadas fuertes y un mostrador que no puede frenarse a buscar un precio.',
    highlights: ['Catálogo amplio', 'Listas por canal', 'Control de caja'],
    accent: 'from-pink-500 to-rose-600',
    iconLabel: 'P',
    href: '/casos-de-uso/papeleras',
    cta: 'Ver flujo de papelera',
  },
  {
    name: 'Insumos de repostería',
    kicker: 'Variantes → reposición → venta',
    description: 'Colores, medidas y picos de demanda con precios que siguen al costo.',
    highlights: ['Variantes ordenadas', 'Reposición a tiempo', 'Mostrador + caja'],
    accent: 'from-yellow-500 to-orange-600',
    iconLabel: 'R',
    href: '/casos-de-uso/insumos-de-reposteria',
    cta: 'Ver flujo de insumos',
  },
];

const discoveryCases = [
  {
    name: 'Florerías',
    kicker: 'A validar en demo',
    description: 'Pedidos por varios canales y facturación a ordenar. El delivery lo revisamos en la demo.',
    tags: ['Pedidos', 'Stock', 'Facturación'],
    accent: 'from-pink-500 to-rose-600',
    iconLabel: 'F',
    href: '/casos-de-uso/florerias',
    cta: 'Evaluar encaje',
  },
  {
    name: 'Zinguería / metalúrgica',
    kicker: 'A validar en demo',
    description: 'Presupuestos, materiales y facturación. La manufactura se revisa aparte.',
    tags: ['Presupuestos', 'Compras', 'Cuenta corriente'],
    accent: 'from-orange-500 to-red-600',
    iconLabel: 'Z',
    href: '/casos-de-uso/zingueria-metalurgica',
    cta: 'Evaluar encaje',
  },
  {
    name: 'Cultivos',
    kicker: 'A validar en demo',
    description: 'Parte comercial y administrativa. Lo agronómico lo revisamos aparte.',
    tags: ['Stock', 'Compras', 'Facturación'],
    accent: 'from-teal-500 to-green-600',
    iconLabel: 'C',
    href: '/casos-de-uso/cultivos',
    cta: 'Evaluar encaje',
  },
];

const patternGroups = [
  {
    title: 'Comercios con catálogo amplio',
    text: 'Encontrar el producto, sostener el precio vigente y vender sin frenar el mostrador.',
    tags: ['Ferreterías', 'Papeleras', 'Insumos de repostería', 'Dietéticas'],
  },
  {
    title: 'Reposición frecuente',
    text: 'Comprar con stock real, recibir y volver a vender sin adivinar qué falta.',
    tags: ['Artículos de limpieza', 'Ferreterías', 'Dietéticas'],
  },
  {
    title: 'Venta presencial + cuenta corriente',
    text: 'Cobrar en el local y seguir saldos de clientes habituales en el mismo circuito.',
    tags: ['Mostrador', 'POS', 'Cuenta corriente', 'Caja'],
  },
  {
    title: 'Complejidad a validar',
    text: 'Rubros donde primero revisamos juntos tu flujo real para ver cómo encaja.',
    tags: ['Florerías', 'Zinguería / metalúrgica', 'Cultivos'],
  },
];

const hubFaqs = [
  {
    question: '¿ZinkERP es un sistema distinto para cada rubro?',
    answer:
      'No. Es el mismo producto. Cada página por rubro muestra el circuito operativo de ese comercio: compras, stock, precios, ventas, facturación, cuenta corriente y caja.',
  },
  {
    question: '¿Para quién está pensado?',
    answer:
      'Comercios y pymes argentinas, en especial de 2 a 4 sucursales, que venden productos, reponen seguido y ya superaron Excel, un POS básico o herramientas desconectadas.',
  },
  {
    question: '¿Qué sigue después de elegir un rubro?',
    answer:
      'En la página de tu rubro ves el flujo, los módulos que aplican y un formulario corto. Después coordinamos una demo o seguimos por WhatsApp.',
  },
];

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Casos de uso', item: new URL('/casos-de-uso', Astro.site).toString() },
  ],
};
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  <main class="pb-24 md:pb-0">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)}></script>
    <section class="pt-32 pb-16 bg-dark-900 border-b border-dark-700">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <p class="inline-flex items-center gap-2 px-4 py-2 mb-6 rounded-full border border-primary/30 bg-primary/10 text-primary-light text-sm font-medium animate-on-scroll">
            Casos de uso
          </p>
          <h1 class="text-4xl md:text-6xl font-bold leading-tight mb-6 animate-on-scroll" style="animation-delay: 0.05s;">
            El sistema que conecta compras, stock, ventas, factura, cuenta corriente y caja
          </h1>
          <p class="text-xl text-gray-300 mb-4 animate-on-scroll" style="animation-delay: 0.1s;">
            Para comercios argentinos de 2 a 4 sucursales que ya no pueden operar con Excel, un POS suelto o herramientas desconectadas.
          </p>
          <p class="text-base text-gray-400 mb-8 animate-on-scroll" style="animation-delay: 0.12s;">
            Elegí el rubro. Vas a ver el flujo concreto, no una lista genérica de módulos.
          </p>
          <div class="animate-on-scroll" style="animation-delay: 0.15s;">
            <UseCaseCtas
              demoHref="#contacto"
              whatsappHref={whatsappUrl}
              vertical="hub"
              placement="hero"
              align="center"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mb-12 animate-on-scroll">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Rubros principales</h2>
          <p class="text-lg text-gray-300">
            Cada página muestra el circuito de ese negocio: qué duele, qué hace el equipo y qué queda resuelto en stock, caja o cuenta corriente.
          </p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {priorityCases.map((useCase) => (
            <div class="bg-dark-700 rounded-2xl overflow-hidden group hover:scale-[1.02] transition-all duration-300 animate-on-scroll h-full flex flex-col">
              <div class={`h-1 bg-gradient-to-r ${useCase.accent}`}></div>
              <div class="p-6 h-full flex flex-col flex-1">
                <div class="flex items-start gap-4 mb-4">
                  <div class={`flex items-center justify-center w-12 h-12 rounded-xl bg-gradient-to-r ${useCase.accent} p-3 group-hover:scale-110 transition-transform duration-300 shrink-0`}>
                    <span class="text-xl text-white font-bold">{useCase.iconLabel}</span>
                  </div>
                  <div class="min-w-0">
                    <h3 class="text-xl font-bold">{useCase.name}</h3>
                    <p class="text-primary-400 text-sm">{useCase.kicker}</p>
                  </div>
                </div>

                <p class="text-gray-300 text-sm mb-6">{useCase.description}</p>

                <ul class="space-y-2 mb-4 flex-1">
                  {useCase.highlights.map((highlight) => (
                    <li class="flex items-center gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-primary shrink-0" aria-hidden="true">
                        <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                      </svg>
                      <span class="text-gray-300 text-sm">{highlight}</span>
                    </li>
                  ))}
                </ul>

                <a
                  href={useCase.href}
                  class="inline-flex items-center gap-2 text-primary hover:text-primary-light text-sm group-hover:translate-x-1 transition-transform duration-300 mt-auto"
                >
                  <span>{useCase.cta}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4" aria-hidden="true">
                    <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 bg-dark-800 border-y border-dark-700">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center animate-on-scroll">
          <h2 class="text-2xl md:text-3xl font-bold mb-4">Si tu rubro está, el siguiente paso es una demo corta</h2>
          <p class="text-lg text-gray-300 mb-8">
            Contanos cuántas sucursales tenés, qué sistema usás hoy y el problema que más te frena. Te mostramos el flujo, no una recorrida de menús.
          </p>
          <UseCaseCtas
            demoHref="#contacto"
            whatsappHref={whatsappUrl}
            vertical="hub"
            placement="mid"
            align="center"
          />
        </div>
      </div>
    </section>

    <section class="py-20 bg-dark-800">
      <div class="container mx-auto px-4">
        <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-10 items-start">
          <div class="animate-on-scroll">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">También evaluamos operaciones similares</h2>
            <p class="text-lg text-gray-300">
              Tenemos experiencia real en estos rubros. Como cada operación es distinta, primero revisamos juntos tu flujo para ver qué parte resuelve ZinkERP.
            </p>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {discoveryCases.map((useCase) => (
              <div class="bg-dark-700 rounded-2xl overflow-hidden group hover:scale-[1.02] transition-all duration-300 animate-on-scroll h-full flex flex-col">
                <div class={`h-1 bg-gradient-to-r ${useCase.accent}`}></div>
                <div class="p-6 h-full flex flex-col flex-1">
                  <div class="flex items-start gap-4 mb-4">
                    <div class={`flex items-center justify-center w-12 h-12 rounded-xl bg-gradient-to-r ${useCase.accent} p-3 group-hover:scale-110 transition-transform duration-300 shrink-0`}>
                      <span class="text-xl text-white font-bold">{useCase.iconLabel}</span>
                    </div>
                    <div class="min-w-0">
                      <h3 class="text-xl font-bold">{useCase.name}</h3>
                      <p class="text-primary-400 text-sm">{useCase.kicker}</p>
                    </div>
                  </div>

                  <p class="text-gray-300 text-sm mb-6">{useCase.description}</p>

                  <ul class="space-y-2 mb-4 flex-1">
                    {useCase.tags.map((tag) => (
                      <li class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-primary shrink-0" aria-hidden="true">
                          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                        </svg>
                        <span class="text-gray-300 text-sm">{tag}</span>
                      </li>
                    ))}
                  </ul>

                  <a
                    href={useCase.href}
                    class="inline-flex items-center gap-2 text-primary hover:text-primary-light text-sm group-hover:translate-x-1 transition-transform duration-300 mt-auto"
                  >
                    <span>{useCase.cta}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4" aria-hidden="true">
                      <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
                    </svg>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center mb-12 animate-on-scroll">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Encontrá tu patrón operativo</h2>
          <p class="text-lg text-gray-300">
            ZinkERP no es un producto hecho a medida para cada industria. Es el circuito operativo de un comercio que vende, compra, factura y controla caja.
          </p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {patternGroups.map((group) => (
            <article class="bg-dark-700 rounded-2xl p-6 h-full animate-on-scroll">
              <h3 class="text-xl font-bold mb-3">{group.title}</h3>
              <p class="text-gray-300 text-sm mb-5 leading-7">{group.text}</p>
              <div class="flex flex-wrap gap-2">
                {group.tags.map((tag) => (
                  <span class="px-3 py-1 rounded-full bg-white/[0.04] border border-white/8 text-gray-300 text-xs">{tag}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-dark-800">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12 animate-on-scroll">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">Preguntas frecuentes</h2>
          </div>
          <div class="space-y-4">
            {hubFaqs.map((faq) => (
              <details class="group bg-dark-900 border border-dark-700 rounded-lg p-6 animate-on-scroll">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold text-base md:text-lg">
                  {faq.question}
                  <span class="text-primary transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <p class="mt-4 text-gray-300">{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="contacto" class="py-20 scroll-mt-28">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto animate-on-scroll">
          <div class="text-center mb-10">
            <h2 class="text-3xl md:text-5xl font-bold mb-6">¿No encontrás tu rubro?</h2>
            <p class="text-xl text-gray-300 mb-8">
              Contanos cuántas sucursales tenés y cómo manejás hoy ventas, stock y compras. Te mostramos el flujo de ZinkERP para tu negocio.
            </p>
            <UseCaseCtas
              demoHref={demoUrl}
              whatsappHref={whatsappUrl}
              vertical="hub"
              placement="final"
              align="center"
              primaryLabel="Agendar demo"
            />
          </div>
          <UseCaseLeadForm
            vertical="hub"
            rubroLabel=""
            whatsappMessage="Hola, quiero ver el flujo de ZinkERP para mi comercio."
            formProblems={[
              'Stock desactualizado',
              'Precios que cambian todo el tiempo',
              'Compras difíciles de controlar',
              'Cuentas corrientes sin seguimiento',
              'Poca visibilidad entre sucursales',
            ]}
            demoHref={demoUrl}
          />
        </div>
      </div>
    </section>
  </main>

  <div id="page-sticky-cta" class="fixed inset-x-4 bottom-4 z-[55] md:hidden">
    <a
      href="#contacto"
      class="block rounded-xl bg-blue-primary px-4 py-4 text-center text-sm font-semibold text-white shadow-2xl"
      data-track-cta="demo"
      data-track-vertical="hub"
      data-track-placement="sticky"
    >
      Quiero una demo
    </a>
  </div>

  <Footer />
  <UseCaseTracking />
</Layout>
