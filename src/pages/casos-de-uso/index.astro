---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = 'Casos de uso | ZinkERP';
const pageDescription = 'Encontrá rubros y patrones operativos donde ZinkERP ayuda a ordenar ventas, stock, POS, facturación, sucursales y ecommerce.';

const whatsappUrl = 'https://wa.link/sgzvr4';
const demoUrl = 'https://cal.com/zinkintech';

const priorityCases = [
  {
    name: 'Ferreterías',
    kicker: 'Mostrador con ritmo',
    description: 'Stock amplio, ventas rápidas y precios que cambian.',
    highlights: ['Venta de mostrador', 'Catálogo amplio', 'Stock crítico'],
    accent: 'from-violet-500 to-purple-600',
    iconLabel: 'F',
    href: '/casos-de-uso/ferreterias',
    cta: 'Ver caso',
  },
  {
    name: 'Dietéticas',
    kicker: 'Disponibilidad bajo control',
    description: 'Muchos productos, venta diaria y necesidad de controlar disponibilidad.',
    highlights: ['Venta de mostrador', 'Catálogo amplio', 'Ecommerce'],
    accent: 'from-blue-500 to-cyan-600',
    iconLabel: 'D',
    href: '/casos-de-uso/dieteticas',
    cta: 'Ver caso',
  },
  {
    name: 'Artículos de limpieza',
    kicker: 'Reposición con contexto',
    description: 'Reposición frecuente, ventas minoristas o mayoristas y control de stock.',
    highlights: ['Stock crítico', 'B2B / mayorista', 'Multi-sucursal'],
    accent: 'from-green-500 to-emerald-600',
    iconLabel: 'L',
    href: '/casos-de-uso/articulos-de-limpieza',
    cta: 'Ver caso',
  },
  {
    name: 'Papeleras / librerías comerciales',
    kicker: 'Temporadas con orden',
    description: 'Catálogo grande, temporadas fuertes y ventas a consumidores u organizaciones.',
    highlights: ['Catálogo amplio', 'Temporadas', 'Venta de mostrador'],
    accent: 'from-pink-500 to-rose-600',
    iconLabel: 'P',
    href: '/casos-de-uso/papeleras',
    cta: 'Ver caso',
  },
  {
    name: 'Insumos de repostería',
    kicker: 'Picos de demanda resueltos',
    description: 'Variedad de productos, picos de demanda y posible venta presencial + online.',
    highlights: ['Catálogo amplio', 'Temporadas', 'Ecommerce'],
    accent: 'from-yellow-500 to-orange-600',
    iconLabel: 'R',
    href: '/casos-de-uso/insumos-de-reposteria',
    cta: 'Ver caso',
  },
];

const discoveryCases = [
  {
    name: 'Florerías',
    kicker: 'Experiencia real',
    description: 'Ventas por múltiples canales, disponibilidad cambiante y facturación a ordenar.',
    tags: ['Temporadas', 'Ecommerce', 'Venta de mostrador'],
    accent: 'from-pink-500 to-rose-600',
    iconLabel: 'F',
    href: '/casos-de-uso/florerias',
    cta: 'Evaluar encaje',
  },
  {
    name: 'Zinguería / metalúrgica',
    kicker: 'Experiencia real',
    description: 'Ventas con materiales, servicios y seguimiento comercial que conviene evaluar en demo.',
    tags: ['Proveedores', 'B2B / mayorista', 'Facturación'],
    accent: 'from-orange-500 to-red-600',
    iconLabel: 'Z',
    href: '/casos-de-uso/zingueria-metalurgica',
    cta: 'Evaluar encaje',
  },
  {
    name: 'Cultivos',
    kicker: 'Experiencia real',
    description: 'Operaciones con stock, ventas o administración donde primero validamos el flujo real.',
    tags: ['Stock crítico', 'Proveedores', 'Facturación'],
    accent: 'from-teal-500 to-green-600',
    iconLabel: 'C',
    href: '/casos-de-uso/cultivos',
    cta: 'Evaluar encaje',
  },
];

const patternGroups = [
  {
    title: 'Comercios con catálogo amplio',
    text: 'Negocios donde encontrar productos, ordenar categorías y mantener precios claros impacta todos los días.',
    tags: ['Ferreterías', 'Papeleras', 'Insumos de repostería', 'Dietéticas'],
  },
  {
    title: 'Reposición frecuente',
    text: 'Operaciones que necesitan visibilidad de stock para vender sin adivinar y comprar con más contexto.',
    tags: ['Artículos de limpieza', 'Ferreterías', 'Dietéticas'],
  },
  {
    title: 'Venta presencial + online',
    text: 'Comercios que combinan mostrador, ecommerce, cobros e integración con la operación diaria.',
    tags: ['Mostrador', 'Ecommerce', 'Cobros', 'Integraciones', 'Venta omnicanal'],
  },
  {
    title: 'Complejidad a validar',
    text: 'Rubros con procesos particulares donde conviene revisar alcance, flujo y prioridades antes de prometer encaje.',
    tags: ['Florerías', 'Zinguería / metalúrgica', 'Cultivos'],
  },
];

---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  <main>
    <section class="pt-32 pb-16 bg-dark-900 border-b border-dark-700">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <p class="inline-flex items-center gap-2 px-4 py-2 mb-6 rounded-full border border-primary/30 bg-primary/10 text-primary-light text-sm font-medium animate-on-scroll">
            Casos de uso
          </p>
          <h1 class="text-4xl md:text-6xl font-bold leading-tight mb-6 animate-on-scroll" style="animation-delay: 0.05s;">
            ZinkERP para comercios que necesitan ordenar ventas, stock y facturación
          </h1>
          <p class="text-xl text-gray-300 mb-8 animate-on-scroll" style="animation-delay: 0.1s;">
            Encontrá el caso más parecido a tu negocio y descubrí qué flujos podés ordenar con ZinkERP.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center animate-on-scroll" style="animation-delay: 0.15s;">
            <a href={demoUrl} class="inline-flex justify-center items-center px-8 py-4 bg-blue-primary hover:bg-blue-primary/90 rounded-lg text-lg font-medium transition-colors">
              Solicitar demo
            </a>
            <a href={whatsappUrl} class="inline-flex justify-center items-center px-8 py-4 border border-gray-600 hover:border-gray-400 rounded-lg text-lg font-medium transition-colors">
              Hablar por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mb-12 animate-on-scroll">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Rubros principales</h2>
          <p class="text-lg text-gray-300">
            Estos casos representan patrones frecuentes en comercios con productos, stock, ventas de mostrador, facturación y equipos que necesitan más control operativo.
          </p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {priorityCases.map((useCase) => (
            <div class="bg-dark-700 rounded-2xl overflow-hidden group hover:scale-[1.02] transition-all duration-300 animate-on-scroll h-full flex flex-col">
              <div class={`h-1 bg-gradient-to-r ${useCase.accent}`}></div>
              <div class="p-6 h-full flex flex-col flex-1">
                <div class="flex items-start gap-4 mb-4">
                  <div class={`flex items-center justify-center w-12 h-12 rounded-xl bg-gradient-to-r ${useCase.accent} p-3 group-hover:scale-110 transition-transform duration-300 shrink-0`}>
                    <span class="text-xl text-white font-bold">{useCase.iconLabel}</span>
                  </div>
                  <div class="min-w-0">
                    <h3 class="text-xl font-bold">{useCase.name}</h3>
                    <p class="text-primary-400 text-sm">{useCase.kicker}</p>
                  </div>
                </div>

                <p class="text-gray-300 text-sm mb-6">{useCase.description}</p>

                <ul class="space-y-2 mb-4 flex-1">
                  {useCase.highlights.map((highlight) => (
                    <li class="flex items-center gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-primary shrink-0">
                        <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                      </svg>
                      <span class="text-gray-300 text-sm">{highlight}</span>
                    </li>
                  ))}
                </ul>

                <a
                  href={useCase.href}
                  class="inline-flex items-center gap-2 text-primary hover:text-primary-light transition-colors text-sm group-hover:translate-x-1 transition-transform duration-300 mt-auto"
                >
                  <span>{useCase.cta}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                    <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-dark-800">
      <div class="container mx-auto px-4">
        <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-10 items-start">
          <div class="animate-on-scroll">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">También evaluamos operaciones similares</h2>
            <p class="text-lg text-gray-300">
              Además de los rubros principales, ZinkERP ya acompaña operaciones con dinámicas similares. En estos casos, el foco está en entender el flujo real del negocio y ordenar ventas, stock, facturación y seguimiento comercial sin prometer procesos específicos que no correspondan.
            </p>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {discoveryCases.map((useCase) => (
              <div class="bg-dark-700 rounded-2xl overflow-hidden group hover:scale-[1.02] transition-all duration-300 animate-on-scroll h-full flex flex-col">
                <div class={`h-1 bg-gradient-to-r ${useCase.accent}`}></div>
                <div class="p-6 h-full flex flex-col flex-1">
                  <div class="flex items-start gap-4 mb-4">
                    <div class={`flex items-center justify-center w-12 h-12 rounded-xl bg-gradient-to-r ${useCase.accent} p-3 group-hover:scale-110 transition-transform duration-300 shrink-0`}>
                      <span class="text-xl text-white font-bold">{useCase.iconLabel}</span>
                    </div>
                    <div class="min-w-0">
                      <h3 class="text-xl font-bold">{useCase.name}</h3>
                      <p class="text-primary-400 text-sm">{useCase.kicker}</p>
                    </div>
                  </div>

                  <p class="text-gray-300 text-sm mb-6">{useCase.description}</p>

                  <ul class="space-y-2 mb-4 flex-1">
                    {useCase.tags.map((tag) => (
                      <li class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-primary shrink-0">
                          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                        </svg>
                        <span class="text-gray-300 text-sm">{tag}</span>
                      </li>
                    ))}
                  </ul>

                  <a
                    href={useCase.href}
                    class="inline-flex items-center gap-2 text-primary hover:text-primary-light transition-colors text-sm group-hover:translate-x-1 transition-transform duration-300 mt-auto"
                  >
                    <span>{useCase.cta}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                      <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
                    </svg>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center mb-12 animate-on-scroll">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Encontrá tu patrón operativo</h2>
          <p class="text-lg text-gray-300">
            ZinkERP no es un producto hecho a medida para cada industria. Es una base operativa para comercios que comparten problemas de stock, ventas, facturación y sucursales.
          </p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {patternGroups.map((group) => (
            <article class="bg-dark-700 rounded-2xl p-6 h-full animate-on-scroll">
              <h3 class="text-xl font-bold mb-3">{group.title}</h3>
              <p class="text-gray-300 text-sm mb-5 leading-7">{group.text}</p>
              <div class="flex flex-wrap gap-2">
                {group.tags.map((tag) => (
                  <span class="px-3 py-1 rounded-full bg-white/[0.04] border border-white/8 text-gray-300 text-xs">{tag}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="contacto" class="py-20 bg-dark-800 scroll-mt-28">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center animate-on-scroll">
          <h2 class="text-3xl md:text-5xl font-bold mb-6">¿No encontrás tu rubro?</h2>
          <p class="text-xl text-gray-300 mb-8">
            Si tu negocio vende productos, maneja stock, factura y necesita ordenar la operación, probablemente podamos ayudarte. Lo mejor es revisar tu flujo real en una demo.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href={whatsappUrl} class="inline-flex justify-center items-center px-8 py-4 bg-blue-primary hover:bg-blue-primary/90 rounded-lg text-lg font-medium transition-colors">
              Hablar por WhatsApp
            </a>
            <a href={demoUrl} class="inline-flex justify-center items-center px-8 py-4 border border-gray-600 hover:border-gray-400 rounded-lg text-lg font-medium transition-colors">
              Solicitar demo
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
