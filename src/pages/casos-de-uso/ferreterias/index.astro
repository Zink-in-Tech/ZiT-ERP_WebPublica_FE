---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const pageTitle = 'ERP para ferreterías | ZinkERP';
const pageDescription = 'Gestioná ventas, stock, POS, facturación y sucursales de tu ferretería con ZinkERP, un ERP SaaS para comercios argentinos.';

const whatsappUrl = 'https://wa.link/sgzvr4';
const demoUrl = 'https://cal.com/zinkintech';

const pains = [
  'Muchos SKUs repartidos entre familias, medidas, marcas y proveedores.',
  'Dudas de stock en el mostrador cuando el cliente necesita una respuesta rápida.',
  'Ventas presenciales que no pueden esperar procesos administrativos lentos.',
  'Cambios de precios y márgenes que requieren orden para evitar errores.',
  'Reposición y seguimiento de proveedores con información dispersa.',
  'Necesidad de facturar dentro del mismo flujo operativo.',
  'Crecimiento a más de una sucursal con riesgo de perder visibilidad.',
];

const helps = [
  {
    title: 'Mostrador conectado con la operación',
    text: 'ZinkPOS ayuda a registrar ventas diarias sin separar el punto de venta del stock, la facturación y el control administrativo.',
  },
  {
    title: 'Stock y ventas en una misma base',
    text: 'El equipo puede trabajar con información más ordenada sobre productos, movimientos y disponibilidad operativa.',
  },
  {
    title: 'Precios y productos con más contexto',
    text: 'ZinkERP permite centralizar el catálogo comercial para reducir la dependencia de planillas o mensajes sueltos.',
  },
  {
    title: 'Visibilidad para dueños y encargados',
    text: 'La operación queda en un sistema común para revisar ventas, stock, facturación y sucursales cuando aplica.',
  },
];

const features = [
  'Gestión de stock',
  'ZinkPOS',
  'Gestión de ventas',
  'Facturación',
  'Reportes',
  'Operación multi-sucursal',
];

const workflows = [
  {
    title: 'Venta de mostrador',
    text: 'Registrar la venta desde el POS y mantener el movimiento conectado con la operación comercial.',
  },
  {
    title: 'Búsqueda de productos',
    text: 'Organizar el catálogo para que el equipo encuentre artículos por nombre, categoría o referencia disponible.',
  },
  {
    title: 'Consulta de stock',
    text: 'Revisar disponibilidad antes de confirmar una venta y reducir respuestas basadas en memoria o recorridas manuales.',
  },
  {
    title: 'Actualización de precios',
    text: 'Trabajar con precios en una base centralizada para sostener más orden cuando cambian costos o márgenes.',
  },
  {
    title: 'Facturación',
    text: 'Resolver el paso fiscal desde un sistema pensado para comercios argentinos y contexto ARCA/AFIP.',
  },
  {
    title: 'Visibilidad por sucursal',
    text: 'Cuando hay más de un local, sumar una mirada central sobre ventas, stock y actividad de cada punto.',
  },
];

const integrations = [
  {
    name: 'Facturante',
    text: 'Facturación electrónica conectada a ZinkERP para el contexto fiscal argentino.',
    href: '/integraciones/facturante',
  },
  {
    name: 'Mercado Pago',
    text: 'Cobros conectados con la operación comercial cuando el flujo de pagos lo requiere.',
    href: '/integraciones/mercadopago',
  },
  {
    name: 'WooCommerce',
    text: 'Para ferreterías que también venden online y necesitan conectar ecommerce con gestión.',
    href: '/integraciones/woocommerce',
  },
];

const faqs = [
  {
    question: '¿Sirve si tengo muchos productos?',
    answer: 'Sí. Ferreterías suelen tener catálogos amplios y ZinkERP ayuda a ordenar productos, stock, ventas y facturación desde una base común.',
  },
  {
    question: '¿Puedo usarlo para ventas de mostrador?',
    answer: 'Sí. ZinkPOS está pensado para venta presencial y se integra con la operación del ERP.',
  },
  {
    question: '¿Ayuda a controlar stock?',
    answer: 'Sí. ZinkERP incluye gestión de stock para trabajar con movimientos, disponibilidad y control operativo diario.',
  },
  {
    question: '¿Sirve para más de una sucursal?',
    answer: 'Sí. ZinkERP soporta operaciones multi-sucursal y ayuda a tener visibilidad centralizada cuando el negocio crece.',
  },
  {
    question: '¿Puedo vender online también?',
    answer: 'Si la ferretería trabaja con WooCommerce, la integración puede ayudar a conectar ecommerce con la gestión. El alcance puntual conviene revisarlo en demo.',
  },
  {
    question: '¿Es un sistema hecho solo para ferreterías?',
    answer: 'No es un producto exclusivo para ferreterías. ZinkERP resuelve patrones operativos comunes en comercios con catálogo, ventas, stock y facturación; ferreterías es uno de los casos donde ese encaje suele ser fuerte.',
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  <main>
    <section class="pt-32 pb-20 bg-dark-900 border-b border-dark-700">
      <div class="container mx-auto px-4">
        <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-12 items-center">
          <div class="max-w-3xl">
            <a href="/casos-de-uso" class="inline-flex items-center gap-2 text-primary hover:text-primary-light mb-6 animate-on-scroll">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
                <path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd" />
              </svg>
              Volver a casos de uso
            </a>
            <p class="inline-flex items-center gap-2 px-4 py-2 mb-6 rounded-full border border-primary/30 bg-primary/10 text-primary-light text-sm font-medium animate-on-scroll">
              Ferreterías
            </p>
            <h1 class="text-4xl md:text-6xl font-bold leading-tight mb-6 animate-on-scroll" style="animation-delay: 0.05s;">
              ZinkERP para ferreterías
            </h1>
            <p class="text-xl text-gray-300 mb-8 animate-on-scroll" style="animation-delay: 0.1s;">
              Ordená ventas de mostrador, stock, precios, proveedores y facturación en una plataforma pensada para comercios argentinos.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 animate-on-scroll" style="animation-delay: 0.15s;">
              <a href={demoUrl} class="inline-flex justify-center items-center px-8 py-4 bg-blue-primary hover:bg-blue-primary/90 rounded-lg text-lg font-medium transition-colors">
                Solicitar demo
              </a>
              <a href={whatsappUrl} class="inline-flex justify-center items-center px-8 py-4 border border-gray-600 hover:border-gray-400 rounded-lg text-lg font-medium transition-colors">
                Hablar por WhatsApp
              </a>
            </div>
          </div>

          <div class="bg-dark-800 border border-dark-700 rounded-lg p-6 md:p-8 animate-on-scroll" style="animation-delay: 0.2s;">
            <p class="text-sm text-gray-400 mb-4">Flujos más relevantes</p>
            <div class="grid sm:grid-cols-2 gap-3">
              {['POS', 'Stock', 'Ventas', 'Facturación', 'Proveedores', 'Sucursales'].map((item) => (
                <div class="rounded-lg bg-dark-700 border border-dark-600 p-4">
                  <p class="font-medium">{item}</p>
                </div>
              ))}
            </div>
            <p class="text-gray-300 mt-6">
              Un caso fuerte para comercios con catálogo amplio, venta rápida y necesidad de ordenar la operación diaria sin sumar complejidad innecesaria.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-dark-800">
      <div class="container mx-auto px-4">
        <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-10 items-start">
          <div class="animate-on-scroll">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">Problemas comunes del rubro</h2>
            <p class="text-lg text-gray-300">
              La ferretería combina velocidad de mostrador con catálogo grande, cambios de precios y presión por saber qué hay disponible.
            </p>
          </div>
          <div class="grid md:grid-cols-2 gap-4">
            {pains.map((pain) => (
              <div class="bg-dark-700 border border-dark-600 rounded-lg p-5 animate-on-scroll">
                <p class="text-gray-200">{pain}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mb-12 animate-on-scroll">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Cómo ayuda ZinkERP</h2>
          <p class="text-lg text-gray-300">
            ZinkERP centraliza ventas, stock, POS, facturación y sucursales para que el equipo trabaje sobre una operación más ordenada.
          </p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {helps.map((item) => (
            <article class="bg-dark-800 border border-dark-700 rounded-lg p-6 hover:border-primary/40 transition-colors animate-on-scroll">
              <div class="w-10 h-10 rounded-lg bg-primary/10 text-primary flex items-center justify-center mb-5">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                </svg>
              </div>
              <h3 class="text-xl font-bold mb-3">{item.title}</h3>
              <p class="text-gray-300">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-dark-800">
      <div class="container mx-auto px-4">
        <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-10 items-start">
          <div class="animate-on-scroll">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">Funciones útiles</h2>
            <p class="text-lg text-gray-300">
              El valor está en usar estas funciones juntas: vender, actualizar stock, facturar y mirar la operación desde el mismo sistema.
            </p>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {features.map((feature) => (
              <div class="bg-dark-700 border border-dark-600 rounded-lg p-5 animate-on-scroll">
                <p class="font-bold">{feature}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center mb-12 animate-on-scroll">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Flujos que se pueden ordenar</h2>
          <p class="text-lg text-gray-300">
            Estos son recorridos típicos donde una ferretería gana claridad cuando deja de operar con información dispersa.
          </p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {workflows.map((workflow, index) => (
            <article class="bg-dark-800 border border-dark-700 rounded-lg p-6 animate-on-scroll">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10 text-primary font-bold mb-5">
                {index + 1}
              </span>
              <h3 class="text-xl font-bold mb-3">{workflow.title}</h3>
              <p class="text-gray-300">{workflow.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-dark-800">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mb-12 animate-on-scroll">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Integraciones relacionadas</h2>
          <p class="text-lg text-gray-300">
            Cuando el flujo lo necesita, ZinkERP puede conectarse con herramientas de facturación, pagos y ecommerce.
          </p>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {integrations.map((integration) => (
            <a href={integration.href} class="group bg-dark-700 border border-dark-600 rounded-lg p-6 hover:border-primary/40 transition-colors animate-on-scroll">
              <p class="text-sm text-primary-light mb-2">Integración</p>
              <h3 class="text-2xl font-bold mb-3 group-hover:text-primary-light transition-colors">{integration.name}</h3>
              <p class="text-gray-300">{integration.text}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12 animate-on-scroll">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">Preguntas frecuentes</h2>
            <p class="text-lg text-gray-300">Respuestas claras sobre el encaje de ZinkERP para ferreterías.</p>
          </div>
          <div class="space-y-4">
            {faqs.map((faq) => (
              <details class="group bg-dark-800 border border-dark-700 rounded-lg p-6 animate-on-scroll">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold text-lg">
                  {faq.question}
                  <span class="text-primary transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="mt-4 text-gray-300">{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="demo" class="py-20 bg-dark-800 border-t border-dark-700">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center animate-on-scroll">
          <h2 class="text-3xl md:text-5xl font-bold mb-6">Ordená la operación diaria de tu ferretería</h2>
          <p class="text-xl text-gray-300 mb-8">
            En una demo podemos revisar tu catálogo, venta de mostrador, stock, facturación y sucursales para entender dónde ZinkERP encaja mejor.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
            <a href={demoUrl} class="inline-flex justify-center items-center px-8 py-4 bg-blue-primary hover:bg-blue-primary/90 rounded-lg text-lg font-medium transition-colors">
              Solicitar demo
            </a>
            <a href={whatsappUrl} class="inline-flex justify-center items-center px-8 py-4 border border-gray-600 hover:border-gray-400 rounded-lg text-lg font-medium transition-colors">
              Hablar por WhatsApp
            </a>
          </div>
          <a href="/casos-de-uso" class="inline-flex items-center gap-2 text-primary hover:text-primary-light transition-colors">
            Ver otros casos de uso
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
